msgstr "Solicitações de mensagem"

msgid "В СЕТИ"
msgstr "Online"

msgid "Все"
msgstr "Todos"

msgid "ОЖИДАНИЕ"
msgstr "Pendente"

msgid "Вы можете добавить друзей по их имени пользователя в Discord."
msgstr "Você pode adicionar amigos pelo nome de usuário do Discord."

