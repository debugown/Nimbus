msgstr "Conectar ao servidor de voz?"

msgid "Удалить сообщение?"
msgstr "Excluir a mensagem?"

msgid "Сообщество использует голос на "
msgstr "A comunidade usa voz em "

msgid ". Тот, кто держит этот сервер, увидит твой IP-адрес. Подключайся, только если доверяешь ему. Ответ запомнится."
msgstr ". Quem administra este servidor verá seu endereço IP. Conecte-se só se confiar nessa pessoa. Sua resposta será lembrada."

msgid "Сообщение исчезнет у всех. Вернуть его нельзя."
msgstr "A mensagem sumirá para todos. Não é possível restaurá-la."

msgid "Он не сможет вернуться на сервер, пока бан не снимут."
msgstr "Essa pessoa não poderá voltar ao servidor até o banimento ser removido."

msgid "Он сможет вернуться по новому приглашению."
msgstr "Essa pessoa poderá voltar com um novo convite."

msgid "Отмена"
msgstr "Cancelar"

msgid "Подключиться"
msgstr "Conectar"

msgid "Удалить"
