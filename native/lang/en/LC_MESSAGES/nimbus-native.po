msgstr "Same as source"

msgid "Кадров в секунду"
msgstr "Frames per second"

msgid "Звук приложения"
msgstr "App audio"

msgid "Передавать звук показываемого окна или всего экрана."
msgstr "Send the sound of the shared window or the whole screen."

msgid "Размер текста сообщений"
msgstr "Message text size"

msgid "Меняется сразу и запоминается."
msgstr "Applies at once and is remembered."

msgid "Мелкий (90%)"
msgstr "Small (90%)"

msgid "Обычный (100%)"
msgstr "Normal (100%)"

msgid "Крупный (115%)"
msgstr "Large (115%)"

msgid "Очень крупный (130%)"
msgstr "Very large (130%)"

msgid "Компактный режим"
msgstr "Compact mode"

msgid "Сообщения разных авторов стоят ближе друг к другу."
msgstr "Messages from different authors sit closer together."

msgid "Показывать время у автора"
msgstr "Show time next to the author"

msgid "Время сообщения рядом с именем."
msgstr "The message time beside the name."

msgid "Алекс"
msgstr "Mark"

