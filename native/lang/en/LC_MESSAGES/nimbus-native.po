msgstr "Change your name, email, password and phone in Discord. Nimbus does not send these changes."

msgid "Открыть Discord в браузере"
msgstr "Open Discord in the browser"

msgid "Качество показа экрана"
msgstr "Screen share quality"

msgid "Так начинается новый показ экрана; то же стоит в меню показа."
msgstr "This is how a new screen share starts; the same setting is in the share menu."

