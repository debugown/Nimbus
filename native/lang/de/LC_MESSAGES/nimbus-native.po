msgstr "Nichts gefunden"

msgid "Найдено: "
msgstr "Gefunden: "

msgid "Куда отправимся?"
msgstr "Wohin?"

msgid "Начни вводить имя друга, переписки, сервера или канала"
msgstr "Gib den Namen eines Freundes, einer Unterhaltung, eines Servers oder Kanals ein"

msgid "Ничего не нашлось"
msgstr "Nichts gefunden"

msgid "ЛС"
msgstr "DN"

msgid "Друг"
msgstr "Freund"

msgid "Сервер"
msgstr "Server"

msgid "Канал"
msgstr "Kanal"

msgid "↑ ↓ выбрать   ·   Enter открыть   ·   Esc закрыть   ·   имя друга, сервера или #канала"
msgstr "↑ ↓ wählen   ·   Enter öffnen   ·   Esc schließen   ·   Name eines Freundes, Servers oder #Kanals"

msgid "Друзья"
msgstr "Freunde"

msgid "Запросы общения"
msgstr "Nachrichtenanfragen"

msgid "В СЕТИ"
msgstr "Online"

msgid "Все"
msgstr "Alle"

