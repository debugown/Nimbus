msgstr "Suche Bildschirme und Fenster…"

msgid "Смотрите сейчас"
msgstr "Jetzt ansehen"

msgid "Смотреть стрим"
msgstr "Stream ansehen"

msgid "Жду видео…"
msgstr "Warte auf Video…"

