    // Slash commands: the panel while `/name` is typed (rows, the bots' strip, the list's height), the row
    // picked with the arrow keys, and the picked command's options as pills over the box (the one typed now lit).
    in property <[SlashRow]> slash-rows;
    in property <[SlashApp]> slash-apps;
    in property <length> slash-height;
    in-out property <bool> slash-open;
    in-out property <int> slash-index;
    in property <string> slash-hint-name;
    in property <[string]> slash-hint;
    in property <int> slash-hint-active: -1;
    callback slash-picked(int);
    // The next (or, with `step` -1, previous) command row from `from`, past the headers.
    function slash-step(from: int, step: int) -> int {
        if (from + step >= 0 && from + step < root.slash-rows.length) {
            if (root.slash-rows[from + step].header) {
                return (from + 2 * step >= 0 && from + 2 * step < root.slash-rows.length) ? from + 2 * step : from;
            }
            return from + step;
        }
        return from;
    }
    // The soundboard over the voice panel: its sections and tiles, what's typed in its search, and
    // whether others' sounds are heard here. Sounds can only be played in a call, unmuted.
    in property <[SoundItem]> sound-items;
    in property <[SoundSection]> sound-sections;
    in property <length> sound-height;
    in-out property <bool> soundboard-open;
    in-out property <bool> sounds-muted;
    in property <bool> sounds-busy;
    property <string> sound-text;
    out property <bool> soundboard-usable: root.voice-connected && !root.mic-muted && !root.deafened;
    changed soundboard-usable => {
        if (!self.soundboard-usable) {
            self.soundboard-open = false;
        }
    }
    callback soundboard-opened();
    callback sound-query(string);
    callback sound-play(string, string);
    callback sounds-muted-changed(bool);
