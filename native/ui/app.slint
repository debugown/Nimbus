    in-out property <int> event-kind: 2;
    in property <[EventChannelItem]> event-channels;
    in-out property <string> event-channel;
    in-out property <string> event-location;
    in-out property <string> event-name;
    in-out property <string> event-date;
    in-out property <string> event-time;
    in-out property <string> event-end-date;
