    function open-message-menu(id: string, author: string, pinned: bool, x: length, y: length) {
        root.msg-menu-id = id;
        root.msg-menu-pinned = pinned;
        root.msg-menu-author = author;
        root.msg-menu-x = x;
        root.msg-menu-y = y;
        message-menu-popup.show();
    }
    // Rust has the text of the message: put it in the box to be changed.
    public function start-edit(id: string, text: string) {
        root.editing = id;
        input.text = text;
        input.focus();
    }
    // Kick or ban waiting for a yes.
    in-out property <string> confirm-action;
    in-out property <string> confirm-user;
    in-out property <string> confirm-name;

    // Older messages are added above the ones on screen; the view stays put.
    property <length> saved-from-bottom;
    public function remember-scroll() {
        root.saved-from-bottom = message-list.content-height + message-list.content-y;
    }
    public function restore-scroll() {
        message-list.content-y = min(0px, root.saved-from-bottom - message-list.content-height);
    }
    // "Идёт звонок: Аня, Борис" above a DM that has a call going on.
    in property <string> dm-call;
    // We are in that call: the line has no answer and decline buttons then.
    in property <bool> dm-call-joined;
    // The call button (ring: true) or the line's answer (false): into the open DM's call.
    callback dm-call-start(bool);
    callback dm-call-decline();
    // The list is at an old message, not at the newest ones.
    in-out property <bool> detached;
    callback return-latest();
    public function scroll-to-share(share: float) {
        message-list.content-y = min(0px, max(message-list.visible-height - message-list.content-height,
            -(message-list.content-height * share) + message-list.visible-height / 2));
    }
    public function near-bottom() -> bool {
        return root.messages.length > 0 && message-list.content-y < message-list.visible-height - message-list.content-height + 400px;
    }
    // Scrolled (nearly) to the top of a chat that may have more above.
    public function near-top() -> bool {
        return root.messages.length > 0 && message-list.content-y > -400px && !root.forum-open && root.people-page == 0 && root.notice == "";
    }

    callback search-changed(string);
    callback search-picked(int);
    public function open-search() {
        root.search-index = 0;
        root.search-open = true;
        root.search-changed("");
    }

