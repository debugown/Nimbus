export struct DeviceItem {
    name: string,
    selected: bool,
}

// The voice settings. noise: 0 off, 1 standard, 2 strong (RNNoise).
// Volumes in percent; threshold in dBFS, used when auto-threshold is off.
// voice-mode: 0 the mic opens when it hears speech, 1 only while the key is held.
export struct VoiceSettings {
    noise: int,
    // How much of the cleaned sound is used with the strong suppression: 20..100.
    noise-strength: int,
    echo: bool,
    auto-gain: bool,
    mic-volume: float,
    speaker-volume: float,
    auto-threshold: bool,
    threshold: float,
    voice-mode: int,
}

export struct ShareSourceItem {
    name: string,
    detail: string,
    is-window: bool,
    // A small picture of the screen or window (made a moment after the list shows).
    thumb: image,
    has-thumb: bool,
}

component Icon inherits Path {
    in property <color> tint: Theme.muted;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 2px;
    fill: transparent;
}

// The Nimbus mark: three rounded bars. `animated`: they grow out from the middle, one after another.
component NimbusMark inherits Rectangle {
    in property <color> ink: #ffffff;
    in property <bool> animated;
    property <bool> open: !root.animated;
    property <length> unit: root.width / 48;
    init => { self.open = true; }
    Rectangle {
        height: 5.5 * root.unit;
        y: 12.25 * root.unit;
        width: root.open ? 21.5 * root.unit : 5.5 * root.unit;
        x: 22 * root.unit - self.width / 2;
        border-radius: self.height / 2;
        background: root.ink;
        animate width { delay: 80ms; duration: root.animated ? 420ms : 0ms; easing: ease-out; }
    }
    Rectangle {
        height: 5.5 * root.unit;
        y: 21.25 * root.unit;
        width: root.open ? 39.5 * root.unit : 5.5 * root.unit;
        x: 24 * root.unit - self.width / 2;
        border-radius: self.height / 2;
        background: root.ink;
        animate width { duration: root.animated ? 420ms : 0ms; easing: ease-out; }
    }
    Rectangle {
        height: 5.5 * root.unit;
        y: 30.25 * root.unit;
        width: root.open ? 25.5 * root.unit : 5.5 * root.unit;
        x: 25 * root.unit - self.width / 2;
        border-radius: self.height / 2;
        background: root.ink;
        animate width { delay: 160ms; duration: root.animated ? 420ms : 0ms; easing: ease-out; }
    }
}

// The light catching the top edge of a piece of glass.
component Sheen inherits Rectangle {
    height: 1px;
    visible: Appearance.glass && !Theme.light;
    background: @linear-gradient(90deg, #ffffff00 0%, #ffffff4d 50%, #ffffff00 100%);
}

component GuildButton inherits Rectangle {
    in property <GuildItem> item;
    in property <bool> selected;
    in property <bool> folder;
    in property <bool> open;
    in property <bool> inside;
    in property <bool> last;
    in property <[GuildItem]> thumbs;
    // Can be dragged to another place on the rail.
    in property <bool> draggable;
    callback clicked;
    // Right-click: the server's menu, where it was clicked.
    callback menu(length, length);
    callback drag-begin();
    callback drag-at(length, length);
    // Let go: true to drop it here, false when the drag was cancelled.
    callback drag-end(bool);
    property <bool> dragged;
    height: 48px;

    // An open folder: a band behind it and its servers.
    if root.open || root.inside: Rectangle {
        x: 12px;
        y: root.open ? 2px : 0px;
        width: 48px;
        height: root.open ? 46px : root.last ? 50px : 48px;
        background: Theme.surface3;
        opacity: 0.5;
        border-top-left-radius: root.open ? 14px : 0px;
        border-top-right-radius: root.open ? 14px : 0px;
        border-bottom-left-radius: root.last ? 14px : 0px;
        border-bottom-right-radius: root.last ? 14px : 0px;
    }

    ta := TouchArea {
        clicked => {
            if (!root.dragged) {
                root.clicked();
            }
        }
        moved => {
            if (!self.pressed || !root.draggable) {
                return;
            }
            if (!root.dragged && abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 6px) {
                root.dragged = true;
                root.drag-begin();
            }
            if (root.dragged) {
                root.drag-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.dragged = false;
            }
            if (root.dragged && event.kind != PointerEventKind.down && event.kind != PointerEventKind.move) {
                root.drag-end(event.kind == PointerEventKind.up);
            }
        }
    }

    // The pill on the left edge: short on hover, tall when selected.
    Rectangle {
        x: 0;
        width: 4px;
        height: root.selected ? 36px : (ta.has-hover ? 20px : (root.item.unread ? 8px : 0px));
        y: (parent.height - self.height) / 2;
        background: Theme.text;
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
        animate height { duration: Appearance.quick; easing: ease-out; }
    }

    Rectangle {
        x: 16px;
        y: 4px;
        width: 40px;
        height: 40px;
        clip: true;
        border-radius: 12px;
        drop-shadow-blur: root.selected ? 16px : ta.has-hover ? 10px : 0px;
        drop-shadow-color: Theme.glow;
        background: (root.selected || ta.has-hover) && !root.item.has-icon && !root.folder ? Theme.accent : Theme.surface3;
        animate border-radius, background { duration: Appearance.slow; easing: ease-out; }

        if root.item.has-icon: Image {
            width: 40px;
            height: 40px;
            source: root.item.icon;
            image-fit: cover;
        }
        if root.folder && root.open: Icon {
            commands: Icons.folder;
            tint: Theme.text;
            width: 22px;
            height: 22px;
        }
        if root.folder && !root.open: Rectangle {
            for t[i] in root.thumbs: Rectangle {
                x: 3px + 18px * mod(i, 2);
                y: 3px + 18px * floor(i / 2);
                width: 16px;
                height: 16px;
                clip: true;
                border-radius: 5px;
                background: Theme.surface0;
                if t.has-icon: Image {
                    width: 16px;
                    height: 16px;
                    source: t.icon;
                    image-fit: cover;
                }
                if !t.has-icon: Text {
                    text: t.initials;
                    color: Theme.text;
                    font-size: 7px;
                    font-weight: 600;
                    overflow: clip;
                }
            }
        }
        if !root.item.has-icon && root.item.id == "@me": Icon {
            commands: Icons.chat;
            tint: (root.selected || ta.has-hover) ? Theme.on-accent : Theme.text;
            width: 24px;
            height: 24px;
        }
        if !root.item.has-icon && root.item.id != "@me": Text {
            y: (parent.height - self.height) / 2 - self.font-size * 0.064;
            text: root.item.initials;
            color: (root.selected || ta.has-hover) ? Theme.on-accent : Theme.text;
            font-size: 15px;
            font-weight: 600;
        }
    }

    // Voice: a small round badge at the icon's upper right. Green when you are there (a screen when you
    // are showing yours), dark when it is someone else (a screen when they are showing theirs).
    if root.item.voice > 0: Rectangle {
        x: 56px - self.width + 4px;
        y: 0px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: Theme.surface0;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: root.item.voice >= 3 ? #23a55a : #2b2d31;
            Icon {
                width: 11px;
                height: 11px;
                stroke-width: 1.7px;
                commands: (root.item.voice == 2 || root.item.voice == 4) ? Icons.screen : Icons.volume;
                tint: #ffffff;
            }
        }
    }

    // Mentions of you: a red count at the icon's lower right, cut out of the rail.
    if root.item.mentions > 0: Rectangle {
        x: 56px - self.width + 4px;
        y: 30px;
        height: 20px;
        width: max(20px, mention-text.preferred-width + 10px);
        border-radius: 10px;
        background: Theme.surface0;
        Rectangle {
            width: parent.width - 4px;
            height: 16px;
            border-radius: 8px;
            background: #f23f43;
            mention-text := Text { text: root.item.mentions > 99 ? "99+" : root.item.mentions; color: #fff; font-size: 11px; font-weight: 800; }
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> off;
    in property <bool> filled;
    // Can't be used now: drawn faint, no hover. `lit`: what it opens is open.
    in property <bool> disabled;
    in property <bool> lit;
    callback clicked;
    callback secondary-clicked;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    opacity: root.disabled ? 0.4 : 1;
    background: root.lit ? Theme.active : ta.has-hover && !root.disabled ? (root.off ? #f04a5524 : Theme.hover) : transparent;
    animate background { duration: Appearance.quick; }

    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.secondary-clicked();
            }
        }
    }
    if !root.filled: Icon {
        x: 6px;
        y: 6px;
        commands: root.icon;
        tint: root.off ? #f04a55 : (ta.has-hover ? Theme.text : Theme.text2);
    }
    if root.filled: Path {
        x: 6px;
        y: 6px;
        width: 20px;
        height: 20px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: ta.has-hover ? #f04a55 : Theme.text2;
    }
}

// Right-click menu for picking the microphone or the output device.
component DeviceMenu inherits PopupWindow {
    in property <string> title;
    in property <[DeviceItem]> devices;
    callback picked(int);
    width: 300px;
    height: 46px + max(1, root.devices.length) * 34px;

    Rectangle {
        property <bool> menu-shown;
        init => { self.menu-shown = true; }
        opacity: self.menu-shown ? 1 : 0;
        animate opacity { duration: Appearance.quick; easing: ease-out; }
        background: Theme.glass-strong;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.shadow;

        VerticalLayout {
            padding: 6px;
            HorizontalLayout {
                padding-left: 8px;
                height: 28px;
                Text { text: root.title; color: Theme.muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
            }
            if root.devices.length == 0: HorizontalLayout {
                padding-left: 8px;
                height: 34px;
                Text { text: @tr("" => "Устройства не найдены"); color: Theme.muted; font-size: 13px; vertical-alignment: center; }
            }
            for d[i] in root.devices: Rectangle {
                height: 34px;
                border-radius: 6px;
                background: row-area.has-hover ? Theme.hover : transparent;
                row-area := TouchArea {
                    clicked => {
                        root.picked(i);
                        root.close();
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: d.name;
                        color: d.selected ? Theme.text : Theme.text2;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if d.selected: VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                    }
                }
            }
        }
    }
}

// A small toggle in the share menu's quality row.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 32px;
    width: label.preferred-width + 28px;
    border-radius: 8px;
    background: root.on ? Theme.accent : (ta.has-hover ? Theme.button-hover : Theme.button);
    drop-shadow-blur: root.on ? 10px : 0px;
    drop-shadow-color: Theme.glow;
    animate background { duration: Appearance.quick; }
    border-width: root.on ? 0px : 1px;
    border-color: Theme.line;
    ta := TouchArea { clicked => { root.clicked(); } }
    label := Text {
        text: root.text;
        color: root.on ? Theme.on-accent : Theme.text2;
        font-size: 13px;
        font-weight: 600;
    }
}

// A switch, as in Discord's settings.
component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);
    width: 40px;
    height: 24px;
    border-radius: 12px;
    background: root.on ? Theme.accent : (Theme.light ? #a3a6ae : #4e5058);
    animate background { duration: Appearance.quick; }
    Rectangle {
        x: root.on ? 18px : 2px;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.on ? Theme.on-accent : #fff;
        animate x { duration: Appearance.quick; easing: ease-out; }
        if root.on: Icon { width: 12px; height: 12px; tint: Theme.accent; commands: Icons.check; }
        if !root.on: Icon { width: 10px; height: 10px; tint: Theme.light ? #a3a6ae : #4e5058; commands: Icons.close; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

// A slider. With `level` (0..1) it is also the input sensitivity meter:
// the bar shows how loud the mic is, green while it sends.
component Range inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value;
    in property <float> level: -1;
    in property <bool> level-open;
    // Off: only the meter, nothing to drag.
    in property <bool> enabled: true;
    callback changed(float);
    height: 24px;
    property <float> frac: clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);
    function pick(x: length) {
        root.changed(round(root.minimum + clamp(x / root.width, 0, 1) * (root.maximum - root.minimum)));
    }
    Rectangle {
        y: root.level >= 0 ? 5px : 8px;
        height: root.level >= 0 ? 14px : 8px;
        border-radius: 4px;
        clip: true;
        background: Theme.light ? #c4c7cd : #4e5058;
        if root.level >= 0: Rectangle {
            x: 0;
            width: parent.width * clamp(root.level, 0, 1);
            background: root.level-open ? Theme.green : #f0b232;
        }
        if root.level < 0: Rectangle {
            x: 0;
            width: parent.width * root.frac;
            background: Theme.accent;
        }
    }
    if root.enabled: Rectangle {
        x: root.width * root.frac - self.width / 2;
        y: (root.height - self.height) / 2;
        width: root.level >= 0 ? 6px : 20px;
        height: root.level >= 0 ? 24px : 20px;
        border-radius: root.level >= 0 ? 3px : 10px;
        background: #fff;
        drop-shadow-blur: 4px;
        drop-shadow-color: Theme.shadow;
    }
    if root.enabled: TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pick(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.pick(self.mouse-x);
            }
        }
    }
}

// The picked device, as a box that opens the list.
component DevicePick inherits Rectangle {
    in property <string> title;
    in property <[DeviceItem]> devices;
    callback picked(int);
    callback opening();
    height: 40px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface3 : Theme.surface0;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.text2 : Theme.edge;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.opening();
            menu.show();
        }
    }
    for d in root.devices: Text {
        x: 12px;
        width: root.width - 44px;
        height: root.height;
        visible: d.selected;
        text: d.name;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        x: root.width - 30px;
        y: (root.height - 18px) / 2;
        width: 18px;
        height: 18px;
        commands: Icons.chevron;
        tint: Theme.text2;
    }
    menu := DeviceMenu {
        x: 0;
        y: root.height + 4px;
        width: max(300px, root.width);
        title: root.title;
        devices: root.devices;
        picked(index) => { root.picked(index); }
    }
}

// A heading and its hint in the settings.
// A choice shown as a small sample: a colour block or a picture, with a name under it.
component Swatch inherits Rectangle {
    in property <color> fill: Theme.surface1;
    in property <color> fill2: transparent;
    in property <image> picture;
    in property <string> text;
    in property <bool> on;
    callback clicked;
    width: 112px;
    height: 78px;
    border-radius: 8px;
    background: Theme.surface2;
    border-width: 2px;
    border-color: root.on ? Theme.accent : (ta.has-hover ? Theme.text2 : Theme.line);
    Rectangle { x: 10px; y: 10px; width: parent.width - 20px; height: 34px; border-radius: 6px; background: root.fill; clip: true;
        Rectangle { x: parent.width - 26px; y: 8px; width: 18px; height: 18px; border-radius: 9px; background: root.fill2; }
        if root.picture.width > 0: Image { x: (parent.width - 28px) / 2; y: 3px; width: 28px; height: 28px; source: root.picture; }
    }
    Text { x: 0; y: 50px; width: parent.width; height: 20px; text: root.text; color: root.on ? Theme.text : Theme.text2; font-size: 12px; font-weight: 600; horizontal-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SettingTitle inherits VerticalLayout {
    in property <string> text;
    in property <string> hint;
    spacing: 2px;
    Text { text: root.text; color: Theme.text; font-size: 15px; font-weight: 700; }
    if root.hint != "": Text { text: root.hint; color: Theme.muted; font-size: 12.5px; wrap: word-wrap; }
}

// A switch row: title and hint on the left, the switch on the right.
component ToggleRow inherits HorizontalLayout {
    in property <string> text;
    in property <string> hint;
    in property <bool> on;
    callback toggled(bool);
    spacing: 16px;
    SettingTitle { horizontal-stretch: 1; text: root.text; hint: root.hint; }
    VerticalLayout {
        alignment: center;
        Toggle { on: root.on; toggled(v) => { root.toggled(v); } }
    }
}

// One choice of the input profile.
// The language in use, flag and name; a click opens the list of them.
component LanguagePicker inherits Rectangle {
    height: 44px;
    border-radius: 8px;
    background: picker-area.has-hover ? Theme.hover : Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    animate background { duration: Appearance.quick; }
    picker-area := TouchArea { mouse-cursor: pointer; clicked => { list.show(); } }
    for l in Languages.all: Rectangle {
        visible: Appearance.language == l.code;
        Rectangle {
            x: 12px;
            width: 27px;
            height: 18px;
            border-radius: 3px;
            clip: true;
            Image { width: 27px; height: 18px; source: l.flag; image-fit: fill; }
        }
        Text { x: 49px; width: parent.width - 90px; height: parent.height; text: l.name; color: Theme.text; font-size: 15px; font-weight: 500; vertical-alignment: center; overflow: elide; }
    }
    Icon { x: parent.width - 32px; width: 20px; height: 20px; commands: Icons.chevron; tint: Theme.text2; }
    list := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: list-body.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.popup;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow;
            list-body := VerticalLayout {
                padding: 6px;
                for l in Languages.all: Rectangle {
                    height: 40px;
                    border-radius: 6px;
                    background: Appearance.language == l.code ? Theme.active : (row-area.has-hover ? Theme.hover : transparent);
                    row-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Appearance.language-picked(l.code);
                            list.close();
                        }
                    }
                    Rectangle {
                        x: 8px;
                        width: 27px;
                        height: 18px;
                        border-radius: 3px;
                        clip: true;
                        Image { width: 27px; height: 18px; source: l.flag; image-fit: fill; }
                    }
                    Text { x: 45px; width: parent.width - 80px; height: parent.height; text: l.name; color: Theme.text; font-size: 14px; font-weight: 500; vertical-alignment: center; overflow: elide; }
                    if Appearance.language == l.code: Icon { x: parent.width - 28px; width: 18px; height: 18px; commands: Icons.check; tint: Theme.accent; }
                }
            }
        }
    }
}

component Radio inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked;
    height: root.hint == "" ? 44px : 58px;
    border-radius: 8px;
    opacity: root.enabled ? 1.0 : 0.5;
    background: root.on ? Theme.active : (rta.has-hover && root.enabled ? Theme.hover : transparent);
    animate background { duration: Appearance.quick; }
    rta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    Rectangle {
        x: 14px;
        y: (root.height - 20px) / 2;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.on ? Theme.accent : Theme.text2;
        if root.on: Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.accent; }
    }
    Text { x: 48px; y: root.hint == "" ? 12px : 10px; text: root.text; color: Theme.text; font-size: 15px; font-weight: 600; }
    Text { x: 48px; y: 32px; width: parent.width - 60px; text: root.hint; color: Theme.muted; font-size: 12.5px; overflow: elide; }
}

// A text field of the settings, with a hint while it is empty; `multiline` makes it a taller box.
component SettingField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> multiline: false;
    // Enter in a one-line field.
    callback accepted;
    callback edited;
    public function focus-input() { input.focus(); }
    height: root.multiline ? 96px : 44px;
    border-radius: 8px;
    background: Theme.surface0;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    input := TextInput {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        height: parent.height - 20px;
        single-line: !root.multiline;
        wrap: root.multiline ? TextWrap.word-wrap : TextWrap.no-wrap;
        color: Theme.text;
        font-size: 15px;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }
    if input.text == "": Text { x: 12px; y: 10px; text: root.placeholder; color: Theme.faint; font-size: 15px; }
}

component SaveButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    width: label.preferred-width + 32px;
    height: 36px;
    border-radius: 6px;
    background: save-area.has-hover ? Theme.button-hover : Theme.button;
    save-area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    label := Text { text: root.text; color: Theme.text; font-size: 14px; font-weight: 600; }
}

// Voice settings: devices, volumes, mic check, input profile, sensitivity,
// noise suppression, echo cancellation, gain control. Changes apply at once.
// A click on a sub-item of the settings list asks the page to scroll to that heading.
global Scroller {
    in-out property <int> target: -1;
    // The part that is at the top now.
    in-out property <int> active: 0;
    in-out property <int> stamp;
    // Where the page and its content begin on the screen.
    in-out property <length> top;
    in-out property <length> lay-y;
    // Where the asked-for heading is on the screen.
    in-out property <length> screen-y;
}

// The big heading of a part of a settings page; the list on the left jumps to it.
component Anchor inherits Text {
    in property <int> key;
    property <int> stamp: Scroller.stamp;
    property <bool> passed: root.absolute-position.y <= Scroller.top + 70px;
    changed passed => {
        if (root.passed) {
            if (root.key > Scroller.active) { Scroller.active = root.key; }
        } else if (Scroller.active == root.key) {
            Scroller.active = max(root.key - 1, 0);
        }
    }
    changed stamp => {
        if (Scroller.target == root.key) { Scroller.screen-y = root.absolute-position.y; }
    }
    color: Theme.text;
    font-size: 20px;
    font-weight: 700;
}

component PageScroll inherits Flickable {
    property <bool> page-shown;
    init => { self.page-shown = true; }
    opacity: self.page-shown ? 1 : 0;
    animate opacity { duration: Appearance.slow; easing: ease-out; }
    in property <length> side;
    property <length> asked: Scroller.screen-y;
    property <length> own-top: root.absolute-position.y;
    changed own-top => { Scroller.top = root.own-top; }
    property <length> own-lay: lay.absolute-position.y;
    changed own-lay => { Scroller.lay-y = root.own-lay; }
    changed asked => {
        root.content-y = -min(max(root.asked - lay.absolute-position.y - 8px, 0px), max(lay.preferred-height - root.height, 0px));
    }
    content-height: lay.preferred-height;
    lay := VerticalLayout {
        width: root.width;
        padding-top: 28px;
        padding-bottom: 40px;
        padding-left: root.side;
        padding-right: root.side;
        spacing: 20px;
        alignment: start;
        @children
    }
}

// The coloured dot of a presence: 0 online, 1 idle, 2 do not disturb, 3 invisible.
component PresenceDot inherits Rectangle {
    in property <int> status;
    border-radius: self.width / 2;
    background: root.status == 0 ? Theme.green : root.status == 1 ? #f0b232 : root.status == 2 ? #f04a55 : Theme.faint;
}

// A column that scrolls; the content decides its height.
component SimpleScroll inherits Flickable {
    in property <length> side: 24px;
    content-height: lay.preferred-height;
    lay := VerticalLayout {
        width: root.width;
        padding-left: root.side;
        padding-right: root.side;
        padding-top: 16px;
        padding-bottom: 24px;
        spacing: 14px;
        alignment: start;
        @children
    }
}

// A person's profile as a card: banner (or its colour), avatar with a ring and presence dot overlapping the
// banner's lower edge, names, pronouns and "about me".
component ProfileCard inherits Rectangle {
    in property <image> banner;
    in property <bool> has-banner;
    in property <bool> has-color;
    in property <color> banner-color;
    in property <image> avatar;
    in property <image> decoration;
    in property <bool> has-decoration;
    in property <string> name;
    in property <string> username;
    in property <string> pronouns;
    in property <string> bio;
    in property <int> status;
    // The line under the name, shown as a bubble beside the avatar; empty shows an invitation to set one.
    in property <string> custom-status;
    in property <bool> show-bubble: true;
    callback avatar-clicked();
    callback bubble-clicked();
    height: 174px + body.preferred-height + 16px;
    background: Theme.surface1;
    border-radius: 12px;
    clip: true;
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 120px;
        background: root.has-color ? root.banner-color : Theme.accent.darker(0.4);
        if root.has-banner: Image { width: parent.width; height: parent.height; source: root.banner; image-fit: cover; }
    }
    // The ring around the avatar has the card's colour, so the avatar looks cut out of the banner.
    Rectangle {
        x: 16px;
        y: 74px;
        width: 92px;
        height: 92px;
        border-radius: 46px;
        background: Theme.surface1;
        Rectangle {
            x: 6px;
            y: 6px;
            width: 80px;
            height: 80px;
            border-radius: 40px;
            clip: true;
            background: Theme.surface3;
            Image { width: 80px; height: 80px; source: root.avatar; image-fit: cover; }
            TouchArea { mouse-cursor: pointer; clicked => { root.avatar-clicked(); } }
        }
        if root.has-decoration: Image { x: -7px; y: -7px; width: 106px; height: 106px; source: root.decoration; }
        PresenceDot { x: 62px; y: 62px; width: 24px; height: 24px; status: root.status; border-width: 4px; border-color: Theme.surface1; }
    }
    // The status bubble: a small rounded note that leans on the avatar, half over the banner.
    if root.show-bubble: Rectangle {
        x: 112px;
        y: 96px;
        width: min(parent.width - 112px - 16px, bubble-text.preferred-width + 28px);
        height: 34px;
        border-radius: 12px;
        background: bubble-area.has-hover ? Theme.surface3.brighter(0.15) : Theme.surface3;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.shadow;
        animate background { duration: 120ms; }
        bubble-area := TouchArea { mouse-cursor: pointer; clicked => { root.bubble-clicked(); } }
        // The tail: two dots towards the avatar.
        Rectangle { x: -6px; y: 2px; width: 8px; height: 8px; border-radius: 4px; background: parent.background; }
        Rectangle { x: -12px; y: -4px; width: 5px; height: 5px; border-radius: 2.5px; background: parent.background; }
        bubble-text := Text {
            x: 14px;
            width: parent.width - 28px;
            text: root.custom-status == "" ? "+ " + @tr("" => "Чем ты занят?") : root.custom-status;
            color: root.custom-status == "" ? Theme.muted : Theme.text;
            font-size: 13px;
            font-italic: root.custom-status == "";
            vertical-alignment: center;
            overflow: elide;
        }
    }
    body := VerticalLayout {
        x: 16px;
        y: 174px;
        width: parent.width - 32px;
        spacing: 4px;
        alignment: start;
        Text { text: root.name; color: Theme.text; font-size: 20px; font-weight: 800; overflow: elide; }
        Text { text: root.pronouns == "" ? root.username : root.username + " • " + root.pronouns; color: Theme.muted; font-size: 14px; overflow: elide; }
        if root.bio != "": Text { text: Fmt.stamps(root.bio); color: Theme.body; font-size: 13px; wrap: word-wrap; }
    }
}

// One row of a menu: an icon, the label (with a muted line under it when there is a hint) and, as children,
// a chevron or a dot. The whole row lights up under the pointer.
component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <string> icon;
    in property <length> pad: 42px;
    callback clicked;
    out property <bool> hovered: row-area.has-hover;
    height: 40px;
    border-radius: 6px;
    background: row-area.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }
    row-area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    if root.icon != "": Icon { x: 12px; y: (parent.height - 18px) / 2; width: 18px; height: 18px; commands: root.icon; tint: Theme.text2; }
    Text { x: root.pad; y: root.hint == "" ? 0px : 7px; width: parent.width - root.pad - 40px; height: root.hint == "" ? parent.height : 20px; text: root.text; vertical-alignment: center; color: Theme.text; font-size: 14px; overflow: elide; }
    if root.hint != "": Text { x: root.pad; y: 27px; width: parent.width - root.pad - 16px; text: root.hint; color: Theme.muted; font-size: 12px; overflow: elide; }
    @children
}

// A small rounded tile of the profile editor; its children (a picture, a word) sit on top.
component ProfileTile inherits Rectangle {
    callback clicked;
    height: 72px;
    preferred-width: 100px;
    min-width: 0px;
    horizontal-stretch: 1;
    border-radius: 8px;
    clip: true;
    background: tile-area.has-hover ? Theme.button-hover : Theme.button;
    border-width: 1px;
    border-color: tile-area.has-hover ? Theme.accent : Theme.line;
    animate background, border-color { duration: 120ms; }
    tile-area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    @children
}

// The buttons at the bottom of a dialog: the main one filled, the other plain.
component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    width: max(104px, dlg-label.preferred-width + 40px);
    height: 38px;
    border-radius: 6px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.primary ? (dlg-area.has-hover ? Theme.accent-hover : Theme.accent) : (dlg-area.has-hover ? Theme.button-hover : Theme.button);
    drop-shadow-blur: root.primary && root.enabled ? (dlg-area.has-hover ? 18px : 10px) : 0px;
    drop-shadow-color: Theme.glow;
    animate background { duration: 120ms; }
    dlg-area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    dlg-label := Text { text: root.text; color: root.primary ? Theme.on-accent : Theme.text; font-size: 14px; font-weight: 600; }
}

// "Edit profile": the parts on the left (small heading, tiles), the profile card as it will look in the middle with
// the fields under it, and "Cancel" / "Apply" at the bottom. Names and texts are drafts until "Apply".
component ProfileEditor inherits Rectangle {
    in property <image> avatar;
    in property <image> banner;
    in property <bool> has-banner;
    in property <bool> has-color;
    in property <color> banner-color;
    in property <image> decoration;
    in property <bool> has-decoration;
    in property <image> plate;
    in property <bool> has-plate;
    in property <string> username;
    in property <int> status;
    in property <string> name;
    in property <string> pronouns;
    in property <string> bio;
    in property <string> custom-status;
    // The drafts start as the saved values (the editor is made anew each time it opens).
    property <string> name-draft: root.name;
    property <string> pronouns-draft: root.pronouns;
    property <string> bio-draft: root.bio;
    property <string> status-draft: root.custom-status;
    callback close();
    // "avatar", "banner" or "banner-clear".
    callback pick(string);
    // Name, pronouns, "about me" and the custom status as they stand when "Apply" is pressed.
    callback apply(string, string, string, string);
    callback open-web();
    background: #000000b0;
    property <bool> shown;
    init => { self.shown = true; }
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: Appearance.slow; easing: ease-out; }
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        y: (root.height - self.height) / 2 + (root.shown ? 0px : 18px);
        animate y { duration: Appearance.slow; easing: ease-out; }
        width: min(1000px, root.width - 48px);
        height: min(740px, root.height - 48px);
        border-radius: 12px;
        background: Theme.glass-strong;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.shadow;
        clip: true;
        TouchArea {}
        Text { x: 24px; y: 0; height: 56px; text: @tr("" => "Редактировать профиль"); color: Theme.text; font-size: 18px; font-weight: 800; vertical-alignment: center; }
        Rectangle {
            x: parent.width - 48px;
            y: 12px;
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: editor-close.has-hover ? Theme.hover : transparent;
            animate background { duration: 120ms; }
            editor-close := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
            Icon { x: 6px; y: 6px; commands: Icons.close; tint: Theme.text2; }
        }
        Rectangle { y: 56px; height: 1px; background: Theme.line; }
        // Left: the parts, as small headings with tiles under them.
        Rectangle {
            x: 0;
            y: 57px;
            width: 264px;
            height: parent.height - 57px - 68px;
            background: Theme.surface1;
            SimpleScroll {
                side: 16px;
                Text { text: @tr("" => "Бейджик"); color: Theme.text2; font-size: 13px; font-weight: 700; }
                ProfileTile {
                    clicked => { root.open-web(); }
                    if root.has-plate: Image { width: parent.width; height: parent.height; source: root.plate; image-fit: cover; }
                    if !root.has-plate: Text { text: @tr("" => "Меняется в Discord"); color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: @tr("" => "Аватар и украшение"); color: Theme.text2; font-size: 13px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 8px;
                    ProfileTile {
                        height: 88px;
                        clicked => { root.pick("avatar"); }
                        Rectangle { x: (parent.width - 52px) / 2; y: 10px; width: 52px; height: 52px; border-radius: 26px; clip: true; background: Theme.surface3; Image { width: 52px; height: 52px; source: root.avatar; image-fit: cover; } }
                        Text { y: 66px; height: 16px; text: @tr("" => "Загрузить"); color: Theme.text2; font-size: 12px; horizontal-alignment: center; }
                    }
                    ProfileTile {
                        height: 88px;
                        clicked => { root.open-web(); }
                        if root.has-decoration: Image { x: (parent.width - 60px) / 2; y: 6px; width: 60px; height: 60px; source: root.decoration; }
                        Text { y: 66px; height: 16px; text: @tr("" => "Меняется в Discord"); color: Theme.muted; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                    }
                }
                Text { text: @tr("" => "Стиль отображаемого имени"); color: Theme.text2; font-size: 13px; font-weight: 700; }
                ProfileTile {
                    clicked => { root.open-web(); }
                    Text { width: parent.width - 16px; text: root.name-draft == "" ? root.username : root.name-draft; color: Theme.text; font-size: 17px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                }
                Text { text: @tr("" => "Тема и баннер"); color: Theme.text2; font-size: 13px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 8px;
                    ProfileTile {
                        clicked => { root.pick("banner-clear"); }
                        Text { text: @tr("" => "Убрать"); color: Theme.text2; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    ProfileTile {
                        clicked => { root.pick("banner"); }
                        Rectangle { background: root.has-color ? root.banner-color : transparent; }
                        if root.has-banner: Image { width: parent.width; height: parent.height; source: root.banner; image-fit: cover; }
                        if !root.has-banner: Text { text: @tr("" => "Загрузить"); color: Theme.text2; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Text { text: @tr("" => "Эффект профиля"); color: Theme.text2; font-size: 13px; font-weight: 700; }
                ProfileTile {
                    clicked => { root.open-web(); }
                    Text { text: @tr("" => "Меняется в Discord"); color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        // Middle: the card as others will see it; right: what is written in it.
        SimpleScroll {
            x: 264px;
            y: 57px;
            width: 420px;
            height: parent.height - 57px - 68px;
            side: 24px;
            Text { text: @tr("" => "Так тебя увидят"); color: Theme.muted; font-size: 12px; font-weight: 700; }
            ProfileCard {
                custom-status: root.status-draft;
                bubble-clicked => { status-field.focus-input(); }
                banner: root.banner;
                has-banner: root.has-banner;
                has-color: root.has-color;
                banner-color: root.banner-color;
                avatar: root.avatar;
                decoration: root.decoration;
                has-decoration: root.has-decoration;
                name: root.name-draft == "" ? root.username : root.name-draft;
                username: root.username;
                pronouns: root.pronouns-draft;
                bio: root.bio-draft;
                status: root.status;
                avatar-clicked => { root.pick("avatar"); }
            }
        }
        Rectangle { x: 264px + 420px; y: 57px; width: 1px; height: parent.height - 57px - 68px; background: Theme.line; }
        SimpleScroll {
            x: 264px + 421px;
            y: 57px;
            width: parent.width - 264px - 421px;
            height: parent.height - 57px - 68px;
            side: 24px;
            SettingTitle { text: @tr("" => "Свой статус"); hint: @tr("" => "Строка под твоим именем; пустая убирает её."); }
            status-field := SettingField { text <=> root.status-draft; placeholder: @tr("" => "Чем ты занят?"); }
            SettingTitle { text: @tr("" => "Отображаемое имя"); hint: @tr("" => "До 32 знаков. Пустое показывает имя пользователя."); }
            SettingField { text <=> root.name-draft; placeholder: root.username; }
            SettingTitle { text: @tr("" => "Местоимения"); hint: @tr("" => "До 40 знаков."); }
            SettingField { text <=> root.pronouns-draft; placeholder: @tr("" => "Например, они/их"); }
            SettingTitle { text: @tr("" => "О себе"); hint: @tr("" => "До 190 знаков."); }
            SettingField { text <=> root.bio-draft; multiline: true; placeholder: @tr("" => "Расскажи о себе"); }
        }
        // The bottom bar.
        Rectangle { y: parent.height - 68px; height: 1px; background: Theme.line; }
        Rectangle {
            y: parent.height - 67px;
            height: 67px;
            background: Theme.surface1;
            HorizontalLayout {
                padding-right: 24px;
                spacing: 12px;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    DialogButton { text: @tr("" => "Отмена"); clicked => { root.close(); } }
                }
                VerticalLayout {
                    alignment: center;
                    DialogButton { text: @tr("" => "Применить"); primary: true; clicked => { root.apply(root.name-draft, root.pronouns-draft, root.bio-draft, root.status-draft); root.close(); } }
                }
            }
        }
    }
}

component VoiceSettingsView inherits Rectangle {
    in-out property <VoiceSettings> settings;
    in property <[DeviceItem]> mics;
    in property <[DeviceItem]> speakers;
    in property <[DeviceItem]> cameras;
    // The settings' look at our camera (off whenever the settings open), its picture,
    // and why the camera would not start.
    in-out property <bool> camera-preview-on;
    in property <image> camera-preview-frame;
    in property <string> camera-preview-error;
    callback camera-picked(int);
    callback camera-preview-toggled(bool);
    // The mic's loudness (0..1 of -100..0 dB) and whether it sends now.
    in property <float> meter;
    in property <bool> sending;
    in property <bool> testing;
    // The push-to-talk key as it's shown ("Ctrl + Пробел").
    in property <string> key-name;
    callback changed(VoiceSettings);
    callback devices-requested();
    callback mic-picked(int);
    callback speaker-picked(int);
    callback test(bool);
    // A key was picked for push to talk: the character, the key code (0 if
    // it's a letter or a digit) and the modifiers.
    callback key-picked(string, bool, bool, bool);
    callback close();
    background: #000000b8;

    property <bool> custom-picked;
    property <bool> isolation: root.settings.noise == 2 && root.settings.echo && root.settings.auto-gain && root.settings.auto-threshold;
    property <bool> studio: root.settings.noise == 0 && !root.settings.echo && !root.settings.auto-gain && !root.settings.auto-threshold && root.settings.threshold <= -100;
    property <int> profile: root.custom-picked ? 2 : root.isolation ? 0 : root.studio ? 1 : 2;
    // While the key is being picked, the next key press is the new one.
    property <bool> capturing;
    // Whose key it is: 0 push to talk, 1 mute, 2 sound off.
    property <int> capture-target;
    in property <string> mute-key-name;
    in property <string> deafen-key-name;
    callback hotkey-picked(int, string, bool, bool, bool);

    function apply() {
        root.changed(root.settings);
    }

    TouchArea { clicked => { root.close(); } }

    // Takes the key press while the push-to-talk key is being picked.
    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (!root.capturing) { return reject; }
            root.capturing = false;
            if (root.capture-target == 0) {
                root.key-picked(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
            } else {
                root.hotkey-picked(root.capture-target, event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
            }
            return accept;
        }
        key-released(event) => {
            if (!root.capturing) { return reject; }
            root.capturing = false;
            return accept;
        }
    }

    // Sections as in Discord's settings, in order. p: the page (-1: a group heading).
    // Real pages: 0 account, 6 voice, 7 streaming, 8 sounds, 16 about, 20 customize; the rest
    // only point to Discord, where those settings live.
    in-out property <int> page: 6;
    property <length> nav-w: 270px;
    property <length> side: max(24px, (min(1100px, root.width - 48px) - root.nav-w - 580px) / 2);
    property <[{t: string, p: int, i: string}]> nav: [
        { t: @tr("" => "Настройки пользователя"), p: -1, i: "" },
        { t: @tr("" => "Моя учётная запись"), p: 0, i: Icons.user },
        { t: @tr("" => "Данные и конфиденциальность"), p: 1, i: Icons.shield },
        { t: @tr("" => "Разрешения для сообщений"), p: 2, i: Icons.mail },
        { t: @tr("" => "Уведомления"), p: 3, i: Icons.bell },
        { t: @tr("" => "Выставление счетов"), p: -1, i: "" },
        { t: "Nitro", p: 4, i: Icons.star },
        { t: @tr("" => "Буст сервера"), p: 17, i: Icons.diamond },
        { t: @tr("" => "Подписки"), p: 5, i: Icons.refresh },
        { t: @tr("" => "Склад подарков"), p: 18, i: Icons.gift },
        { t: @tr("" => "Выставление счетов"), p: 19, i: Icons.card },
        { t: @tr("" => "Взаимодействие"), p: -1, i: "" },
        { t: @tr("" => "Голос и видео"), p: 6, i: Icons.mic },
        { t: @tr("" => "Внешний вид"), p: 9, i: Icons.palette },
        { t: @tr("" => "Специальные возможности"), p: 10, i: Icons.access },
        { t: @tr("" => "Система"), p: 11, i: Icons.keyboard },
        { t: @tr("" => "Язык и время"), p: 12, i: Icons.language },
        { t: @tr("" => "Игры и приложения"), p: -1, i: "" },
        { t: @tr("" => "Зарегистрированные игры"), p: 13, i: Icons.gamepad },
        { t: @tr("" => "Конфиденциальность активности"), p: 14, i: Icons.pulse },
        { t: @tr("" => "Подключённые приложения"), p: 15, i: Icons.link },
        { t: "Nimbus", p: -1, i: "" },
        { t: @tr("" => "Кастомизация"), p: 20, i: Icons.edit },
        { t: @tr("" => "О программе"), p: 16, i: Icons.info },
    ];
    function title-of(p: int) -> string {
        return p == 0 ? @tr("" => "Моя учётная запись") : p == 1 ? @tr("" => "Данные и конфиденциальность") : p == 2 ? @tr("" => "Разрешения для сообщений")
            : p == 3 ? @tr("" => "Уведомления") : p == 4 ? "Nitro" : p == 5 ? @tr("" => "Подписки") : p == 6 ? @tr("" => "Голос и видео")
            : p == 9 ? @tr("" => "Внешний вид") : p == 10 ? @tr("" => "Специальные возможности")
            : p == 11 ? @tr("" => "Система") : p == 12 ? @tr("" => "Язык и время") : p == 13 ? @tr("" => "Зарегистрированные игры")
            : p == 14 ? @tr("" => "Конфиденциальность активности") : p == 15 ? @tr("" => "Подключённые приложения")
            : p == 17 ? @tr("" => "Буст сервера") : p == 18 ? @tr("" => "Склад подарков") : p == 19 ? @tr("" => "Выставление счетов") : p == 20 ? @tr("" => "Кастомизация") : @tr("" => "О программе");
    }
    function link-note(p: int) -> string {
        return p == 1 ? @tr("" => "Кто может добавлять тебя в друзья, фильтр личных сообщений, выгрузка и удаление данных. Это настройки самого аккаунта: Nimbus их не меняет, чтобы ничего не нарушить.")
            : p == 2 ? @tr("" => "Кто может писать тебе в личные сообщения с серверов. Хранится в аккаунте: меняется в Discord.")
            : p == 4 || p == 17 ? @tr("" => "Nitro и его возможности привязаны к аккаунту и оплате. Управлять подпиской нужно в самом Discord.")
            : p == 5 || p == 18 || p == 19 ? @tr("" => "Подписки, платежи и склад подарков. Nimbus не работает с оплатой: всё это делается на сайте Discord.")
            : p == 13 ? @tr("" => "Игры, которые Discord показывает в твоём статусе. Их список ведёт официальное приложение.")
            : p == 14 ? @tr("" => "Что видят другие: твой статус и игра. Настройка хранится в аккаунте, меняется в Discord.")
            : p == 15 ? @tr("" => "Приложения и боты, которым ты дал доступ к аккаунту. Отозвать доступ можно только на сайте Discord.")
            : @tr("" => "Этих настроек в Nimbus пока нет. Они хранятся в твоём аккаунте Discord и меняются там: в официальном приложении или на сайте.");
    }
    // The parts of a page, shown under its name in the list on the left.
    function subs(p: int) -> [string] {
        return p == 0 ? [@tr("" => "Информация об учётной записи"), @tr("" => "Пароль и безопасность")]
            : p == 3 ? [@tr("" => "Уведомления на рабочем столе"), @tr("" => "Звуки")]
            : p == 6 ? [@tr("" => "Голос"), @tr("" => "Стриминг"), @tr("" => "Звуки"), @tr("" => "Расширенные")]
            : p == 9 ? [@tr("" => "Тема"), @tr("" => "Значок приложения"), @tr("" => "Сообщения"), @tr("" => "Режим стримера")]
            : p == 10 ? [@tr("" => "Цвет и контраст"), @tr("" => "Пониженное движение")]
            : p == 11 ? [@tr("" => "Основные")]
            : p == 12 ? [@tr("" => "Язык"), @tr("" => "Время и дата")]
            : p == 1 || p == 2 || p == 4 || p == 5 || p == 13 || p == 14 || p == 15 || p == 17 || p == 18 || p == 19 ? root.section-titles(p)
            : [];
    }
    function section-titles(p: int) -> [string] {
        return p == 1 ? [@tr("" => "Как используются мои данные"), @tr("" => "Спонсируемый контент"), @tr("" => "Приватность профиля"), @tr("" => "Шифрование голосовых чатов")]
            : p == 2 ? [@tr("" => "Фильтры содержимого"), @tr("" => "Защита от спама"), @tr("" => "Личные сообщения"), @tr("" => "Запросы в друзья"), @tr("" => "Игнорирование и блокировка")]
            : p == 4 ? ["Nitro"]
            : p == 17 ? [@tr("" => "Буст сервера")]
            : p == 5 ? [@tr("" => "Подписки")]
            : p == 18 ? [@tr("" => "Склад подарков")]
            : p == 19 ? [@tr("" => "Выставление счетов")]
            : p == 13 ? [@tr("" => "Текущая игра"), @tr("" => "Добавленные игры")]
            : p == 14 ? [@tr("" => "Какой активностью я делюсь"), @tr("" => "Где я публикую активность"), @tr("" => "Присоединение к активности")]
            : p == 15 ? [@tr("" => "Подключённые приложения")]
            : [];
    }    // The parts of a page that live in the account, in the order Discord shows them.
    function sections(p: int) -> [{t: string, h: string}] {
        return p == 1 ? [
                { t: @tr("" => "Как используются мои данные"), h: @tr("" => "Что Discord собирает и для чего: настройка отбора данных и выгрузка архива.") },
                { t: @tr("" => "Спонсируемый контент"), h: @tr("" => "Показывать ли рекламные материалы партнёров.") },
                { t: @tr("" => "Приватность профиля"), h: @tr("" => "Кто видит твои подключения и активность на странице профиля.") },
                { t: @tr("" => "Шифрование голосовых чатов"), h: @tr("" => "Голос и видео шифруются от края до края. Nimbus поддерживает такое шифрование.") },
            ]
            : p == 2 ? [
                { t: @tr("" => "Фильтры содержимого"), h: @tr("" => "Проверка картинок и вложений в личных сообщениях.") },
                { t: @tr("" => "Защита от спама"), h: @tr("" => "Отбор подозрительных сообщений и запросов.") },
                { t: @tr("" => "Личные сообщения"), h: @tr("" => "Кто может писать тебе с общих серверов.") },
                { t: @tr("" => "Запросы в друзья"), h: @tr("" => "Кто может отправлять тебе запросы.") },
                { t: @tr("" => "Игнорирование и блокировка"), h: @tr("" => "Список людей, чьи сообщения скрыты или заблокированы.") },
            ]
            : p == 4 ? [{ t: "Nitro", h: @tr("" => "Подписка с расширенными возможностями: размер файлов, качество показа экрана, свои эмодзи.") }]
            : p == 17 ? [{ t: @tr("" => "Буст сервера"), h: @tr("" => "Улучшение серверов за счёт бустов.") }]
            : p == 5 ? [{ t: @tr("" => "Подписки"), h: @tr("" => "Твои действующие подписки и их продление.") }]
            : p == 18 ? [{ t: @tr("" => "Склад подарков"), h: @tr("" => "Коды и купленные подарки.") }]
            : p == 19 ? [{ t: @tr("" => "Выставление счетов"), h: @tr("" => "Способы оплаты и история операций.") }]
            : p == 13 ? [
                { t: @tr("" => "Текущая игра"), h: @tr("" => "Игра, которая сейчас показана в твоём статусе.") },
                { t: @tr("" => "Добавленные игры"), h: @tr("" => "Игры, добавленные вручную, чтобы статус их показывал.") },
            ]
            : p == 14 ? [
                { t: @tr("" => "Какой активностью я делюсь"), h: @tr("" => "Показывать ли игру и статус другим людям.") },
                { t: @tr("" => "Где я публикую активность"), h: @tr("" => "На каких серверах видна твоя активность.") },
                { t: @tr("" => "Присоединение к активности"), h: @tr("" => "Могут ли друзья присоединяться к тебе без запроса.") },
            ]
            : p == 15 ? [
                { t: @tr("" => "Подключённые приложения"), h: @tr("" => "Приложения и боты с доступом к аккаунту.") },
            ]
            : [];
    }
    // The account's privacy settings as Discord has them (set when they have been fetched).
    in property <bool> priv-ready;
    in-out property <int> priv-explicit;
    in-out property <bool> priv-friends-all;
    in-out property <bool> priv-friends-friends;
    in-out property <bool> priv-friends-guilds;
    callback privacy-changed(string, int);
    callback friend-sources-changed(bool, bool, bool);
    // The presence and profile of the account: status (0 online, 1 idle, 2 do not disturb, 3 invisible),
    // the text under the name, the "about me", and whether the game being played is shown.
    in-out property <int> my-status;
    in-out property <string> my-custom-status;
    in-out property <string> my-bio;
    in-out property <bool> show-game;
    callback custom-status-saved(string);
    callback bio-saved(string);
    property <bool> linked: root.page == 1 || root.page == 4 || root.page == 5 || root.page == 13 || root.page == 15 || root.page == 17 || root.page == 18 || root.page == 19;
    callback appearance-changed(float);
    in property <string> me-email;
    in property <string> me-phone;
    in property <bool> me-mfa;
    property <bool> reveal;
    callback open-web();
    callback sign-out();
    pure callback nav-match(string, string) -> bool;
    property <string> query;
    in-out property <bool> notify-enabled;
    in-out property <bool> notify-sound;
    in-out property <bool> notify-text;
    in-out property <bool> notify-everyone;
    callback notify-changed();
    in-out property <bool> tray-on;
    in-out property <bool> autostart-on;
    callback tray-toggled(bool);
    callback autostart-toggled(bool);
    callback forget-servers();
    in property <string> me-name;
    in property <string> me-id;
    in property <image> me-avatar;
    in property <string> version;
    // The stream quality used by the share menu (same values).
    in-out property <int> share-height;
    in-out property <int> share-fps;
    in-out property <bool> share-sound;
    // Where a show goes: 0 the Nimbus room, 1 Discord, 2 both.
    in-out property <int> share-dest: 1;
    callback copy(string);
    callback open-sounds();
    property <bool> shown;
    init => { self.shown = true; }
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: Appearance.slow; easing: ease-out; }

    Rectangle {
        y: (root.height - self.height) / 2 + (root.shown ? 0px : 18px);
        animate y { duration: Appearance.slow; easing: ease-out; }
        width: min(1100px, root.width - 48px);
        height: min(860px, root.height - 48px);
        border-radius: 10px;
        background: Theme.glass-strong;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        clip: true;
        TouchArea {}

        // Left: the sections.
        Rectangle {
            x: 0;
            y: 0;
            width: root.nav-w;
            height: parent.height;
            background: Theme.surface0;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
            // Who you are, with the way to the account page.
            Rectangle {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: 60px;
                border-radius: 8px;
                background: me-area.has-hover ? Theme.hover : transparent;
                me-area := TouchArea { mouse-cursor: pointer; clicked => { root.page = 0; } }
                Rectangle {
                    x: 8px;
                    y: 10px;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    clip: true;
                    background: Theme.surface3;
                    Image { width: 40px; height: 40px; source: root.me-avatar; image-fit: cover; }
                }
                Text { x: 58px; y: 10px; width: parent.width - 64px; text: root.me-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                Text { x: 58px; y: 32px; width: parent.width - 64px; text: @tr("" => "Редактировать профиль"); color: Theme.text2; font-size: 12px; overflow: elide; }
            }
            Rectangle { x: 16px; y: 78px; width: parent.width - 32px; height: 1px; background: Theme.line; }
            Rectangle {
                x: 12px;
                y: 86px;
                width: parent.width - 24px;
                height: 32px;
                border-radius: 6px;
                background: Theme.surface3;
                search := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    vertical-alignment: center;
                    text <=> root.query;
                    color: Theme.text;
                    font-size: 14px;
                    single-line: true;
                }
                if root.query == "": Text { x: 10px; height: parent.height; text: @tr("" => "Поиск"); color: Theme.muted; font-size: 14px; vertical-alignment: center; }
            }
            Rectangle {
                x: 12px;
                y: parent.height - 62px;
                width: parent.width - 24px;
                height: 32px;
                border-radius: 6px;
                background: out-area.has-hover ? Theme.hover : transparent;
                out-area := TouchArea { mouse-cursor: pointer; clicked => { root.sign-out(); } }
                Text { x: 10px; height: parent.height; text: @tr("" => "Выйти из аккаунта"); color: #f23f43; font-size: 14px; font-weight: 600; vertical-alignment: center; }
            }
            Text {
                x: 16px;
                y: parent.height - 26px;
                text: "Nimbus " + root.version;
                color: Theme.muted;
                font-size: 11px;
            }
            Flickable {
                y: 124px;
                height: parent.height - 124px - 64px;
                content-height: nav-col.preferred-height;
                nav-col := VerticalLayout {
                    alignment: start;
                    padding: 12px;
                    padding-top: 8px;
                    spacing: 1px;
                    for item in root.nav: VerticalLayout {
                        spacing: 1px;
                        if root.query == "" || (item.p >= 0 && root.nav-match(item.t, root.query)): Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: item.p >= 0 && root.page == item.p ? Theme.active : (nav-area.has-hover && item.p >= 0 ? Theme.hover : transparent);
                            if item.p < 0 && item.t != root.nav[0].t: Rectangle { x: 4px; y: 0; width: parent.width - 8px; height: 1px; background: Theme.line; }
                            if item.p >= 0: Icon { x: 12px; y: 6px; width: 20px; height: 20px; commands: item.i; tint: root.page == item.p ? Theme.text : Theme.text2; }
                            if item.p >= 0 && root.page == item.p: Rectangle { x: 0; y: 7px; width: 3px; height: parent.height - 14px; border-radius: 2px; background: Theme.accent; }
                            nav-area := TouchArea { enabled: item.p >= 0; mouse-cursor: pointer; clicked => { Scroller.target = -1; Scroller.active = 0; root.page = item.p; } }
                            Text {
                                x: item.p < 0 ? 4px : 38px;
                                y: item.p < 0 ? 8px : 0px;
                                width: parent.width - (item.p < 0 ? 14px : 46px);
                                height: item.p < 0 ? 20px : parent.height;
                                text: item.t;
                                color: item.p < 0 ? Theme.muted : (root.page == item.p ? Theme.text : Theme.text2);
                                font-size: item.p < 0 ? 12px : 14px;
                                font-weight: item.p < 0 ? 600 : 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        // The parts of the open page: a click scrolls to one.
                        if root.query == "" && item.p >= 0 && root.page == item.p: VerticalLayout {
                            for part[k] in root.subs(item.p): Rectangle {
                                height: 28px;
                                border-radius: 6px;
                                background: sub-area.has-hover ? Theme.hover : transparent;
                                if Scroller.active == k: Rectangle { x: 14px; y: 5px; width: 2px; height: parent.height - 10px; background: Theme.text; }
                                sub-area := TouchArea { mouse-cursor: pointer; clicked => { Scroller.target = k; Scroller.active = k; Scroller.stamp += 1; } }
                                Text {
                                    x: 28px;
                                    width: parent.width - 36px;
                                    height: parent.height;
                                    text: part;
                                    color: Scroller.active == k ? Theme.text : Theme.text2;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        Text {
            x: root.nav-w + root.side;
            y: 0;
            height: 60px;
            text: root.title-of(root.page);
            color: Theme.text;
            font-size: 20px;
            font-weight: 800;
            vertical-alignment: center;
        }
        Rectangle {
            x: parent.width - 48px;
            y: 14px;
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: close-area.has-hover ? Theme.hover : transparent;
            close-area := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
            Icon { x: 6px; y: 6px; commands: Icons.close; tint: Theme.text2; }
        }
        Rectangle { x: root.nav-w; y: 60px; height: 1px; background: Theme.line; }

        // Account
        if root.page == 0: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
            Anchor { key: 0; text: @tr("" => "Информация об учётной записи"); }
            Rectangle {
                height: 110px;
                border-radius: 10px;
                background: Theme.surface0;
                Rectangle {
                    x: 20px;
                    y: 20px;
                    width: 70px;
                    height: 70px;
                    border-radius: 35px;
                    clip: true;
                    background: Theme.surface3;
                    Image { width: 70px; height: 70px; source: root.me-avatar; image-fit: cover; }
                }
                Text { x: 108px; y: 30px; text: root.me-name; color: Theme.text; font-size: 20px; font-weight: 800; }
                Text { x: 108px; y: 62px; text: Appearance.streamer-live ? "ID: ••••••••" : "ID: " + root.me-id; color: Theme.muted; font-size: 13px; }
            }
            // What Discord keeps for the account; the e-mail and phone are hidden until asked.
            for row in [
                { k: @tr("" => "Имя пользователя"), v: root.me-name, hide: false },
                { k: @tr("" => "Электронная почта"), v: root.me-email, hide: true },
                { k: @tr("" => "Номер телефона"), v: root.me-phone == "" ? @tr("" => "не указан") : root.me-phone, hide: root.me-phone != "" },
            ]: Rectangle {
                height: 58px;
                border-radius: 8px;
                background: Theme.surface0;
                Text { x: 16px; y: 9px; text: row.k; color: Theme.muted; font-size: 11px; font-weight: 700; }
                Text {
                    x: 16px;
                    y: 28px;
                    text: row.hide && (!root.reveal || Appearance.streamer-live) ? "••••••••" : row.v;
                    color: Theme.text;
                    font-size: 15px;
                }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                Rectangle {
                    width: copy-label.preferred-width + 32px;
                    height: 36px;
                    border-radius: 6px;
                    background: copy-area.has-hover ? Theme.button-hover : Theme.button;
                    copy-area := TouchArea { mouse-cursor: pointer; clicked => { root.copy(root.me-id); } }
                    copy-label := Text { text: @tr("" => "Копировать мой ID"); color: Theme.text; font-size: 14px; font-weight: 600; }
                }
                Rectangle {
                    width: show-label.preferred-width + 32px;
                    height: 36px;
                    border-radius: 6px;
                    background: show-area.has-hover ? Theme.button-hover : Theme.button;
                    show-area := TouchArea { enabled: !Appearance.streamer-live; mouse-cursor: pointer; clicked => { root.reveal = !root.reveal; } }
                    show-label := Text { text: root.reveal ? @tr("" => "Скрыть почту и телефон") : @tr("" => "Показать почту и телефон"); color: Theme.text; font-size: 14px; font-weight: 600; }
                }
            }
            Text {
                text: @tr("" => "Имя, почту, пароль и телефон меняй в Discord. Nimbus такие изменения не отправляет.");
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
            SettingTitle { text: @tr("" => "Статус"); hint: @tr("" => "Как тебя видят другие. Меняется на аккаунте сразу."); }
            Radio { text: @tr("" => "В сети"); on: root.my-status == 0; enabled: root.priv-ready; clicked => { root.my-status = 0; root.privacy-changed("status", 0); } }
            Radio { text: @tr("" => "Неактивен"); on: root.my-status == 1; enabled: root.priv-ready; clicked => { root.my-status = 1; root.privacy-changed("status", 1); } }
            Radio { text: @tr("" => "Не беспокоить"); hint: @tr("" => "Уведомления отключены"); on: root.my-status == 2; enabled: root.priv-ready; clicked => { root.my-status = 2; root.privacy-changed("status", 2); } }
            Radio { text: @tr("" => "Невидимый"); hint: @tr("" => "Ты в сети, но показываешься как не в сети"); on: root.my-status == 3; enabled: root.priv-ready; clicked => { root.my-status = 3; root.privacy-changed("status", 3); } }
            SettingTitle { text: @tr("" => "Свой статус"); hint: @tr("" => "Строка под твоим именем; пустая убирает её."); }
            SettingField { text <=> root.my-custom-status; placeholder: @tr("" => "Чем ты занят?"); }
            HorizontalLayout { alignment: start; SaveButton { text: @tr("" => "Сохранить статус"); clicked => { root.custom-status-saved(root.my-custom-status); } } }
            SettingTitle { text: @tr("" => "О себе"); hint: @tr("" => "Короткий текст в твоём профиле, до 190 знаков."); }
            SettingField { text <=> root.my-bio; multiline: true; placeholder: @tr("" => "Расскажи о себе"); }
            HorizontalLayout { alignment: start; SaveButton { text: @tr("" => "Сохранить «О себе»"); clicked => { root.bio-saved(root.my-bio); } } }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 1; text: @tr("" => "Пароль и безопасность"); }
            Rectangle {
                height: 34px;
                Text { x: 0; text: @tr("" => "Двухфакторная аутентификация"); color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                Text { x: parent.width - self.width; text: root.me-mfa ? @tr("" => "Включена") : @tr("" => "Выключена"); color: Theme.text2; font-size: 14px; vertical-alignment: center; }
            }
            Rectangle {
                height: 64px;
                border-radius: 8px;
                background: acc-web-area.has-hover ? Theme.button-hover : Theme.button;
                acc-web-area := TouchArea { mouse-cursor: pointer; clicked => { root.open-web(); } }
                Text { x: 16px; y: 12px; text: @tr("" => "Связанные настройки"); color: Theme.text; font-size: 14px; font-weight: 700; }
                Text { x: 16px; y: 34px; text: @tr("" => "Открыть Discord в браузере"); color: Theme.text2; font-size: 13px; }
                Icon { x: parent.width - 36px; y: 20px; commands: Icons.chevron-right; tint: Theme.text2; }
            }
        }

        // Message permissions: what the account allows, changed on Discord's side through its API.
        if root.page == 2: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
            Anchor { key: 0; text: @tr("" => "Фильтры контента"); }
            SettingTitle { text: @tr("" => "Проверять картинки в личных сообщениях"); hint: @tr("" => "Discord размывает то, что считает неприемлемым. Меняется на аккаунте."); }
            if !root.priv-ready: Text { text: @tr("" => "Не удалось получить настройки с Discord. Проверь соединение и открой окно заново."); color: Theme.text2; font-size: 13px; wrap: word-wrap; }
            Radio { text: @tr("" => "Проверять всё"); hint: @tr("" => "Сообщения от всех, включая друзей"); on: root.priv-explicit == 2; enabled: root.priv-ready; clicked => { root.priv-explicit = 2; root.privacy-changed("explicit", 2); } }
            Radio { text: @tr("" => "Проверять от не друзей"); hint: @tr("" => "Друзьям доверяем"); on: root.priv-explicit == 1; enabled: root.priv-ready; clicked => { root.priv-explicit = 1; root.privacy-changed("explicit", 1); } }
            Radio { text: @tr("" => "Не проверять"); on: root.priv-explicit == 0; enabled: root.priv-ready; clicked => { root.priv-explicit = 0; root.privacy-changed("explicit", 0); } }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 1; text: @tr("" => "Фильтры спама"); }
            Text { text: @tr("" => "Фильтры спама можно изменить только на сайте Discord."); color: Theme.text2; font-size: 13px; wrap: word-wrap; }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 2; text: @tr("" => "Личные сообщения"); }
            Text { text: @tr("" => "Личные сообщения от участников серверов настрой на сайте Discord."); color: Theme.text2; font-size: 13px; wrap: word-wrap; }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 3; text: @tr("" => "Запросы дружбы"); }
            SettingTitle { text: @tr("" => "Кто может отправлять запросы в друзья"); hint: @tr("" => "Меняется на аккаунте сразу."); }
            ToggleRow {
                text: @tr("" => "Все");
                on: root.priv-friends-all;
                toggled(v) => {
                    if (root.priv-ready) {
                        root.priv-friends-all = v;
                        if (v) { root.priv-friends-friends = true; root.priv-friends-guilds = true; }
                        root.friend-sources-changed(root.priv-friends-all, root.priv-friends-friends, root.priv-friends-guilds);
                    }
                }
            }
            ToggleRow {
                text: @tr("" => "Друзья друзей");
                on: root.priv-friends-friends;
                toggled(v) => {
                    if (root.priv-ready) {
                        root.priv-friends-friends = v;
                        root.friend-sources-changed(root.priv-friends-all, root.priv-friends-friends, root.priv-friends-guilds);
                    }
                }
            }
            ToggleRow {
                text: @tr("" => "Участники общих серверов");
                on: root.priv-friends-guilds;
                toggled(v) => {
                    if (root.priv-ready) {
                        root.priv-friends-guilds = v;
                        root.friend-sources-changed(root.priv-friends-all, root.priv-friends-friends, root.priv-friends-guilds);
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 4; text: @tr("" => "Подключённые игры"); }
            Text { text: @tr("" => "Подключённые игры и список заблокированных меняй на сайте Discord."); color: Theme.text2; font-size: 13px; wrap: word-wrap; }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 5; text: @tr("" => "Игнорировать и заблокировать"); }
            Rectangle {
                height: 64px;
                border-radius: 8px;
                background: perm-web-area.has-hover ? Theme.button-hover : Theme.button;
                perm-web-area := TouchArea { mouse-cursor: pointer; clicked => { root.open-web(); } }
                Text { x: 16px; y: 12px; text: @tr("" => "Связанные настройки"); color: Theme.text; font-size: 14px; font-weight: 700; }
                Text { x: 16px; y: 34px; text: @tr("" => "Открыть Discord в браузере"); color: Theme.text2; font-size: 13px; }
                Icon { x: parent.width - 36px; y: 20px; commands: Icons.chevron-right; tint: Theme.text2; }
            }
        }

        // Activity privacy: whether the game being played is shown, kept on the account.
        if root.page == 14: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
            Anchor { key: 0; text: @tr("" => "Какой активностью я делюсь"); }
            if !root.priv-ready: Text { text: @tr("" => "Не удалось получить настройки с Discord. Проверь соединение и открой окно заново."); color: Theme.text2; font-size: 13px; wrap: word-wrap; }
            ToggleRow {
                text: @tr("" => "Показывать игру, в которую я играю");
                hint: @tr("" => "Другие видят её в твоём профиле и в списке. Меняется на аккаунте сразу.");
                on: root.show-game;
                toggled(v) => { if (root.priv-ready) { root.show-game = v; root.privacy-changed("show-game", v ? 1 : 0); } }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 1; text: @tr("" => "Где я публикую активность"); }
            Text { text: @tr("" => "Серверы, где видна активность, выбирай на сайте Discord."); color: Theme.text2; font-size: 13px; wrap: word-wrap; }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 2; text: @tr("" => "Присоединение к активности"); }
            Rectangle {
                height: 64px;
                border-radius: 8px;
                background: act-web-area.has-hover ? Theme.button-hover : Theme.button;
                act-web-area := TouchArea { mouse-cursor: pointer; clicked => { root.open-web(); } }
                Text { x: 16px; y: 12px; text: @tr("" => "Связанные настройки"); color: Theme.text; font-size: 14px; font-weight: 700; }
                Text { x: 16px; y: 34px; text: @tr("" => "Открыть Discord в браузере"); color: Theme.text2; font-size: 13px; }
                Icon { x: parent.width - 36px; y: 20px; commands: Icons.chevron-right; tint: Theme.text2; }
            }
        }

        // Sections that Nimbus doesn't have yet: said plainly, with the way to Discord.
        if root.linked: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
            Text { text: root.link-note(root.page); color: Theme.text2; font-size: 14px; wrap: word-wrap; }
            for sec[i] in root.sections(root.page): VerticalLayout {
                spacing: 8px;
                Rectangle { height: 1px; background: Theme.line; }
                Anchor { key: i; text: sec.t; }
                Text { text: sec.h; color: Theme.text2; font-size: 13px; wrap: word-wrap; }
            }
            Rectangle {
                height: 64px;
                border-radius: 8px;
                background: web-area.has-hover ? Theme.button-hover : Theme.button;
                web-area := TouchArea { mouse-cursor: pointer; clicked => { root.open-web(); } }
                Text { x: 16px; y: 12px; text: @tr("" => "Связанные настройки"); color: Theme.text; font-size: 14px; font-weight: 700; }
                Text { x: 16px; y: 34px; text: @tr("" => "Открыть Discord в браузере"); color: Theme.text2; font-size: 13px; }
                Icon { x: parent.width - 36px; y: 20px; commands: Icons.chevron-right; tint: Theme.text2; }
            }
        }

        // Appearance
        if root.page == 9: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
            Anchor { key: 0; text: @tr("" => "Тема"); }
            SettingTitle { text: @tr("" => "Фон"); hint: @tr("" => "Цвет окон и панелей. Меняется сразу."); }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Swatch { text: @tr("" => "Чёрная"); fill: #0d0d0f; fill2: #1b1b1f; on: Appearance.theme == 0; clicked => { Appearance.theme = 0; root.appearance-changed(0); } }
                Swatch { text: @tr("" => "Графит"); fill: #2b2d31; fill2: #383a40; on: Appearance.theme == 1; clicked => { Appearance.theme = 1; root.appearance-changed(0); } }
                Swatch { text: @tr("" => "Полночь"); fill: #121829; fill2: #1d2540; on: Appearance.theme == 2; clicked => { Appearance.theme = 2; root.appearance-changed(0); } }
                Swatch { text: @tr("" => "Светлая"); fill: #ffffff; fill2: #d4d7dc; on: Appearance.theme == 3; clicked => { Appearance.theme = 3; root.appearance-changed(0); } }
            }
            SettingTitle { text: @tr("" => "Цвет акцента"); hint: @tr("" => "Кнопки, переключатели и полоски выбора."); }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                for c[n] in [Theme.light ? #111111 : #ffffff, #4f8cff, #2fb36e, #e865a0, #f0883e]: Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: c;
                    border-width: 3px;
                    border-color: Appearance.accent == n ? Theme.text : transparent;
                    TouchArea { mouse-cursor: pointer; clicked => { Appearance.accent = n; root.appearance-changed(0); } }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 1; text: @tr("" => "Значок приложения"); }
            SettingTitle { text: @tr("" => "Цвет значка"); hint: @tr("" => "Значок в заголовке окна, на панели задач и в трее."); }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                for pic[n] in Appearance.icon-previews: Swatch {
                    text: n == 0 ? @tr("" => "Чёрный") : n == 1 ? @tr("" => "Белый") : n == 2 ? @tr("" => "Серый") : @tr("" => "Тусклый");
                    picture: pic;
                    on: Appearance.app-icon == n;
                    clicked => { Appearance.app-icon = n; root.appearance-changed(0); }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 2; text: @tr("" => "Сообщения"); }
            SettingTitle { text: @tr("" => "Размер текста сообщений"); hint: @tr("" => "Меняется сразу и запоминается."); }
            Radio { text: @tr("" => "Мелкий"); hint: "90%"; on: Appearance.scale == 0.9; clicked => { Appearance.scale = 0.9; root.appearance-changed(0.9); } }
            Radio { text: @tr("" => "Средний"); hint: "100%"; on: Appearance.scale == 1.0; clicked => { Appearance.scale = 1.0; root.appearance-changed(1.0); } }
            Radio { text: @tr("" => "Крупный"); hint: "115%"; on: Appearance.scale == 1.15; clicked => { Appearance.scale = 1.15; root.appearance-changed(1.15); } }
            Radio { text: @tr("" => "Очень крупный"); hint: "130%"; on: Appearance.scale == 1.3; clicked => { Appearance.scale = 1.3; root.appearance-changed(1.3); } }
            ToggleRow {
                text: @tr("" => "Компактный режим");
                hint: @tr("" => "Сообщения разных авторов стоят ближе друг к другу.");
                on: Appearance.compact;
                toggled(v) => { Appearance.compact = v; root.appearance-changed(0); }
            }
            ToggleRow {
                text: @tr("" => "Показывать время у автора");
                hint: @tr("" => "Время сообщения рядом с именем.");
                on: Appearance.show-time;
                toggled(v) => { Appearance.show-time = v; root.appearance-changed(0); }
            }
            // A preview, the way two messages look with these choices.
            Rectangle {
                height: 120px;
                border-radius: 8px;
                background: Theme.surface0;
                clip: true;
                VerticalLayout {
                    padding: 14px;
                    spacing: Appearance.compact ? 4px : 14px;
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text { text: @tr("" => "Алекс"); color: Theme.text; font-size: 15px; font-weight: 600; }
                            if Appearance.show-time: Text { text: @tr("" => "Сегодня, 21:52"); color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                        }
                        Text { text: @tr("" => "Так выглядит текст сообщения."); color: Theme.body; font-size: 16px * Appearance.scale; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text { text: "demo_bob"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            if Appearance.show-time: Text { text: @tr("" => "Сегодня, 21:53"); color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                        }
                        Text { text: @tr("" => "А это ответ на него."); color: Theme.body; font-size: 16px * Appearance.scale; }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 3; text: @tr("" => "Режим стримера"); }
            ToggleRow {
                text: @tr("" => "Включить режим стримера");
                hint: @tr("" => "Прячет почту, телефон и номер аккаунта в настройках и отключает всплывающие уведомления и их звук.");
                on: Appearance.streamer;
                toggled(v) => { Appearance.streamer = v; root.appearance-changed(0); }
            }
            ToggleRow {
                text: @tr("" => "Включать сам при показе экрана");
                hint: @tr("" => "Пока ты показываешь экран, режим стримера включён. Когда показ закончится, он выключится.");
                on: Appearance.streamer-auto;
                toggled(v) => { Appearance.streamer-auto = v; root.appearance-changed(0); }
            }
            ToggleRow {
                text: @tr("" => "Скрывать Nimbus при показе экрана");
                hint: @tr("" => "Пока ты показываешь экран, окна Nimbus не будет ни в демонстрации, ни на скриншотах. Выключено: зрители видят твои чаты.");
                on: Appearance.hide-from-capture;
                toggled(v) => { Appearance.hide-from-capture = v; root.appearance-changed(0); }
            }        }

        // Notifications
        if root.page == 3: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
            Anchor { key: 0; text: @tr("" => "Уведомления на рабочем столе"); }
            ToggleRow {
                text: @tr("" => "Уведомления о новых сообщениях");
                hint: @tr("" => "Небольшое окно в углу экрана, пока Nimbus не в фокусе: для личных сообщений и упоминаний. Заглушённые каналы и серверы молчат.");
                on: root.notify-enabled;
                toggled(v) => { root.notify-enabled = v; root.notify-changed(); }
            }
            ToggleRow {
                text: @tr("" => "Показывать текст сообщения");
                hint: @tr("" => "Выключи, чтобы в уведомлении было только «Новое сообщение».");
                on: root.notify-text;
                toggled(v) => { root.notify-text = v; root.notify-changed(); }
            }
            ToggleRow {
                text: @tr("" => "@everyone и @here");
                hint: @tr("" => "Считать их упоминанием.");
                on: root.notify-everyone;
                toggled(v) => { root.notify-everyone = v; root.notify-changed(); }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 1; text: @tr("" => "Звуки"); }
            ToggleRow {
                text: @tr("" => "Звук уведомления");
                hint: @tr("" => "Собственный короткий звук Nimbus.");
                on: root.notify-sound;
                toggled(v) => { root.notify-sound = v; root.notify-changed(); }
            }
        }

        // System
        if root.page == 11: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
            Anchor { key: 0; text: @tr("" => "Основные"); }
            ToggleRow {
                text: @tr("" => "Сворачивать в трей при закрытии");
                hint: @tr("" => "Крестик прячет окно, а Nimbus продолжает работать в трее. Чтобы закрыть совсем, используй меню значка.");
                on: root.tray-on;
                toggled(v) => { root.tray-on = v; root.tray-toggled(v); }
            }
            ToggleRow {
                text: @tr("" => "Запускать вместе с Windows");
                hint: @tr("" => "Выключено по умолчанию. Включится, только если ты сам нажмёшь переключатель.");
                on: root.autostart-on;
                toggled(v) => { root.autostart-on = v; root.autostart-toggled(v); }
            }
            Rectangle {
                width: forget-label.preferred-width + 32px;
                height: 36px;
                border-radius: 6px;
                background: forget-area.has-hover ? Theme.button-hover : Theme.button;
                forget-area := TouchArea { mouse-cursor: pointer; clicked => { root.forget-servers(); } }
                forget-label := Text { text: @tr("" => "Забыть решения о голосовых серверах"); color: Theme.text; font-size: 14px; font-weight: 600; }
            }
            Text {
                text: @tr("" => "Запускается только одна копия Nimbus. Второй запуск ничего не откроет.");
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        // Accessibility
        if root.page == 10: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
            Anchor { key: 0; text: @tr("" => "Цвет и контраст"); }
            ToggleRow {
                text: @tr("" => "Повышенная контрастность");
                hint: @tr("" => "Светлее текст и заметнее границы.");
                on: Appearance.contrast;
                toggled(v) => { Appearance.contrast = v; root.appearance-changed(0); }
            }
            ToggleRow {
                text: @tr("" => "Мягкий свет на фоне");
                hint: @tr("" => "Добавляет за окном едва заметный серый свет сверху.");
                on: Appearance.glass;
                toggled(v) => { Appearance.glass = v; root.appearance-changed(0); }
            }
            Anchor { key: 1; text: @tr("" => "Пониженное движение"); }
            ToggleRow {
                text: @tr("" => "Уменьшить анимации");
                hint: @tr("" => "Без скольжения и плавных переходов в меню и на кнопках.");
                on: Appearance.reduce-motion;
                toggled(v) => { Appearance.reduce-motion = v; root.appearance-changed(0); }
            }
            Text {
                text: @tr("" => "Остальные настройки доступности хранятся в аккаунте Discord.");
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        // Language and time
        if root.page == 12: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
            Anchor { key: 0; text: @tr("" => "Язык"); }
            LanguagePicker {}
            Rectangle { height: 1px; background: Theme.line; }
            Anchor { key: 1; text: @tr("" => "Время и дата"); }
            SettingTitle { text: @tr("" => "Формат времени"); hint: @tr("" => "Применяется к сообщениям, открытым после выбора (открой канал заново)."); }
            Radio { text: @tr("" => "24 часа"); hint: "21:52"; on: !Appearance.time12; clicked => { Appearance.time12 = false; root.appearance-changed(0); } }
            Radio { text: @tr("" => "12 часов (AM/PM)"); hint: "9:52 PM"; on: Appearance.time12; clicked => { Appearance.time12 = true; root.appearance-changed(0); } }
            SettingTitle { text: @tr("" => "Формат даты"); }
            Radio { text: "29.10.2026"; hint: @tr("" => "День, месяц, год"); on: !Appearance.date-iso; clicked => { Appearance.date-iso = false; root.appearance-changed(0); } }
            Radio { text: "2026-10-29"; hint: @tr("" => "Год, месяц, день"); on: Appearance.date-iso; clicked => { Appearance.date-iso = true; root.appearance-changed(0); } }
        }
        // Customize
        if root.page == 20: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
            SettingTitle { text: @tr("" => "Анимация появления сообщений"); hint: @tr("" => "Как новое сообщение появляется в чате."); }
            Radio { text: @tr("" => "Сбоку"); hint: @tr("" => "Выезжает с левого края."); on: Appearance.message-anim == 0; clicked => { Appearance.message-anim = 0; root.appearance-changed(0); } }
            Radio { text: @tr("" => "Печатание"); hint: @tr("" => "Выезжает сбоку, затем текст печатается."); on: Appearance.message-anim == 1; clicked => { Appearance.message-anim = 1; root.appearance-changed(0); } }
            Radio { text: @tr("" => "Плавное появление и приближение"); hint: @tr("" => "Мягко проявляется и приближается."); on: Appearance.message-anim == 2; clicked => { Appearance.message-anim = 2; root.appearance-changed(0); } }
            if Appearance.reduce-motion: Text {
                text: @tr("" => "Анимация не показывается, пока включено пониженное движение.");
                color: Theme.text2;
                font-size: 14px;
                wrap: word-wrap;
            }
        }
        // About
        if root.page == 16: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
            Text { text: "Nimbus " + root.version; color: Theme.text; font-size: 20px; font-weight: 800; }
            HorizontalLayout {
                alignment: start;
                DialogButton {
                    text: @tr("" => "Что нового");
                    clicked => {
                        Appearance.changelog-open = true;
                        Appearance.updated-open = true;
                    }
                }
            }
            Text {
                text: @tr("" => "Неофициальный открытый клиент Discord. Не связан с Discord Inc. и не выдаёт себя за официальное приложение.");
                color: Theme.text2;
                font-size: 14px;
                wrap: word-wrap;
            }
            Text {
                text: @tr("" => "Показ экрана идёт через твой собственный сервер LiveKit, не через Nitro. Вход в голос Discord выполняется от твоего аккаунта на твой риск.");
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        if root.page == 6: PageScroll {
            x: root.nav-w;
            y: 61px;
            width: parent.width - root.nav-w;
            height: parent.height - 61px;
            side: root.side;
                Anchor { key: 0; text: @tr("" => "Голос"); }
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: @tr("" => "Микрофон"); color: Theme.text2; font-size: 12px; font-weight: 700; }
                        DevicePick {
                            title: @tr("" => "УСТРОЙСТВО ВВОДА");
                            devices: root.mics;
                            opening => { root.devices-requested(); }
                            picked(i) => { root.mic-picked(i); }
                        }
                        Text { text: @tr("" => "Громкость микрофона · ") + round(root.settings.mic-volume) + "%"; color: Theme.text2; font-size: 12px; font-weight: 700; }
                        Range {
                            minimum: 0;
                            maximum: 200;
                            value: root.settings.mic-volume;
                            changed(v) => {
                                root.settings.mic-volume = v;
                                root.apply();
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: @tr("" => "Динамик"); color: Theme.text2; font-size: 12px; font-weight: 700; }
                        DevicePick {
                            title: @tr("" => "УСТРОЙСТВО ВЫВОДА");
                            devices: root.speakers;
                            opening => { root.devices-requested(); }
                            picked(i) => { root.speaker-picked(i); }
                        }
                        Text { text: @tr("" => "Громкость динамика · ") + round(root.settings.speaker-volume) + "%"; color: Theme.text2; font-size: 12px; font-weight: 700; }
                        Range {
                            minimum: 0;
                            maximum: 200;
                            value: root.settings.speaker-volume;
                            changed(v) => {
                                root.settings.speaker-volume = v;
                                root.apply();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;
                    Rectangle {
                        width: test-label.preferred-width + 32px;
                        height: 38px;
                        border-radius: 6px;
                        background: root.testing ? (test-area.has-hover ? #d83c47 : #f04a55) : (test-area.has-hover ? Theme.accent-hover : Theme.accent);
                        test-area := TouchArea { mouse-cursor: pointer; clicked => { root.test(!root.testing); } }
                        test-label := Text { text: root.testing ? @tr("" => "Остановить проверку") : @tr("" => "Проверка микрофона"); color: Theme.on-accent; font-size: 14px; font-weight: 600; }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Range { level: root.meter; level-open: root.sending; value: 0; minimum: 0; maximum: 1; enabled: false; }
                    }
                }
                Text {
                    text: root.testing ? @tr("" => "Говори: услышишь себя. Пока идёт проверка, звонок тебя не слышит, а ты не слышишь звонок.") : @tr("" => "Проверка включает микрофон и проигрывает твой голос тебе же.");
                    color: Theme.muted;
                    font-size: 12.5px;
                }

                Rectangle { height: 1px; background: Theme.line; }

                SettingTitle { text: @tr("" => "Режим голоса"); hint: @tr("" => "В режиме рации микрофон открыт, только пока зажата клавиша. Клавиша работает и когда окно Nimbus не в фокусе."); }
                Radio {
                    text: @tr("" => "Активность голоса");
                    hint: @tr("" => "Микрофон открыт, когда слышит речь");
                    on: root.settings.voice-mode == 0;
                    clicked => {
                        root.settings.voice-mode = 0;
                        root.apply();
                    }
                }
                Radio {
                    text: @tr("" => "Рация (Push to talk)");
                    hint: @tr("" => "Говоришь, только пока держишь клавишу");
                    on: root.settings.voice-mode == 1;
                    clicked => {
                        root.settings.voice-mode = 1;
                        root.apply();
                    }
                }
                if root.settings.voice-mode == 1: VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 240px;
                            height: 40px;
                            border-radius: 8px;
                            background: Theme.surface2;
                            border-width: 1px;
                            border-color: root.capturing ? Theme.accent : Theme.line;
                            Text {
                                x: 14px;
                                width: parent.width - 28px;
                                height: parent.height;
                                vertical-alignment: center;
                                text: root.capturing ? @tr("" => "Нажмите клавишу…") : root.key-name;
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 700;
                            }
                            ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.capture-target = 0;
                                    root.capturing = true;
                                    keys.focus();
                                }
                            }
                        }
                        Text {
                            text: root.capturing ? @tr("" => "Esc отменяет") : @tr("" => "Нажми на поле, чтобы сменить");
                            color: Theme.muted;
                            font-size: 12.5px;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: @tr("" => "Ctrl добавляется сам, если его не было: иначе клавиша сработает при наборе текста.");
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                SettingTitle { text: @tr("" => "Быстрые клавиши"); hint: @tr("" => "Работают из любой программы. Delete или Backspace снимает клавишу. Без Ctrl/Shift/Alt добавляется Ctrl."); }
                for row in [{ t: @tr("" => "Выключить / включить микрофон"), n: 1 }, { t: @tr("" => "Заглушить / вернуть звук"), n: 2 }]: HorizontalLayout {
                    spacing: 12px;
                    Text { text: row.t; color: Theme.text2; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle {
                        width: 190px;
                        height: 36px;
                        border-radius: 8px;
                        background: Theme.surface2;
                        border-width: 1px;
                        border-color: root.capturing && root.capture-target == row.n ? Theme.accent : Theme.line;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: root.capturing && root.capture-target == row.n ? @tr("" => "Нажмите клавишу…") : (row.n == 1 ? root.mute-key-name : root.deafen-key-name);
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 700;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.capture-target = row.n;
                                root.capturing = true;
                                keys.focus();
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.line; }
                SettingTitle {
                    text: @tr("" => "Камера");
                    hint: @tr("" => "Включи камеру кнопкой в звонке. Nimbus отправит её в голос Discord в 720p и 30 кадров в секунду, если камера так умеет.");
                }
                DevicePick {
                    title: @tr("" => "КАМЕРА");
                    devices: root.cameras;
                    opening => { root.devices-requested(); }
                    picked(i) => { root.camera-picked(i); }
                }
                if root.cameras.length == 0: Text { text: @tr("" => "Камеры не найдены"); color: Theme.muted; font-size: 12.5px; }
                ToggleRow {
                    text: @tr("" => "Предпросмотр");
                    hint: @tr("" => "Показать здесь, что видит камера. Пока предпросмотр включён, камера работает.");
                    on: root.camera-preview-on;
                    toggled(v) => {
                        root.camera-preview-on = v;
                        root.camera-preview-toggled(v);
                    }
                }
                if root.camera-preview-on || root.camera-preview-error != "": HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: 384px;
                        height: 216px;
                        border-radius: 8px;
                        clip: true;
                        background: #000;
                        if root.camera-preview-on: Image { width: parent.width; height: parent.height; source: root.camera-preview-frame; image-fit: contain; }
                        if root.camera-preview-on && root.camera-preview-frame.width == 0 && root.camera-preview-error == "": Text {
                            text: @tr("" => "Включаю камеру…");
                            color: Theme.muted;
                            font-size: 13px;
                        }
                        if root.camera-preview-error != "": Text {
                            x: 16px;
                            width: parent.width - 32px;
                            text: root.camera-preview-error;
                            color: #f04a55;
                            font-size: 13px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.line; }
                Anchor { key: 1; text: @tr("" => "Стриминг"); }
                SettingTitle { text: @tr("" => "Качество показа экрана"); hint: @tr("" => "Так начинается новый показ экрана; то же стоит в меню показа."); }
                Text { text: @tr("" => "Разрешение"); color: Theme.text2; font-size: 12px; font-weight: 700; }
                Radio { text: @tr("" => "Как у источника"); on: root.share-height == 0; clicked => { root.share-height = 0; } }
                Radio { text: "720p"; on: root.share-height == 720; clicked => { root.share-height = 720; } }
                Radio { text: "1080p"; on: root.share-height == 1080; clicked => { root.share-height = 1080; } }
                Radio { text: "1440p"; on: root.share-height == 1440; clicked => { root.share-height = 1440; } }
                Text { text: @tr("" => "Кадров в секунду"); color: Theme.text2; font-size: 12px; font-weight: 700; }
                Radio { text: "15"; on: root.share-fps == 15; clicked => { root.share-fps = 15; } }
                Radio { text: "30"; on: root.share-fps == 30; clicked => { root.share-fps = 30; } }
                Radio { text: "60"; on: root.share-fps == 60; clicked => { root.share-fps = 60; } }
                Text { text: @tr("" => "Где показывать"); color: Theme.text2; font-size: 12px; font-weight: 700; }
                Radio { text: "Discord"; on: root.share-dest == 1; clicked => { root.share-dest = 1; } }
                Radio { text: @tr("" => "Комната Nimbus"); on: root.share-dest == 0; clicked => { root.share-dest = 0; } }
                Radio { text: @tr("" => "Оба"); on: root.share-dest == 2; clicked => { root.share-dest = 2; } }
                Text { text: @tr("" => "На Discord качество ограничено подпиской: без Nitro 720p, 30 к/с; Nitro Classic 1080p, 60 к/с."); color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                ToggleRow {
                    text: @tr("" => "Звук приложения");
                    hint: @tr("" => "Передавать звук показываемого окна или всего экрана.");
                    on: root.share-sound;
                    toggled(v) => { root.share-sound = v; }
                }
                Rectangle { height: 1px; background: Theme.line; }
                Anchor { key: 2; text: @tr("" => "Звуки"); }
                SettingTitle {
                    text: @tr("" => "Звуки звонка");
                    hint: @tr("" => "Вход и выход, мут и размут, приход и уход других. Свои звуки: положи WAV-файлы в папку со звуками, они заменят встроенные.");
                }
                Text { text: "join.wav · leave.wav · mute.wav · unmute.wav · user_join.wav · user_leave.wav"; color: Theme.muted; font-size: 12.5px; }
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: sounds-label.preferred-width + 32px;
                        height: 36px;
                        border-radius: 6px;
                        background: sounds-area.has-hover ? Theme.accent-hover : Theme.accent;
                        sounds-area := TouchArea { mouse-cursor: pointer; clicked => { root.open-sounds(); } }
                        sounds-label := Text { text: @tr("" => "Открыть папку со звуками"); color: Theme.on-accent; font-size: 14px; font-weight: 600; }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                Anchor { key: 3; text: @tr("" => "Расширенные"); }
                SettingTitle { text: @tr("" => "Профиль ввода"); }                Radio {
                    text: @tr("" => "Изоляция голоса");
                    hint: @tr("" => "Только твой голос: усиленное шумоподавление убирает всё остальное");
                    on: root.profile == 0;
                    clicked => {
                        root.custom-picked = false;
                        root.settings.noise = 2;
                        root.settings.echo = true;
                        root.settings.auto-gain = true;
                        root.settings.auto-threshold = true;
                        root.apply();
                    }
                }
                Radio {
                    text: @tr("" => "Студия");
                    hint: @tr("" => "Чистый звук: открытый микрофон без обработки");
                    on: root.profile == 1;
                    clicked => {
                        root.custom-picked = false;
                        root.settings.noise = 0;
                        root.settings.echo = false;
                        root.settings.auto-gain = false;
                        root.settings.auto-threshold = false;
                        root.settings.threshold = -100;
                        root.apply();
                    }
                }
                Radio {
                    text: @tr("" => "Пользовательский");
                    hint: @tr("" => "Все кнопки и переключатели ниже");
                    on: root.profile == 2;
                    clicked => { root.custom-picked = true; }
                }

                if root.profile == 2: VerticalLayout {
                    spacing: 18px;
                    ToggleRow {
                        text: @tr("" => "Автоматически определять чувствительность ввода");
                        hint: @tr("" => "Микрофон передаёт, только когда слышит речь. Выключи, чтобы задать порог вручную.");
                        on: root.settings.auto-threshold;
                        toggled(v) => {
                            root.settings.auto-threshold = v;
                            root.apply();
                        }
                    }
                    if !root.settings.auto-threshold: VerticalLayout {
                        spacing: 6px;
                        Text { text: @tr("" => "Порог: ") + round(root.settings.threshold) + @tr("" => " дБ. Что тише, не передаётся"); color: Theme.text2; font-size: 12px; font-weight: 700; }
                        Range {
                            minimum: -100;
                            maximum: 0;
                            value: root.settings.threshold;
                            level: root.meter;
                            level-open: root.sending;
                            changed(v) => {
                                root.settings.threshold = v;
                                root.apply();
                            }
                        }
                    }
                    if root.settings.auto-threshold: Range { level: root.meter; level-open: root.sending; value: 0; minimum: 0; maximum: 1; enabled: false; }

                    SettingTitle { text: @tr("" => "Шумоподавление"); hint: @tr("" => "Усиленное использует нейросеть RNNoise на этом компьютере и убирает клавиатуру, вентилятор и дыхание."); }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Chip { text: @tr("" => "Нет"); on: root.settings.noise == 0; clicked => { root.settings.noise = 0; root.apply(); } }
                        Chip { text: @tr("" => "Стандартное"); on: root.settings.noise == 1; clicked => { root.settings.noise = 1; root.apply(); } }
                        Chip { text: @tr("" => "Усиленное (RNNoise)"); on: root.settings.noise == 2; clicked => { root.settings.noise = 2; root.apply(); } }
                    }
                    if root.settings.noise == 2: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: @tr("" => "Сила подавления"); color: Theme.text2; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                        Chip { text: @tr("" => "Мягко"); on: root.settings.noise-strength <= 40; clicked => { root.settings.noise-strength = 40; root.apply(); } }
                        Chip { text: @tr("" => "Средне"); on: root.settings.noise-strength > 40 && root.settings.noise-strength < 100; clicked => { root.settings.noise-strength = 70; root.apply(); } }
                        Chip { text: @tr("" => "Максимум"); on: root.settings.noise-strength >= 100; clicked => { root.settings.noise-strength = 100; root.apply(); } }
                    }
                    ToggleRow {
                        text: @tr("" => "Эхоподавление");                        hint: @tr("" => "Убирает из микрофона звук твоих динамиков.");
                        on: root.settings.echo;
                        toggled(v) => {
                            root.settings.echo = v;
                            root.apply();
                        }
                    }
                    ToggleRow {
                        text: @tr("" => "Автоматическая регулировка усиления");
                        hint: @tr("" => "Выравнивает громкость: тихий голос громче, крик тише.");
                        on: root.settings.auto-gain;
                        toggled(v) => {
                            root.settings.auto-gain = v;
                            root.apply();
                        }
                    }
                }
        }
    }
}

// A line of a right-click menu; red ones act on someone else's account.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> checkable;
    // One choice of several: a round mark with a dot, not a box (with `checkable`).
    in property <bool> radio;
    in property <bool> checked;
    in property <bool> arrow;
    callback clicked;
    height: 32px;
    border-radius: 4px;
    background: ta.has-hover ? (root.danger ? #da373c : Theme.accent) : transparent;
    animate background { duration: Appearance.quick; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        x: 8px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.text;
        color: ta.has-hover ? (root.danger ? #ffffff : Theme.on-accent) : (root.danger ? #f23f43 : Theme.text2);
        font-size: 14px;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.checkable && root.radio: Rectangle {
        x: parent.width - 28px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: 2px;
        border-color: ta.has-hover ? #fff : (root.checked ? Theme.accent : Theme.text2);
        if root.checked: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: ta.has-hover ? #fff : Theme.accent; }
    }
    if root.checkable && !root.radio: Rectangle {
        x: parent.width - 28px;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border-width: root.checked ? 0px : 1.5px;
        border-color: ta.has-hover ? #fff : Theme.text2;
        background: root.checked ? (ta.has-hover ? #ffffff40 : Theme.accent) : transparent;
        if root.checked: Icon { width: 14px; height: 14px; commands: Icons.check; tint: Theme.on-accent; }
    }
    if root.arrow: Icon {
        x: parent.width - 28px;
        width: 16px;
        height: 16px;
        commands: Icons.chevron;
        tint: ta.has-hover ? #fff : Theme.text2;
    }
}

component MenuLine inherits Rectangle {
    height: 9px;
    Rectangle { x: 6px; width: parent.width - 12px; height: 1px; background: Theme.line; }
}

// Right-click on someone: everyone's actions, then a moderator's (only those
// our roles allow), then their id. What can't be undone is asked about first.
component UserMenu inherits PopupWindow {
    in-out property <UserMenuInfo> info;
    // The most of the window it may take; longer, it scrolls with the wheel.
    in property <length> most;
    // Opened by the "more" button of a card.
    in property <bool> from-card;
    callback action(string);
    callback volume(float);
    callback confirm(string);
    // A line that needs words: "nick" or "friend-nick".
    callback ask(string);
    // The note field was left (Enter, or it lost focus): its text.
    callback note-saved(string);
    close-policy: close-on-click-outside;
    width: 248px;
    height: min(body.preferred-height, root.most);
    property <bool> moving;
    property <bool> giving-roles;
    property <bool> inviting;
    property <bool> using-apps;
    property <bool> muting;
    property <bool> person: root.info.id != "";
    property <bool> other: root.person && !root.info.me;
    property <bool> in-dm-list: root.info.dm-channel != "";
    property <bool> moderator: root.info.can-mute || root.info.can-deafen || root.info.can-move || root.info.can-kick || root.info.can-ban;

    Rectangle {
        property <bool> menu-shown;
        init => { self.menu-shown = true; }
        opacity: self.menu-shown ? 1 : 0;
        animate opacity { duration: Appearance.quick; easing: ease-out; }
        background: Theme.popup;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.shadow;
        clip: true;
        Flickable {
        interactive: false;
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: root.width;
            padding: 6px;
            HorizontalLayout {
                padding-left: 8px;
                height: 30px;
                Text { text: root.info.name; color: Theme.text; font-size: 13px; font-weight: 700; vertical-alignment: center; overflow: elide; }
            }
            if root.in-dm-list: MenuItem {
                text: @tr("" => "Пометить как прочитанное");
                opacity: root.info.dm-unread ? 1 : 0.5;
                clicked => {
                    if (root.info.dm-unread) {
                        root.action("dm-read:" + root.info.dm-channel);
                        root.close();
                    }
                }
            }
            if root.in-dm-list: MenuItem {
                text: root.info.dm-pinned ? @tr("" => "Открепить") : @tr("" => "Закрепить");
                clicked => { root.action("dm-pin:" + root.info.dm-channel); root.close(); }
            }
            if root.in-dm-list: MenuItem {
                text: root.info.dm-favorite ? @tr("" => "Убрать из избранного") : @tr("" => "Добавить в избранное");
                clicked => { root.action("dm-fav:" + root.info.dm-channel); root.close(); }
            }
            if root.in-dm-list && root.person: MenuLine {}
            if root.person: MenuItem {
                text: @tr("" => "Профиль");
                clicked => { root.action("profile"); root.close(); }
            }
            if root.person && !root.in-dm-list: MenuItem {
                text: @tr("" => "Упомянуть");
                clicked => { root.action("mention"); root.close(); }
            }
            if root.other && !root.in-dm-list: MenuItem {
                text: @tr("" => "Написать сообщение");
                clicked => { root.action("dm"); root.close(); }
            }
            if root.other: MenuItem {
                text: @tr("" => "Начать звонок");
                clicked => { root.action("call"); root.close(); }
            }
            // Our note about them: only we see it. Saved when left, if it changed.
            if root.other: VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 4px;
                spacing: 4px;
                HorizontalLayout {
                    Text { text: @tr("" => "Заметка"); color: Theme.text2; font-size: 12px; font-weight: 700; horizontal-stretch: 1; }
                    Text {
                        text: root.info.note.character-count + "/256";
                        color: root.info.note.character-count > 256 ? #f23f43 : Theme.faint;
                        font-size: 11px;
                    }
                }
                Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: Theme.surface0;
                    clip: true;
                    border-width: 1px;
                    border-color: note-input.has-focus ? Theme.accent : transparent;
                    note-input := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        single-line: true;
                        vertical-alignment: center;
                        color: Theme.text;
                        font-size: 13px;
                        text: root.info.note;
                        edited => { root.info.note = self.text; }
                        accepted => { root.note-saved(self.text); }
                        changed has-focus => {
                            if (!self.has-focus) {
                                root.note-saved(self.text);
                            }
                        }
                    }
                    Text {
                        x: 8px;
                        height: parent.height;
                        vertical-alignment: center;
                        visible: note-input.text == "";
                        text: @tr("" => "Нажми, чтобы добавить заметку");
                        color: Theme.faint;
                        font-size: 13px;
                    }
                }
            }
            if root.other && root.info.friend: MenuItem {
                text: root.info.friend-nick != "" ? @tr("" => "Изменить никнейм друга") : @tr("" => "Добавить никнейм друга");
                clicked => { root.ask("friend-nick"); root.close(); }
            }
            if root.in-dm-list && root.person: MenuItem {
                text: @tr("" => "Закрыть ЛС");
                clicked => { root.action("dm-close:" + root.info.dm-channel); root.close(); }
            }
            if root.other && root.info.spotify-track != "": MenuLine {}
            if root.other && root.info.spotify-track != "": MenuItem {
                text: @tr("" => "Открыть в Spotify");
                clicked => { root.action("spotify:" + root.info.spotify-track); root.close(); }
            }
            if root.other && root.info.spotify-track != "": MenuItem {
                text: @tr("" => "Слушать вместе");
                clicked => { root.action("listen"); root.close(); }
            }
            if root.other && root.info.in-voice: MenuLine {}
            if root.other && root.info.in-voice: VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 4px;
                spacing: 4px;
                Text { text: @tr("" => "Громкость пользователя · ") + round(root.info.volume) + "%"; color: Theme.text2; font-size: 13px; }
                Range {
                    minimum: 0;
                    maximum: 200;
                    value: root.info.volume;
                    changed(v) => {
                        root.info.volume = v;
                        root.volume(v);
                    }
                }
            }
            if root.other && root.info.in-voice: MenuItem {
                text: @tr("" => "Заглушить");
                checkable: true;
                checked: root.info.volume == 0;
                clicked => {
                    root.info.volume = root.info.volume == 0 ? 100 : 0;
                    root.volume(root.info.volume);
                }
            }
            if root.other && root.info.in-voice: MenuItem {
                text: @tr("" => "Заглушить звуковую панель");
                checkable: true;
                checked: root.info.sound-muted;
                clicked => {
                    root.info.sound-muted = !root.info.sound-muted;
                    root.action("sound-mute");
                }
            }
            if root.other && root.info.in-voice: MenuItem {
                text: @tr("" => "Отключить видео");
                checkable: true;
                checked: root.info.video-hidden;
                clicked => {
                    root.info.video-hidden = !root.info.video-hidden;
                    root.action("video-hide");
                }
            }
            if root.person: MenuLine {}
            if root.info.can-code: MenuItem {
                text: @tr("" => "Просмотреть код подтверждения");
                clicked => { root.action("code"); root.close(); }
            }
            if root.info.can-nick: MenuItem {
                text: @tr("" => "Изменить никнейм");
                clicked => { root.ask("nick"); root.close(); }
            }
            if root.other && root.info.invite-guilds.length > 0: MenuItem {
                text: @tr("" => "Пригласить на сервер");
                arrow: true;
                clicked => { root.inviting = !root.inviting; }
            }
            if root.inviting: VerticalLayout {
                for g in root.info.invite-guilds: MenuItem {
                    text: "    " + g.name;
                    clicked => { root.action("invite:" + g.id); root.close(); }
                }
            }
            if root.person && root.info.apps.length > 0: MenuItem {
                text: @tr("" => "Приложения");
                arrow: true;
                clicked => { root.using-apps = !root.using-apps; }
            }
            if root.using-apps: VerticalLayout {
                for a in root.info.apps: MenuItem {
                    text: "    " + a.name;
                    clicked => { root.action("app:" + a.id); root.close(); }
                }
            }
            if root.other: MenuItem {
                text: root.info.friend ? @tr("" => "Удалить из друзей") : @tr("" => "Добавить в друзья");
                clicked => {
                    if (root.info.friend) {
                        root.confirm("friend-remove");
                    } else {
                        root.action("friend-add");
                    }
                    root.close();
                }
            }
            if root.other: MenuItem {
                text: root.info.ignored ? @tr("" => "Перестать игнорировать") : @tr("" => "Игнорировать");
                clicked => { root.action(root.info.ignored ? "unignore" : "ignore"); root.close(); }
            }
            if root.other: MenuItem {
                text: root.info.blocked ? @tr("" => "Разблокировать") : @tr("" => "Заблокировать");
                danger: !root.info.blocked;
                clicked => {
                    if (root.info.blocked) {
                        root.action("unblock");
                    } else {
                        root.confirm("block");
                    }
                    root.close();
                }
            }
            if root.info.can-roles && root.info.roles.length > 0: MenuLine {}
            if root.info.can-roles && root.info.roles.length > 0: MenuItem {
                text: @tr("" => "Роли");
                arrow: true;
                clicked => { root.giving-roles = !root.giving-roles; }
            }
            if root.giving-roles: VerticalLayout {
                for r in root.info.roles: MenuItem {
                    text: "    " + r.name;
                    checkable: true;
                    checked: r.has;
                    opacity: r.editable ? 1 : 0.5;
                    clicked => {
                        if (r.editable) {
                            root.action((r.has ? "role-remove:" : "role-add:") + r.id);
                        }
                    }
                }
            }
            if root.moderator || root.info.can-moderate: MenuLine {}
            if root.info.can-moderate: MenuItem {
                text: @tr("" => "Открыть с доступом модератора");
                clicked => { root.action("mod-view"); root.close(); }
            }
            if root.info.can-move && root.info.targets.length > 0: MenuItem {
                text: @tr("" => "Переместить в");
                arrow: true;
                clicked => { root.moving = !root.moving; }
            }
            if root.moving && root.info.can-move: VerticalLayout {
                for t in root.info.targets: MenuItem {
                    text: "    " + t.name;
                    clicked => {
                        root.action("move:" + t.id);
                        root.close();
                    }
                }
            }
            if root.info.can-mute: MenuItem {
                text: @tr("" => "Откл. микрофон на сервере");
                danger: true;
                checkable: true;
                checked: root.info.server-muted;
                clicked => {
                    root.action(root.info.server-muted ? "unmute" : "mute");
                    root.close();
                }
            }
            if root.info.can-deafen: MenuItem {
                text: @tr("" => "Сервер: откл. звук");
                danger: true;
                checkable: true;
                checked: root.info.server-deafened;
                clicked => {
                    root.action(root.info.server-deafened ? "undeafen" : "deafen");
                    root.close();
                }
            }
            if root.info.can-move: MenuItem {
                text: @tr("" => "Отключить");
                danger: true;
                clicked => {
                    root.action("disconnect");
                    root.close();
                }
            }
            if root.info.can-kick: MenuItem {
                text: @tr("" => "Выгнать ") + root.info.name;
                danger: true;
                clicked => {
                    root.confirm("kick");
                    root.close();
                }
            }
            if root.info.can-ban: MenuItem {
                text: @tr("" => "Забанить ") + root.info.name;
                danger: true;
                clicked => {
                    root.confirm("ban");
                    root.close();
                }
            }
            if root.in-dm-list: MenuLine {}
            if root.in-dm-list && root.info.dm-muted: MenuItem {
                text: @tr("" => "Включить уведомления");
                clicked => { root.action("dm-unmute:" + root.info.dm-channel); root.close(); }
            }
            if root.in-dm-list && !root.info.dm-muted: MenuItem {
                text: root.person ? @tr("" => "Заглушить ") + "@" + root.info.name : @tr("" => "Заглушить чат");
                arrow: true;
                clicked => { root.muting = !root.muting; }
            }
            if root.muting: VerticalLayout {
                for choice in [
                    { label: @tr("" => "На 15 минут"), minutes: ":15" },
                    { label: @tr("" => "На 1 час"), minutes: ":60" },
                    { label: @tr("" => "На 3 часа"), minutes: ":180" },
                    { label: @tr("" => "На 8 часов"), minutes: ":480" },
                    { label: @tr("" => "На 24 часа"), minutes: ":1440" },
                    { label: @tr("" => "Пока не включу снова"), minutes: "" },
                ]: MenuItem {
                    text: "    " + choice.label;
                    clicked => { root.action("dm-mute:" + root.info.dm-channel + choice.minutes); root.close(); }
                }
            }
            if root.in-dm-list && root.info.group: MenuItem {
                text: @tr("" => "Покинуть группу");
                danger: true;
                clicked => { root.action("dm-close:" + root.info.dm-channel); root.close(); }
            }
            MenuLine {}
            if root.from-card && root.person: MenuItem {
                text: @tr("" => "Поделиться профилем");
                clicked => { root.action("share-profile"); root.close(); }
            }
            if root.from-card && root.person: MenuItem {
                text: @tr("" => "Открыть магазин");
                clicked => { root.action("shop"); root.close(); }
            }
            if root.from-card && root.other: MenuItem {
                text: @tr("" => "Пожаловаться на профиль");
                danger: true;
                clicked => { root.action("report"); root.close(); }
            }
            if root.person: MenuItem {
                text: @tr("" => "Копировать ID пользователя");
                clicked => {
                    root.action("copy-id");
                    root.close();
                }
            }
            if root.in-dm-list: MenuItem {
                text: @tr("" => "Копировать ID канала");
                clicked => { root.action("copy-channel:" + root.info.dm-channel); root.close(); }
            }
        }
        }
    }
}

// Something told in full, to read or copy: a verification code, a moderator's view (with its time-outs).
component InfoDialog inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <bool> timeouts;
    // Seconds; 0 lifts the time-out.
    callback timeout(int);
    callback copy();
    callback closed();
    background: #000000b8;
    TouchArea { clicked => { root.closed(); } }
    Rectangle {
        y: (root.height - self.height) / 2;
        width: min(460px, root.width - 48px);
        height: info-body.preferred-height;
        border-radius: 10px;
        background: Theme.glass-strong;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        TouchArea {}
        info-body := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text { text: root.title; color: Theme.text; font-size: 18px; font-weight: 800; overflow: elide; }
            Text { text: root.text; color: Theme.text2; font-size: 14px; wrap: word-wrap; }
            if root.timeouts: Text { text: @tr("" => "Тайм-аут"); color: Theme.text; font-size: 13px; font-weight: 700; }
            if root.timeouts: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                DialogButton { text: @tr("" => "10 минут"); clicked => { root.timeout(600); } }
                DialogButton { text: @tr("" => "1 час"); clicked => { root.timeout(3600); } }
                DialogButton { text: @tr("" => "1 день"); clicked => { root.timeout(86400); } }
                DialogButton { text: @tr("" => "Снять"); clicked => { root.timeout(0); } }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                DialogButton { text: @tr("" => "Копировать"); clicked => { root.copy(); } }
                DialogButton { text: @tr("" => "Закрыть"); primary: true; clicked => { root.closed(); } }
            }
        }
    }
}

// After an update: black like the start window, with the mark. "What's new" turns it into the changelog, right here.
component UpdatedWindow inherits Rectangle {
    background: #000000b8;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            return reject;
        }
    }
    function close() {
        Appearance.updated-open = false;
        Appearance.changelog-open = false;
    }
    init => { keys.focus(); }
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        property <bool> shown;
        init => { self.shown = true; }
        opacity: self.shown ? 1 : 0;
        animate opacity, height { duration: Appearance.quick; easing: ease-out; }
        width: Appearance.changelog-open ? min(620px, root.width - 48px) : 340px;
        height: Appearance.changelog-open ? min(680px, root.height - 64px) : 360px;
        border-radius: 14px;
        background: #000000;
        border-width: 1px;
        border-color: #1c1c1c;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.shadow;
        clip: true;
        TouchArea {}
        if !Appearance.changelog-open: Rectangle {
            NimbusMark { x: (parent.width - self.width) / 2; y: 44px; width: 72px; height: 72px; ink: #ffffff; animated: !Appearance.reduce-motion; }
            Text { y: 132px; width: parent.width; horizontal-alignment: center; text: @tr("" => "Nimbus обновлён"); color: #ffffff; font-size: 20px; font-weight: 700; }
            Text { y: 166px; width: parent.width; horizontal-alignment: center; text: Appearance.nimbus-version; color: #a1a1a1; font-size: 13px; }
            Rectangle {
                x: 32px;
                y: 218px;
                width: parent.width - 64px;
                height: 42px;
                border-radius: 8px;
                background: news-area.has-hover ? #e4e4e4 : #ffffff;
                animate background { duration: Appearance.quick; }
                news-area := TouchArea { mouse-cursor: pointer; clicked => { Appearance.changelog-open = true; } }
                Text { text: @tr("" => "Что нового"); color: #000000; font-size: 14px; font-weight: 600; }
            }
            Rectangle {
                x: 32px;
                y: 270px;
                width: parent.width - 64px;
                height: 42px;
                border-radius: 8px;
                background: later-area.has-hover ? #1a1a1a : transparent;
                animate background { duration: Appearance.quick; }
                later-area := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
                Text { text: @tr("" => "Закрыть"); color: #a1a1a1; font-size: 14px; font-weight: 500; }
            }
        }
        if Appearance.changelog-open: Rectangle {
            NimbusMark { x: 24px; y: 22px; width: 24px; height: 24px; ink: #ffffff; }
            Text { x: 58px; y: 20px; height: 28px; text: @tr("" => "Что нового"); color: #ffffff; font-size: 18px; font-weight: 700; vertical-alignment: center; }
            Rectangle {
                x: parent.width - 44px;
                y: 16px;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: log-close.has-hover ? #1a1a1a : transparent;
                log-close := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
                Icon { x: 7px; y: 7px; width: 18px; height: 18px; commands: Icons.close; tint: #ffffff; }
            }
            Rectangle { y: 64px; height: 1px; background: #1c1c1c; }
            Flickable {
                x: 24px;
                y: 65px;
                width: parent.width - 48px;
                height: parent.height - 65px;
                interactive: false;
                content-height: log-body.preferred-height;
                log-body := VerticalLayout {
                    width: parent.width;
                    padding-top: 16px;
                    padding-bottom: 24px;
                    spacing: 8px;
                    for line in Appearance.changelog: HorizontalLayout {
                        padding-top: line.kind == 0 ? 14px : line.kind == 1 ? 10px : 0px;
                        spacing: 8px;
                        if line.kind == 2: Text { text: "•"; color: #a1a1a1; font-size: 14px; }
                        Text {
                            horizontal-stretch: 1;
                            text: line.text;
                            color: line.kind == 0 || line.kind == 1 ? #ffffff : #c8c8c8;
                            font-size: line.kind == 0 ? 20px : line.kind == 1 ? 15px : 14px;
                            font-weight: line.kind == 0 ? 800 : line.kind == 1 ? 700 : 400;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

// A line of words asked for on the spot: a nickname. Empty takes it away.
component PromptDialog inherits Rectangle {
    in property <string> title;
    in property <string> text;
    callback saved(string);
    callback cancelled();
    background: #000000b8;
    TouchArea { clicked => { root.cancelled(); } }
    Rectangle {
        y: (root.height - self.height) / 2;
        width: min(400px, root.width - 48px);
        height: 164px;
        border-radius: 10px;
        background: Theme.glass-strong;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        TouchArea {}
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text { text: root.title; color: Theme.text; font-size: 18px; font-weight: 800; overflow: elide; }
            Rectangle {
                height: 36px;
                border-radius: 6px;
                background: Theme.surface0;
                clip: true;
                prompt-input := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    single-line: true;
                    vertical-alignment: center;
                    color: Theme.text;
                    font-size: 14px;
                    text: root.text;
                    init => { self.focus(); }
                    accepted => { root.saved(self.text); }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                DialogButton { text: @tr("" => "Отмена"); clicked => { root.cancelled(); } }
                DialogButton { text: @tr("" => "Сохранить"); primary: true; clicked => { root.saved(prompt-input.text); } }
            }
        }
    }
}
// "Выгнать X?" / "Забанить X?" before it's done.
component ConfirmDialog inherits Rectangle {
    in property <string> action;
    in property <string> name;
    callback confirmed();
    callback cancelled();
    background: #000000b8;
    property <bool> shown;
    init => { self.shown = true; }
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: Appearance.quick; easing: ease-out; }
    TouchArea { clicked => { root.cancelled(); } }
    Rectangle {
        y: (root.height - self.height) / 2 + (root.shown ? 0px : 12px);
        animate y { duration: Appearance.quick; easing: ease-out; }
        width: min(440px, root.width - 48px);
        height: 196px;
        border-radius: 10px;
        background: Theme.glass-strong;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        TouchArea {}
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: root.action == "leave-server" ? @tr("" => "Покинуть ") + root.name + "?" : root.action == "block" ? @tr("" => "Заблокировать ") + root.name + "?" : root.action == "friend-remove" ? @tr("" => "Удалить из друзей ") + root.name + "?" : root.action == "voice-server" ? @tr("" => "Подключиться к голосовому серверу?") : root.action == "delete-message" ? @tr("" => "Удалить сообщение?") : root.action == "ban" ? @tr("" => "Забанить ") + root.name + "?" : @tr("" => "Выгнать ") + root.name + "?";
                color: Theme.text;
                font-size: 18px;
                font-weight: 800;
            }
            Text {
                vertical-stretch: 1;
                text: root.action == "leave-server" ? @tr("" => "Ты сможешь вернуться только по новому приглашению.")
                    : root.action == "block" ? @tr("" => "Вы не увидите сообщений этого человека, а он не сможет вам писать.")
                    : root.action == "friend-remove" ? @tr("" => "Этот человек исчезнет из списка друзей.")
                    : root.action == "voice-server" ? @tr("" => "Сообщество использует голос на ") + root.name + @tr("" => ". Тот, кто держит этот сервер, увидит твой IP-адрес. Подключайся, только если доверяешь ему. Ответ запомнится.")
                    : root.action == "delete-message" ? @tr("" => "Сообщение исчезнет у всех. Вернуть его нельзя.")
                    : root.action == "ban"
                    ? @tr("" => "Он не сможет вернуться на сервер, пока бан не снимут.")
                    : @tr("" => "Он сможет вернуться по новому приглашению.");
                color: Theme.text2;
                font-size: 14px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                Rectangle {
                    width: 100px;
                    height: 38px;
                    border-radius: 6px;
                    background: cancel-area.has-hover ? Theme.surface3 : transparent;
                    cancel-area := TouchArea { mouse-cursor: pointer; clicked => { root.cancelled(); } }
                    Text { text: @tr("" => "Отмена"); color: Theme.text; font-size: 14px; font-weight: 600; }
                }
                Rectangle {
                    width: ok-label.preferred-width + 32px;
                    height: 38px;
                    border-radius: 6px;
                    background: ok-area.has-hover ? #a12828 : #da373c;
                    ok-area := TouchArea { mouse-cursor: pointer; clicked => { root.confirmed(); } }
                    ok-label := Text { text: root.action == "leave-server" ? @tr("" => "Покинуть") : root.action == "block" ? @tr("" => "Заблокировать") : root.action == "friend-remove" ? @tr("" => "Удалить") : root.action == "voice-server" ? @tr("" => "Подключиться") : root.action == "delete-message" ? @tr("" => "Удалить") : root.action == "ban" ? @tr("" => "Забанить") : @tr("" => "Выгнать"); color: #fff; font-size: 14px; font-weight: 600; }
                }
            }
        }
    }
}

// Shown over everything when there is no saved sign-in.
component LoginScreen inherits Rectangle {
    in property <string> error;
    callback web-login();
    // Signed in: the form fades and the mark flies to its place in the title bar.
    in property <bool> closing;
    // The sign-in window is open: the button says so and the mark pulses.
    in-out property <bool> signing;
    background: Theme.surface2;
    property <bool> shown;
    init => { self.shown = true; }
    TouchArea {}
    HorizontalLayout {
        x: root.width - self.preferred-width - 16px;
        y: 48px;
        width: self.preferred-width;
        height: 44px;
        spacing: 4px;
        LanguagePicker { width: 240px; }
    }
    box := VerticalLayout {
        x: (root.width - self.width) / 2;
        y: max(84px, (root.height - self.preferred-height) / 2) + (root.shown ? 0px : 8px);
        width: min(380px, root.width - 32px);
        height: self.preferred-height;
        opacity: root.shown && !root.closing ? 1 : 0;
        spacing: 0;
        animate y { duration: Appearance.slow; easing: ease-out; }
        animate opacity { duration: Appearance.slow; easing: ease-out; }
        // The mark is drawn above the form, so it can leave it.
        Rectangle { height: 76px; }
        Text {
            text: @tr("" => "Вход в Discord");
            color: Theme.text;
            font-size: 28px;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Rectangle { height: 8px; }
        Text {
            text: @tr("" => "Войдите на странице Discord паролем или QR-кодом. Если появится капча, пройдите её.");
            color: Theme.text2;
            font-size: 14px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Rectangle { height: 24px; }
        Rectangle {
            height: 44px;
            border-radius: 10px;
            background: web-area.has-hover ? Theme.accent-hover : Theme.accent;
            animate background { duration: Appearance.quick; }
            web-area := TouchArea {
                mouse-cursor: root.signing ? default : pointer;
                clicked => {
                    if (!root.signing) {
                        root.signing = true;
                        root.web-login();
                    }
                }
            }
            Text { text: root.signing ? @tr("" => "Входим…") : @tr("" => "Войти через discord.com"); color: Theme.on-accent; font-size: 14px; font-weight: 600; }
        }
        if root.error != "": VerticalLayout {
            Rectangle { height: 12px; }
            Text {
                text: root.error;
                color: #f04a55;
                font-size: 13px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
        Rectangle { height: 24px; }
        Text {
            text: @tr("" => "Nimbus не связан с Discord Inc. Условия Discord запрещают сторонние клиенты, поэтому Discord может заблокировать аккаунт.");
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
    // Over the form while signing in; on its way to the title bar once signed in.
    property <duration> flight: Appearance.reduce-motion ? 0ms : 600ms;
    NimbusMark {
        x: root.closing ? 12px : (root.width - 64px) / 2;
        y: root.closing ? 8px : box.y;
        width: root.closing ? 16px : 64px;
        height: self.width;
        ink: Theme.text;
        animated: !Appearance.reduce-motion;
        opacity: root.signing && !root.closing && !Appearance.reduce-motion ? 0.55 + 0.45 * (sin(animation-tick() / 900ms * 360deg) + 1) / 2 : 1;
        animate x, y, width { duration: root.flight; easing: cubic-bezier(0.65, 0, 0.2, 1); }
    }
}

// A forum channel: its posts, newest activity first; a click opens the post.
component ForumView inherits Rectangle {
    property <bool> page-shown;
    init => { self.page-shown = true; }
    opacity: self.page-shown ? 1 : 0;
    animate opacity { duration: Appearance.slow; easing: ease-out; }
    in property <string> title;
    in property <[ForumPostItem]> posts;
    callback open(string);
    // "Новая публикация": the window for a title and a text.
    callback new-post();
    background: Theme.surface2;
    TouchArea {}

    Rectangle {
        height: 48px;
        y: 0;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            VerticalLayout { alignment: center; Icon { commands: Icons.chat; width: 22px; height: 22px; } }
            Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
            Text { text: root.posts.length + @tr("" => " публикаций"); color: Theme.muted; font-size: 12.5px; vertical-alignment: center; horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: new-post-label.preferred-width + 28px;
                    height: 32px;
                    border-radius: 6px;
                    background: new-post-area.has-hover ? Theme.accent-hover : Theme.accent;
                    new-post-area := TouchArea { mouse-cursor: pointer; clicked => { root.new-post(); } }
                    new-post-label := Text { text: @tr("" => "Новая публикация"); color: Theme.on-accent; font-size: 13.5px; font-weight: 600; }
                }
            }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    }

    ListView {
        y: 49px;
        height: root.height - 49px;
        for p in root.posts: Rectangle {
            height: 108px;
            Rectangle {
                x: 16px;
                y: 8px;
                width: parent.width - 32px;
                height: parent.height - 8px;
                border-radius: 8px;
                background: post-area.has-hover ? Theme.button-hover : Theme.button;
                border-width: 1px;
                border-color: Theme.line;
                post-area := TouchArea { mouse-cursor: pointer; clicked => { root.open(p.id); } }
                VerticalLayout {
                    x: 16px;
                    width: parent.width - 32px - (p.has-image ? 88px : 0px);
                    padding-top: 12px;
                    padding-bottom: 10px;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 6px;
                        if p.pinned: Text { text: "📌"; font-family: "Segoe UI Emoji"; font-size: 13px; vertical-alignment: center; }
                        Text { text: p.title; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        if p.author != "": Text { text: p.author; color: Theme.light ? #9a3fc2 : #e8a3ff; font-size: 12.5px; font-weight: 600; }
                        Text { text: p.preview; color: Theme.text2; font-size: 12.5px; overflow: elide; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        if p.reactions > 0: Rectangle {
                            height: 22px;
                            width: react-row.preferred-width + 12px;
                            border-radius: 6px;
                            background: Theme.surface3;
                            react-row := HorizontalLayout {
                                padding-left: 6px;
                                spacing: 4px;
                                Text { text: p.reaction; color: Theme.text; font-family: "Segoe UI Emoji"; font-size: 13px; vertical-alignment: center; }
                                Text { text: p.reactions; color: Theme.text2; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            }
                        }
                        Text { text: "💬 " + p.replies; color: Theme.text2; font-size: 12.5px; vertical-alignment: center; }
                        Text { text: p.when; color: Theme.muted; font-size: 12.5px; vertical-alignment: center; }
                    }
                }
                if p.has-image: Rectangle {
                    x: parent.width - 72px;
                    y: (parent.height - 56px) / 2;
                    width: 56px;
                    height: 56px;
                    border-radius: 8px;
                    clip: true;
                    Image { width: 56px; height: 56px; source: p.image; image-fit: cover; }
                }
            }
        }
    }
}

// One screen or window in the picker: its picture, its name under it.
component SourceCard inherits Rectangle {
    in property <ShareSourceItem> source;
    in property <int> place;
    callback clicked();
    height: 214px;
    Rectangle {
        height: 190px;
        border-radius: 8px;
        clip: true;
        background: #000;
        if root.source.has-thumb: Image {
            width: parent.width;
            height: parent.height;
            source: root.source.thumb;
            image-fit: contain;
        }
        if !root.source.has-thumb: Icon {
            commands: root.source.is-window ? Icons.window : Icons.screen;
            tint: Theme.faint;
            width: 32px;
            height: 32px;
        }
        Rectangle {
            border-radius: 8px;
            border-width: card-area.has-hover ? 2px : 0px;
            border-color: Theme.accent;
            background: card-area.has-hover ? Theme.hover : transparent;
        }
        card-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
    HorizontalLayout {
        y: 196px;
        height: 18px;
        spacing: 8px;
        Icon {
            commands: root.source.is-window ? Icons.window : Icons.screen;
            tint: Theme.text2;
            width: 16px;
            height: 16px;
        }
        Text {
            text: root.source.name;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// What to show, as in Discord: a window with tabs "Applications / Whole screen", a card for each, and
// the stream's quality at the bottom.
component SharePicker inherits Rectangle {
    in property <[ShareSourceItem]> sources;
    in property <int> monitor-count;
    in property <int> window-count;
    in-out property <int> out-height;
    in-out property <int> out-fps;
    in-out property <bool> out-sound;
    // Where to show: 0 the Nimbus room, 1 Discord, 2 both.
    in-out property <int> out-dest: 1;
    // 0 applications, 1 whole screen
    in-out property <int> tab: 0;
    callback picked(int);
    callback closed();
    background: #000000b8;
    TouchArea { clicked => { root.closed(); } }

    property <int> shown: root.tab == 0 ? root.window-count : root.monitor-count;
    // "Games", "Screen share" or "Custom", by what is chosen below.
    property <int> mode: (root.out-height == 1440 && root.out-fps == 60) ? 0 : ((root.out-height == 0 && root.out-fps == 15) ? 1 : 2);

    Rectangle {
        width: min(750px, root.width - 40px);
        height: min(590px, root.height - 40px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: 12px;
        background: Theme.light ? Theme.surface1 : #141416;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 30px;
        drop-shadow-color: Theme.shadow;
        TouchArea {}

        // Tabs
        Rectangle {
            x: 20px;
            y: 20px;
            width: parent.width - 40px;
            height: 40px;
            border-radius: 8px;
            background: Theme.light ? Theme.surface2 : #0b0b0c;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                for name[i] in [@tr("" => "Приложения"), @tr("" => "Весь экран")]: Rectangle {
                    border-radius: 6px;
                    background: root.tab == i ? (Theme.light ? Theme.surface3 : #26262b) : (tab-area.has-hover ? Theme.hover : transparent);
                    tab-area := TouchArea { mouse-cursor: pointer; clicked => { root.tab = i; } }
                    Text {
                        text: name;
                        color: root.tab == i ? Theme.text : Theme.muted;
                        font-size: 13px;
                        font-weight: 600;
                    }
                }
            }
        }

        // Cards
        Flickable {
            x: 20px;
            y: 76px;
            width: parent.width - 40px;
            height: parent.height - 76px - 96px;
            content-height: max(self.height, ceil(root.shown / 2) * 230px);
            if root.sources.length == 0: Text {
                text: @tr("" => "Ищу экраны и окна…");
                color: Theme.muted;
                font-size: 13px;
            }
            for s[i] in root.sources: SourceCard {
                // Windows come after the screens in the list; each tab counts its own.
                place: s.is-window ? i - root.monitor-count : i;
                visible: s.is-window == (root.tab == 0);
                x: mod(self.place, 2) * (parent.width / 2);
                y: floor(self.place / 2) * 230px;
                width: parent.width / 2 - 10px;
                source: s;
                clicked => { root.picked(i); }
            }
        }

        // Quality, as chosen now
        Rectangle { y: parent.height - 96px; height: 1px; background: Theme.line; }
        Text {
            x: 20px;
            y: parent.height - 78px;
            text: root.mode == 0 ? @tr("" => "Игры") : (root.mode == 1 ? @tr("" => "Демонстрация экрана") : @tr("" => "Пользовательские"));
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
        }
        Text {
            x: 20px;
            y: parent.height - 52px;
            width: parent.width - 100px;
            text: (root.out-height == 0 ? @tr("" => "Как у источника") : root.out-height + "p") + "  |  " + root.out-fps + @tr("" => " к/с") + "  |  "
                + (root.out-sound ? @tr("" => "Звук на стриме включён") : @tr("" => "Звук на стриме заглушён"));
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
        }
        Rectangle {
            x: parent.width - 56px;
            y: parent.height - 68px;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: Theme.light ? (gear-area.has-hover ? Theme.surface0 : Theme.surface3) : (gear-area.has-hover ? #2c2c32 : #1f1f24);
            gear-area := TouchArea { mouse-cursor: pointer; clicked => { options.show(); } }
            Icon { x: 8px; y: 8px; commands: Icons.gear; tint: Theme.text; }
        }
        options := PopupWindow {
            x: parent.width - 330px;
            y: parent.height - 96px - 382px;
            width: 310px;
            height: 374px;
            close-policy: close-on-click-outside;
            Rectangle {
                property <bool> menu-shown;
                init => { self.menu-shown = true; }
                opacity: self.menu-shown ? 1 : 0;
                animate opacity { duration: Appearance.quick; easing: ease-out; }
                background: Theme.light ? Theme.popup : #1c1c20;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 18px;
                drop-shadow-color: Theme.shadow;
                VerticalLayout {
                    padding: 10px;
                    spacing: 2px;
                    Text { text: @tr("" => "Режим стрима"); color: Theme.muted; font-size: 12px; height: 22px; }
                    for m[i] in [
                        { title: @tr("" => "Игры"), hint: @tr("" => "Более плавное видео (1440p, 60 к/с)") },
                        { title: @tr("" => "Демонстрация экрана"), hint: @tr("" => "Более чёткий текст (источник, 15 к/с)") },
                    ]: Rectangle {
                        height: 44px;
                        border-radius: 6px;
                        background: mode-area.has-hover ? Theme.hover : transparent;
                        mode-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.out-height = i == 0 ? 1440 : 0;
                                root.out-fps = i == 0 ? 60 : 15;
                            }
                        }
                        Text { x: 8px; y: 5px; text: m.title; color: Theme.text; font-size: 13px; font-weight: 600; }
                        Text { x: 8px; y: 24px; text: m.hint; color: Theme.muted; font-size: 11px; }
                        Rectangle {
                            x: parent.width - 30px;
                            y: 13px;
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            border-width: 2px;
                            border-color: root.mode == i ? Theme.accent : Theme.faint;
                            if root.mode == i: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                        }
                    }
                    Rectangle {
                        height: 30px;
                        Text { x: 8px; text: @tr("" => "Пользовательские"); color: root.mode == 2 ? Theme.text : Theme.muted; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                    }
                    Text { text: @tr("" => "Разрешение экрана"); color: Theme.muted; font-size: 12px; height: 22px; }
                    HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        alignment: start;
                        Chip { text: @tr("" => "Источник"); on: root.out-height == 0; clicked => { root.out-height = 0; } }
                        Chip { text: "720p"; on: root.out-height == 720; clicked => { root.out-height = 720; } }
                        Chip { text: "1080p"; on: root.out-height == 1080; clicked => { root.out-height = 1080; } }
                        Chip { text: "1440p"; on: root.out-height == 1440; clicked => { root.out-height = 1440; } }
                    }
                    Text { text: @tr("" => "Частота кадров"); color: Theme.muted; font-size: 12px; height: 22px; }
                    HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        alignment: start;
                        Chip { text: "15"; on: root.out-fps == 15; clicked => { root.out-fps = 15; } }
                        Chip { text: "30"; on: root.out-fps == 30; clicked => { root.out-fps = 30; } }
                        Chip { text: "60"; on: root.out-fps == 60; clicked => { root.out-fps = 60; } }
                    }
                    Text { text: @tr("" => "Где показывать"); color: Theme.muted; font-size: 12px; height: 22px; }
                    HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        alignment: start;
                        Chip { text: "Discord"; on: root.out-dest == 1; clicked => { root.out-dest = 1; } }
                        Chip { text: @tr("" => "Nimbus"); on: root.out-dest == 0; clicked => { root.out-dest = 0; } }
                        Chip { text: @tr("" => "Оба"); on: root.out-dest == 2; clicked => { root.out-dest = 2; } }
                    }
                    MenuItem {
                        text: @tr("" => "Передавать звук");
                        checkable: true;
                        checked: root.out-sound;
                        clicked => { root.out-sound = !root.out-sound; }
                    }
                }
            }
        }
    }
}

// Click on the share button while sharing: stop, change what is shown, the sound.
component StreamMenu inherits PopupWindow {
    in property <bool> watching;
    in property <string> watching-name;
    in property <bool> sound;
    callback stop-watching();
    callback stop();
    callback change();
    callback toggle-sound();
    close-policy: close-on-click-outside;
    width: 290px;
    height: body.preferred-height;
    Rectangle {
        property <bool> menu-shown;
        init => { self.menu-shown = true; }
        opacity: self.menu-shown ? 1 : 0;
        animate opacity { duration: Appearance.quick; easing: ease-out; }
        background: Theme.popup;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.shadow;
        body := VerticalLayout {
            padding: 6px;
            if root.watching: MenuItem {
                text: @tr("" => "Прекратить просмотр") + ": " + root.watching-name;
                danger: false;
                clicked => { root.stop-watching(); root.close(); }
            }
            MenuItem { text: @tr("" => "Прекратить стрим"); danger: true; clicked => { root.stop(); root.close(); } }
            MenuItem { text: @tr("" => "Изменить источник"); clicked => { root.change(); root.close(); } }
            MenuLine {}
            MenuItem {
                text: @tr("" => "Поделиться звуком стрима");
                checkable: true;
                checked: root.sound;
                clicked => { root.toggle-sound(); }
            }
        }
    }
}

// A person or a stream on the call screen.
component CallTileView inherits Rectangle {
    in property <CallTile> tile;
    // The stream on this tile is the one shown big; its live picture fills the tile.
    in property <bool> showing;
    in property <image> live;
    // With two streams on screen: a button that stops this one.
    in property <bool> closable;
    callback close();
    // Its sound is the one heard; the button moves it here, or switches it off.
    in property <bool> sound-on;
    callback toggle-sound();
    callback watch(string);
    // Click: bring this tile up big; double-click: full screen too.
    callback clicked();
    callback double-clicked();
    callback user-menu(string, length, length);
    border-radius: 10px;
    clip: true;
    background: root.tile.stream ? #000 : @linear-gradient(180deg, root.tile.tint.brighter(0.2) 0%, root.tile.tint.darker(0.3) 100%);

    property <length> face: min(root.height * 0.42, 96px);

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.user-menu(root.tile.identity, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    // Their camera fills the tile; the name and the speaking frame stay on top.
    if !root.tile.stream && root.tile.has-video: Image {
        width: root.width;
        height: root.height;
        source: root.tile.video;
        image-fit: cover;
    }

    if !root.tile.stream && !root.tile.has-video: Rectangle {
        width: root.face;
        height: root.face;
        Rectangle {
            border-radius: root.face / 2;
            clip: true;
            background: Theme.accent;
            if root.tile.has-avatar: Image { width: parent.width; height: parent.height; source: root.tile.avatar; image-fit: cover; }
            if !root.tile.has-avatar: Text { y: (parent.height - self.height) / 2 - self.font-size * 0.064; text: root.tile.initial; color: Theme.on-accent; font-size: root.face * 0.4; font-weight: 700; }
        }
        if root.tile.has-decoration: Image { x: -root.face * 0.125; y: -root.face * 0.125; width: root.face * 1.25; height: root.face * 1.25; source: root.tile.decoration; }
    }

    if root.tile.stream && root.showing && root.live.width > 0: Image {
        width: root.width;
        height: root.height;
        source: root.live;
        image-fit: contain;
    }
    if root.closable: Rectangle {
        x: root.width - self.width - 8px;
        y: 8px;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: tile-close.has-hover ? #000000d0 : #00000090;
        animate background { duration: Appearance.quick; }
        tile-close := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
        Icon { x: 6px; y: 6px; width: 18px; height: 18px; commands: Icons.close; tint: #ffffff; }
    }
    if root.closable && root.tile.quality != "" && root.width > 300px: Rectangle {
        x: root.width - self.width - 46px;
        y: 12px;
        width: tile-quality.preferred-width + 14px;
        height: 22px;
        border-radius: 5px;
        background: #000000b0;
        tile-quality := Text { text: root.tile.quality; color: #fff; font-size: 11px; font-weight: 800; }
    }
    // On a small tile, the corner by the name would cover it.
    if root.closable: Rectangle {
        x: root.width > 260px ? root.width - self.width - 8px : 8px;
        y: root.width > 260px ? root.height - self.height - 8px : 8px;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: tile-sound.has-hover ? #000000d0 : #00000090;
        animate background { duration: Appearance.quick; }
        tile-sound := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-sound(); } }
        Icon { x: 6px; y: 6px; width: 18px; height: 18px; commands: root.sound-on ? Icons.volume : Icons.volume-off; tint: #ffffff; }
    }

    if root.tile.stream && !(root.showing && root.live.width > 0) && root.tile.has-preview: Image {
        width: root.width;
        height: root.height;
        source: root.tile.preview;
        image-fit: cover;
        opacity: 0.55;
    }

    if root.tile.stream && !(root.showing && root.live.width > 0): Rectangle {
        width: watch-label.preferred-width + 28px;
        height: 36px;
        border-radius: 8px;
        background: root.showing ? Theme.surface3 : (watch-area.has-hover ? #4a4b55 : #3a3b44);
        watch-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.watch(root.tile.identity); }
        }
        watch-label := Text {
            text: root.showing ? @tr("" => "Смотрите сейчас") : @tr("" => "Смотреть стрим");
            color: root.showing ? Theme.strong : #fff;
            font-size: 14px;
            font-weight: 600;
        }
    }

    // Name, bottom left; LIVE on a stream, mic state on a person.
    Rectangle {
        x: 8px;
        y: root.height - self.height - 8px;
        height: 26px;
        width: name-row.preferred-width + 16px;
        border-radius: 6px;
        background: #000000a8;
        name-row := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            if root.tile.stream: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 34px;
                    height: 16px;
                    border-radius: 4px;
                    background: #f04a55;
                    Text { text: "LIVE"; color: #fff; font-size: 10px; font-weight: 800; }
                }
            }
            if !root.tile.stream && (root.tile.muted || root.tile.deafened): VerticalLayout {
                alignment: center;
                Icon {
                    width: 14px;
                    height: 14px;
                    commands: root.tile.deafened ? Icons.headphones-off : Icons.mic-off;
                    tint: #f04a55;
                }
            }
            Text { text: root.tile.name; color: #fff; font-size: 13px; font-weight: 600; vertical-alignment: center; }
            if root.tile.discord: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 14px;
                    border-radius: 3px;
                    background: #ffffff26;
                    Text { text: "DC"; color: #ffffffb0; font-size: 9px; font-weight: 800; }
                }
            }
        }
    }

    // Green frame while they talk, drawn last so nothing covers it.
    Rectangle {
        border-radius: 10px;
        border-width: root.tile.speaking && !root.tile.stream ? 3px : 0px;
        border-color: Theme.green;
    }
}

// A round button of the call screen's control bar.
component CallButton inherits Rectangle {
    in property <string> icon;
    in property <bool> off;
    in property <bool> danger;
    in property <bool> filled;
    in property <bool> on;
    callback clicked;
    width: root.danger ? 64px : 48px;
    height: 48px;
    border-radius: 24px;
    background: root.danger ? (ta.has-hover ? #d83c47 : #f04a55)
        : root.on ? Theme.accent
        : root.off ? (ta.has-hover ? #f04a5540 : #f04a5526)
        : (ta.has-hover ? (Theme.light ? #00000024 : #ffffff26) : (Theme.light ? #00000012 : #ffffff14));
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    if !root.filled: Icon {
        width: 24px;
        height: 24px;
        commands: root.icon;
        tint: root.off ? #f04a55 : root.on ? #fff : Theme.strong;
    }
    if root.filled: Path {
        width: 26px;
        height: 26px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: #fff;
    }
}

// The call screen: everyone in voice as tiles, a stream big on top when one
// is open, and the control bar.
component CallView inherits Rectangle {
    property <bool> page-shown;
    init => { self.page-shown = true; }
    opacity: self.page-shown ? 1 : 0;
    animate opacity { duration: Appearance.slow; easing: ease-out; }
    in property <string> title;
    in property <[CallTile]> tiles;
    in property <bool> watching;
    in property <string> watched;
    in property <string> stream-name;
    in property <image> stream-frame;
    // Every stream being watched plays on its tile; one is up on stage, or all share the grid.
    in-out property <bool> grid-view;
    callback focus-stream(string);
    callback stop-one(string);
    callback set-sound(string);
    // "1440P 60 КАДРОВ В СЕКУНДУ" once measured; empty before the first second.
    in property <string> stream-quality;
    in property <bool> muted;
    in property <bool> deafened;
    // Push to talk: the mic is shut while the key isn't held.
    in property <bool> ptt-open: true;
    in property <bool> sharing;
    // Our camera is on in the call.
    in property <bool> camera-on;
    // No screen sharing in this call (a DM call): the share button gives way to a hint.
    in property <bool> share-off;
    // The whole window is the call (no server list or channels).
    in property <bool> fullscreen;
    // The sound of the watched stream, in percent; changed(v) tells Rust.
    in-out property <float> stream-volume: 100;
    callback stream-volume-changed(float);
    callback watch(string);
    callback stop-watching();
    callback toggle-mic();
    callback toggle-deafen();
    callback share-clicked();
    callback toggle-camera();
    callback leave();
    callback toggle-fullscreen();
    callback user-menu(string, length, length);
    background: Theme.surface2;

    // A person brought up big (their identity); empty: the watched stream, if any, is.
    property <string> focus-person;
    property <bool> staged: (root.watching && !root.grid-view) || root.focus-person != "";

    // What a click on a tile does: a stream is watched (or brought back up),
    // a person goes up big, or back down when already there.
    function pick(t: CallTile) {
        if (t.stream) {
            root.focus-person = "";
            // A stream opens big. One being watched goes up at once, without connecting again; the others keep playing.
            root.grid-view = false;
            if (t.watched) {
                root.focus-stream(t.identity);
            } else {
                root.watch(t.identity);
            }
        } else {
            root.focus-person = root.focus-person == t.identity ? "" : t.identity;
        }
    }

    property <length> pad: 16px;
    property <length> gap: 8px;
    property <length> header: root.fullscreen ? 0px : 48px;
    property <length> bar: 80px;
    // A stream or person on top takes most of the room; tiles go in a strip below it.
    property <length> strip: root.staged ? 132px : 0px;
    property <length> stage-h: root.height - root.header - root.bar - root.strip - root.pad;
    // Tiles fill a grid in the space left for them, 16:9, centred row by row.
    property <int> n: root.tiles.length;
    property <int> cols: root.staged ? max(1, root.n) : (root.n <= 1 ? 1 : root.n <= 4 ? 2 : root.n <= 9 ? 3 : 4);
    property <int> rows: root.staged ? 1 : ceil(root.n / root.cols);
    property <length> area-w: root.width - 2 * root.pad;
    property <length> area-top: root.staged ? root.header + root.stage-h + root.pad / 2 : root.header;
    property <length> area-h: root.staged ? root.strip - root.pad / 2 : root.height - root.header - root.bar;
    property <length> tile-w: min((root.area-w - (root.cols - 1) * root.gap) / root.cols,
        ((root.area-h - (root.rows - 1) * root.gap) / max(1, root.rows)) * 16 / 9);
    property <length> tile-h: root.tile-w * 9 / 16;

    // Header: the channel.
    if !root.fullscreen: HorizontalLayout {
        y: 0;
        height: root.header;
        padding-left: 16px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { commands: Icons.volume; width: 22px; height: 22px; tint: Theme.text2; }
        }
        Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }

    // A person up big: their tile, stretched over the stage.
    if root.focus-person != "": Rectangle {
        x: root.pad;
        y: root.header;
        width: root.width - 2 * root.pad;
        height: root.stage-h;
        border-radius: 10px;
        clip: true;
        background: #000;
        for t in root.tiles: CallTileView {
            width: parent.width;
            height: parent.height;
            visible: !t.stream && t.identity == root.focus-person;
            tile: t;
            clicked => { root.focus-person = ""; }
            user-menu(id, x, y) => { root.user-menu(id, x, y); }
        }
        Rectangle {
            x: parent.width - self.width - 10px;
            y: 10px;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: person-close.has-hover ? #000000c0 : #00000080;
            person-close := TouchArea { clicked => { root.focus-person = ""; } }
            Icon { x: 6px; y: 6px; commands: Icons.close; tint: #fff; }
        }
    }

    if root.watching && root.focus-person == "" && !root.grid-view: Rectangle {
        x: root.pad;
        y: root.header;
        width: root.width - 2 * root.pad;
        height: root.stage-h;
        border-radius: 10px;
        clip: true;
        background: #000;
        // A click: back to everyone side by side, as in Discord.
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.grid-view = true; }
        }
        Image { width: parent.width; height: parent.height; source: root.stream-frame; image-fit: contain; }
        if root.stream-frame.width == 0: Text { text: @tr("" => "Жду видео…"); color: Theme.muted; font-size: 14px; }
        Rectangle {
            x: 10px;
            y: parent.height - self.height - 10px;
            height: 26px;
            width: stage-label.preferred-width + 16px;
            border-radius: 6px;
            background: #000000a8;
            stage-label := Text { text: root.stream-name; color: #fff; font-size: 13px; font-weight: 600; }
        }
        // Quality and LIVE, top right, as in Discord.
        Rectangle {
            x: parent.width - self.width - leave-label.preferred-width - 62px;
            y: 13px;
            height: 26px;
            width: quality-row.preferred-width;
            border-radius: 6px;
            clip: true;
            background: #000000b0;
            quality-row := HorizontalLayout {
                if root.stream-quality != "": HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text { text: root.stream-quality; color: #fff; font-size: 12px; font-weight: 800; vertical-alignment: center; }
                }
                Rectangle {
                    width: live-text.preferred-width + 16px;
                    background: #f04a55;
                    live-text := Text { text: @tr("" => "В ЭФИРЕ"); color: #fff; font-size: 12px; font-weight: 800; }
                }
            }
        }
        // Leave the stream: a labelled button, so it can't be missed.
        Rectangle {
            x: parent.width - self.width - 10px;
            y: 10px;
            width: leave-label.preferred-width + 44px;
            height: 32px;
            border-radius: 8px;
            background: stage-close.has-hover ? #f04a55 : #000000b0;
            stage-close := TouchArea { mouse-cursor: pointer; clicked => { root.stop-one(root.watched); } }
            Icon { x: 8px; y: 8px; width: 16px; height: 16px; commands: Icons.close; tint: #fff; }
            leave-label := Text { x: 30px; text: @tr("" => "Выйти"); color: #fff; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        }
        // The stream's sound: its own volume, kept for next time.
        Rectangle {
            x: parent.width - self.width - 10px;
            y: parent.height - self.height - 10px;
            width: 190px;
            height: 32px;
            border-radius: 8px;
            background: #000000b0;
            Icon { x: 8px; y: 8px; width: 16px; height: 16px; commands: Icons.volume; tint: #fff; }
            Range {
                x: 32px;
                width: parent.width - 44px;
                y: (parent.height - self.height) / 2;
                minimum: 0;
                maximum: 200;
                value: root.stream-volume;
                changed(v) => {
                    root.stream-volume = v;
                    root.stream-volume-changed(v);
                }
            }
        }
    }

    for t[i] in root.tiles: CallTileView {
        property <int> grid-row: floor(i / root.cols);
        property <int> grid-col: mod(i, root.cols);
        property <int> in-row: self.grid-row == root.rows - 1 ? root.n - (root.rows - 1) * root.cols : root.cols;
        tile: t;
        showing: t.stream && t.watched;
        live: t.video;
        closable: self.showing;
        close => { root.stop-one(t.identity); }
        sound-on: !t.sound-off;
        toggle-sound => { root.set-sound(t.identity); }
        width: root.tile-w;
        height: root.tile-h;
        x: root.pad + (root.area-w - (self.in-row * root.tile-w + (self.in-row - 1) * root.gap)) / 2 + self.grid-col * (root.tile-w + root.gap);
        y: root.area-top + (root.area-h - (root.rows * root.tile-h + (root.rows - 1) * root.gap)) / 2 + self.grid-row * (root.tile-h + root.gap);
        watch(identity) => {
            root.pick(t);
        }
        clicked => { root.pick(t); }
        user-menu(id, x, y) => { root.user-menu(id, x, y); }
    }

    // One stream up on stage, or all of them side by side.
    if root.watching: Rectangle {
        x: root.width - self.width - 68px;
        y: root.height - root.bar + (root.bar - self.height) / 2;
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: grid-area.has-hover ? (Theme.light ? #00000024 : #ffffff26) : (Theme.light ? #0000000f : #ffffff0f);
        grid-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.focus-person = "";
                root.grid-view = !root.grid-view;
            }
        }
        Icon { x: 9px; y: 9px; width: 22px; height: 22px; commands: Icons.grid; tint: Theme.strong; }
    }

    // Full screen, bottom right, as in Discord.
    Rectangle {
        x: root.width - self.width - 20px;
        y: root.height - root.bar + (root.bar - self.height) / 2;
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: full-area.has-hover ? (Theme.light ? #00000024 : #ffffff26) : (Theme.light ? #0000000f : #ffffff0f);
        full-area := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-fullscreen(); } }
        Icon { x: 9px; y: 9px; width: 22px; height: 22px; commands: root.fullscreen ? Icons.minimize : Icons.maximize; tint: Theme.strong; }
    }

    // Control bar.
    HorizontalLayout {
        y: root.height - root.bar;
        height: root.bar;
        alignment: center;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            CallButton { icon: root.muted || root.deafened || !root.ptt-open ? Icons.mic-off : Icons.mic; off: root.muted || root.deafened || !root.ptt-open; clicked => { root.toggle-mic(); } }
        }
        VerticalLayout {
            alignment: center;
            CallButton { icon: root.deafened ? Icons.headphones-off : Icons.headphones; off: root.deafened; clicked => { root.toggle-deafen(); } }
        }
        VerticalLayout {
            alignment: center;
            CallButton { icon: root.camera-on ? Icons.camera : Icons.camera-off; on: root.camera-on; clicked => { root.toggle-camera(); } }
        }
        if !root.share-off: VerticalLayout {
            alignment: center;
            CallButton { icon: Icons.screen; on: root.sharing; clicked => { root.share-clicked(); } }
        }
        // In a DM call there is no share button, and the bar says why.
        if root.share-off: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 48px;
                width: share-off-label.preferred-width + 28px;
                border-radius: 24px;
                background: Theme.hover;
                share-off-label := Text { text: @tr("" => "Показ экрана в звонках ЛС пока недоступен"); color: Theme.muted; font-size: 12.5px; vertical-alignment: center; horizontal-alignment: center; }
            }
        }
        VerticalLayout {
            alignment: center;
            CallButton { icon: Icons.hangup; danger: true; filled: true; clicked => { root.leave(); } }
        }
    }
}

// Discord's presence dot: online, idle, do not disturb, offline.
component StatusDot inherits Rectangle {
    in property <int> status;
    // The colour around the dot, so it sits cut into the avatar.
    in property <color> ring;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background: root.ring;
    Rectangle {
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: root.status == 1 ? #23a55a : root.status == 2 ? #f0b232 : root.status == 3 ? #f23f43 : #80848e;
        // Offline is a hollow ring, idle a crescent, do-not-disturb a bar, as in Discord.
        if root.status == 4: Rectangle { width: 4px; height: 4px; border-radius: 2px; background: root.ring; }
        if root.status == 2: Rectangle { x: -1px; y: -1px; width: 6px; height: 6px; border-radius: 3px; background: root.ring; }
        if root.status == 3: Rectangle { width: 6px; height: 2px; border-radius: 1px; background: root.ring; }
    }
}

// The right panel: groups and people, offline ones dimmed.
component MemberPanel inherits Rectangle {
    in property <[MemberItem]> members;
    callback user-card(string, length, length);
    callback user-menu(string, length, length);
    // Scrolled near the end: a big server has more people to load.
    callback near-end();
    background: Theme.pane1;
    Rectangle { x: 0; width: 1px; background: Theme.line; }
    ListView {
        x: 1px;
        width: parent.width - 1px;
        changed content-y => {
            if (self.content-y < self.visible-height - self.content-height + 500px) {
                root.near-end();
            }
        }
        for m in root.members: Rectangle {
            height: m.kind == 0 ? 36px : 44px;
            if m.kind == 0: Text {
                x: 16px;
                y: 14px;
                width: parent.width - 24px;
                text: m.name;
                color: Theme.muted;
                font-size: 12px;
                font-weight: 700;
                overflow: elide;
            }
            if m.kind == 1: Rectangle {
                x: 8px;
                y: 1px;
                width: parent.width - 16px;
                height: parent.height - 2px;
                border-radius: 6px;
                background: row-area.has-hover ? Theme.hover : transparent;
                opacity: m.status == 4 ? 0.45 : 1.0;
                clip: true;
                // The nameplate bought for the profile ("бейджик"), as Discord made it, behind the whole row.
                if m.has-plate: Image { width: parent.width; height: parent.height; source: m.plate; image-fit: fill; }
                row-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.user-card(m.id, self.absolute-position.x - 352px, self.absolute-position.y);
                    }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                            root.user-menu(m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            Rectangle {
                                border-radius: 16px;
                                clip: true;
                                background: Theme.surface3;
                                if m.has-avatar: Image { width: 32px; height: 32px; source: m.avatar; }
                            }
                            if m.has-decoration: Image { x: -4px; y: -4px; width: 40px; height: 40px; source: m.decoration; }
                            StatusDot { x: 20px; y: 20px; status: m.status; ring: Theme.surface1; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: m.name;
                            color: m.has-color ? m.color : Theme.text2;
                            font-size: 14.5px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        if m.subtitle != "": Text { text: m.subtitle; color: Theme.muted; font-size: 11.5px; overflow: elide; }
                    }
                }
            }
        }
    }
}

// Search results of the chat: who, where, the start of the text; a click opens the place.
component FoundPanel inherits Rectangle {
    in property <[FoundItem]> found;
    in property <int> total;
    in property <string> title;
    callback picked(string, string);
    callback close();
    background: Theme.glass-strong;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 20px;
    drop-shadow-color: Theme.shadow;
    clip: true;
    TouchArea {}
    Text {
        x: 14px;
        y: 0;
        height: 36px;
        text: root.title != "" ? root.title + ": " + root.total : root.total == 0 ? @tr("" => "Ничего не найдено") : @tr("" => "Найдено: ") + root.total;
        color: Theme.text2;
        font-size: 12.5px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Rectangle {
        x: parent.width - 36px;
        y: 4px;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: x-area.has-hover ? Theme.hover : transparent;
        x-area := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
        Icon { x: 5px; y: 5px; width: 18px; height: 18px; commands: Icons.close; tint: Theme.text2; }
    }
    ListView {
        y: 36px;
        height: parent.height - 36px;
        for f in root.found: Rectangle {
            height: 66px;
            background: f-area.has-hover ? Theme.hover : transparent;
            f-area := TouchArea { mouse-cursor: pointer; clicked => { root.picked(f.channel, f.message); } }
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 8px;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: f.author; color: Theme.text; font-size: 13.5px; font-weight: 700; }
                    Text { text: f.detail; color: Theme.muted; font-size: 11.5px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                }
                Text { text: f.text; color: Theme.body; font-size: 13.5px; overflow: elide; }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
    }
}

// "Find or start a conversation": a box over everything, results as you type.
component SearchOverlay inherits Rectangle {
    in property <[SearchItem]> results;
    in-out property <int> index;
    callback changed(string);
    callback picked(int);
    callback close();
    background: #000000a8;
    property <bool> shown;
    init => { self.shown = true; }
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: Appearance.quick; easing: ease-out; }

    // A click outside the box closes it.
    TouchArea { clicked => { root.close(); } }

    box := Rectangle {
        y: max(40px, root.height * 0.18);
        width: min(560px, root.width - 48px);
        height: 124px + max(1, min(10, root.results.length)) * 44px;
        border-radius: 10px;
        background: Theme.glass-strong;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        // Swallow clicks inside the box.
        TouchArea {}

        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            keys := FocusScope {
                height: 46px;
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.close();
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        root.index = min(root.index + 1, root.results.length - 1);
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.index = max(root.index - 1, 0);
                        return accept;
                    }
                    return reject;
                }
                Rectangle {
                    border-radius: 6px;
                    background: Theme.surface0;
                    query := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: parent.height;
                        single-line: true;
                        vertical-alignment: center;
                        color: Theme.text;
                        font-size: 17px;
                        edited => {
                            root.index = 0;
                            root.changed(self.text);
                        }
                        accepted => { root.picked(root.index); }
                        init => { self.focus(); }
                    }
                    if query.text == "": Text {
                        x: 14px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: @tr("" => "Куда отправимся?");
                        color: Theme.faint;
                        font-size: 17px;
                    }
                }
            }
            if root.results.length == 0: Text {
                height: 44px;
                text: query.text == "" ? @tr("" => "Начни вводить имя друга, переписки, сервера или канала") : @tr("" => "Ничего не нашлось");
                color: Theme.muted;
                font-size: 14px;
                vertical-alignment: center;
            }
            for r[i] in root.results: Rectangle {
                height: 44px;
                border-radius: 6px;
                background: i == root.index ? Theme.active : (row-area.has-hover ? Theme.hover : transparent);
                row-area := TouchArea { clicked => { root.picked(i); } }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        if r.kind == 3: Icon { width: 20px; height: 20px; commands: Icons.hash; tint: Theme.text2; }
                        if r.kind != 3: Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: r.kind == 2 ? 8px : 13px;
                            background: r.kind == 2 ? Theme.surface3 : Theme.accent;
                            Text { y: (parent.height - self.height) / 2 - self.font-size * 0.064; text: r.initial; color: r.kind == 2 ? Theme.strong : Theme.on-accent; font-size: 12px; font-weight: 700; }
                        }
                    }
                    Text { text: r.name; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                    Text { horizontal-stretch: 1; text: r.detail; color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; }
                    Text {
                        text: r.kind == 0 ? @tr("" => "ЛС") : r.kind == 1 ? @tr("" => "Друг") : r.kind == 2 ? @tr("" => "Сервер") : @tr("" => "Канал");
                        color: Theme.faint;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
            // The keys, small, at the bottom.
            Text {
                height: 22px;
                text: @tr("" => "↑ ↓ выбрать   ·   Enter открыть   ·   Esc закрыть   ·   имя друга, сервера или #канала");
                color: Theme.faint;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// The friends page (tabs: online, all, pending) or the message-requests page.
component PeopleView inherits Rectangle {
    property <bool> page-shown;
    init => { self.page-shown = true; }
    opacity: self.page-shown ? 1 : 0;
    animate opacity { duration: Appearance.slow; easing: ease-out; }
    in property <bool> friends-page;
    in-out property <int> tab;
    in property <[PersonItem]> people;
    callback user-menu(string, length, length);
    // What happened to the last friend request sent from the "add friend" tab.
    in property <string> add-result;
    callback open(string);
    callback accept(string);
    callback remove(string);
    callback tab-changed(int);
    callback add-friend(string);
    background: Theme.surface2;

    VerticalLayout {
        Rectangle {
            height: 48px;
            HorizontalLayout {
                padding-left: 16px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Icon { commands: root.friends-page ? Icons.friends : Icons.mail; width: 22px; height: 22px; tint: Theme.text2; }
                }
                Text {
                    text: root.friends-page ? @tr("" => "Друзья") : @tr("" => "Запросы общения");
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if root.friends-page: HorizontalLayout {
                    padding-left: 12px;
                    spacing: 6px;
                    alignment: start;
                    for label[i] in [@tr("" => "В сети"), @tr("" => "Все"), @tr("" => "Ожидание")]: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            width: tab-label.preferred-width + 20px;
                            border-radius: 6px;
                            background: root.tab == i ? Theme.active : (tab-area.has-hover ? Theme.hover : transparent);
                            tab-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.tab = i;
                                    root.tab-changed(i);
                                }
                            }
                            tab-label := Text { text: label; color: root.tab == i ? Theme.text : Theme.muted; font-size: 14px; font-weight: 600; }
                        }
                    }
                    // Discord's green "Add Friend" button; green text once it's the open tab.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            width: add-label.preferred-width + 20px;
                            border-radius: 6px;
                            background: root.tab == 3 ? transparent : (add-area.has-hover ? #1a8a4a : #248046);
                            add-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.tab = 3;
                                    root.tab-changed(3);
                                }
                            }
                            add-label := Text { text: @tr("" => "Добавить в друзья"); color: root.tab == 3 ? #2dc770 : #fff; font-size: 14px; font-weight: 600; }
                        }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        if root.friends-page && root.tab == 3: VerticalLayout {
            padding: 28px;
            spacing: 8px;
            vertical-stretch: 1;
            Text { text: @tr("" => "ДОБАВИТЬ В ДРУЗЬЯ"); color: Theme.text; font-size: 15px; font-weight: 700; }
            Text { text: @tr("" => "Вы можете добавить друзей по их имени пользователя в Discord."); color: Theme.muted; font-size: 14px; }
            Rectangle {
                height: 52px;
                border-radius: 8px;
                background: Theme.surface0;
                border-width: 1px;
                border-color: friend-input.has-focus ? #00a8fc : Theme.line;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        friend-input := TextInput {
                            width: parent.width;
                            height: parent.height;
                            single-line: true;
                            vertical-alignment: center;
                            color: Theme.text;
                            font-size: 15px;
                            accepted => { root.add-friend(self.text); }
                        }
                        if friend-input.text == "": Text {
                            x: 0;
                            width: parent.width;
                            height: parent.height;
                            vertical-alignment: center;
                            text: @tr("" => "Имя пользователя");
                            color: Theme.faint;
                            font-size: 15px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 34px;
                            width: send-label.preferred-width + 24px;
                            border-radius: 6px;
                            background: friend-input.text == "" ? Theme.button : (send-area.has-hover ? Theme.accent-hover : Theme.accent);
                            send-area := TouchArea {
                                enabled: friend-input.text != "";
                                mouse-cursor: pointer;
                                clicked => { root.add-friend(friend-input.text); }
                            }
                            send-label := Text { text: @tr("" => "Отправить запрос дружбы"); color: Theme.on-accent; font-size: 13.5px; font-weight: 600; }
                        }
                    }
                }
            }
            if root.add-result != "": Text {
                text: root.add-result;
                color: Theme.text2;
                font-size: 14px;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
        }
        if !(root.friends-page && root.tab == 3): HorizontalLayout {
            padding-left: 28px;
            padding-top: 16px;
            padding-bottom: 8px;
            Text {
                text: (root.friends-page ? (root.tab == 0 ? @tr("" => "В СЕТИ") : root.tab == 1 ? @tr("" => "ВСЕ ДРУЗЬЯ") : @tr("" => "ОЖИДАНИЕ")) : @tr("" => "ЗАПРОСЫ")) + " — " + root.people.length;
                color: Theme.muted;
                font-size: 11px;
                font-weight: 700;
            }
        }
        if root.people.length == 0 && !(root.friends-page && root.tab == 3): Rectangle {
            vertical-stretch: 1;
            Text {
                text: root.friends-page ? (root.tab == 2 ? @tr("" => "Заявок в друзья нет") : @tr("" => "Здесь пока никого")) : @tr("" => "Новых запросов нет");
                color: Theme.faint;
                font-size: 14px;
            }
        }
        if root.people.length > 0 && !(root.friends-page && root.tab == 3): ListView {
            vertical-stretch: 1;
            for p in root.people: Rectangle {
                height: 62px;
                // Hairline between people, at the top of each row (not through it).
                Rectangle {
                    x: 20px;
                    y: 0;
                    width: parent.width - 40px;
                    height: 1px;
                    background: Theme.line;
                }
                Rectangle {
                    x: 12px;
                    y: 1px;
                    width: parent.width - 24px;
                    height: parent.height - 2px;
                    border-radius: 8px;
                    background: row-area.has-hover ? Theme.hover : transparent;
                    row-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open(p.id); }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                root.user-menu(p.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                Rectangle {
                                    border-radius: 18px;
                                    clip: true;
                                    background: Theme.accent;
                                    if p.has-avatar: Image { width: 36px; height: 36px; source: p.avatar; image-fit: cover; }
                                    if !p.has-avatar: Text { y: (parent.height - self.height) / 2 - self.font-size * 0.064; text: p.initial; color: Theme.on-accent; font-size: 15px; font-weight: 700; }
                                }
                                if p.status > 0: StatusDot { x: 23px; y: 23px; status: p.status; ring: Theme.surface2; }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text { text: p.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                            Text {
                                text: p.kind == 1 ? @tr("" => "Входящая заявка в друзья") : p.kind == 2 ? @tr("" => "Исходящая заявка в друзья") : p.subtitle;
                                color: Theme.muted;
                                font-size: 12.5px;
                                overflow: elide;
                            }
                        }
                        // Round actions on the right, as in Discord.
                        if p.kind == 1: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 18px;
                                background: accept-area.has-hover ? Theme.green : Theme.surface0;
                                accept-area := TouchArea { mouse-cursor: pointer; clicked => { root.accept(p.id); } }
                                Icon { width: 20px; height: 20px; commands: Icons.check; tint: accept-area.has-hover ? #fff : Theme.green; }
                            }
                        }
                        if p.kind == 0 || p.kind == 3: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 18px;
                                background: Theme.surface0;
                                Icon { width: 20px; height: 20px; commands: Icons.chat; tint: row-area.has-hover ? Theme.text : Theme.text2; }
                            }
                        }
                        if p.kind == 1 || p.kind == 2: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 18px;
                                background: remove-area.has-hover ? #f23f43 : Theme.surface0;
                                remove-area := TouchArea { mouse-cursor: pointer; clicked => { root.remove(p.id); } }
                                Icon { width: 20px; height: 20px; commands: Icons.close; tint: remove-area.has-hover ? #fff : Theme.text2; }
                            }
                        }
                    }
                }
            }
        }
    }
}

component VoiceMemberRow inherits Rectangle {
    in property <VoiceMember> member;
    // Clicking someone who streams opens their stream.
    callback watch(string);
    // Right-click: their menu, at that point of the window.
    callback user-menu(string, length, length);
    height: 30px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.hover : transparent;

    // Discord's own streams open only under the channel we're in (Discord
    // lets just people in the call watch); the row decides via `can-watch`.
    in property <bool> can-watch: true;
    property <bool> watchable: root.member.streaming && root.can-watch;

    ta := TouchArea {
        mouse-cursor: root.watchable ? pointer : default;
        clicked => {
            if (root.watchable) {
                root.watch(root.member.identity);
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.user-menu(root.member.identity, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                Rectangle {
                    border-radius: 11px;
                    clip: true;
                    background: root.member.discord ? Theme.surface3 : Theme.accent;
                    if root.member.has-avatar: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.member.avatar;
                        image-fit: cover;
                        // Discord-only people stay a little dimmer, like their names.
                        opacity: root.member.discord ? 0.75 : 1.0;
                    }
                    if !root.member.has-avatar: Text { y: (parent.height - self.height) / 2 - self.font-size * 0.064; text: root.member.initial; color: root.member.discord ? Theme.strong : Theme.on-accent; font-size: 11px; font-weight: 700; }
                }
                // Drawn on top so the speaking ring isn't clipped away.
                Rectangle {
                    border-radius: 11px;
                    border-width: root.member.speaking ? 2px : 0px;
                    border-color: Theme.green;
                }
                if root.member.has-decoration: Image { x: -3px; y: -3px; width: 28px; height: 28px; source: root.member.decoration; }
            }
        }
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: root.member.name;
            color: root.member.discord ? Theme.muted : Theme.text2;
            font-size: 14px;
            overflow: elide;
        }
        if root.member.discord: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 14px;
                border-radius: 3px;
                background: Theme.surface3;
                Text { text: "DC"; color: Theme.muted; font-size: 9px; font-weight: 800; }
            }
        }
        if root.member.streaming: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 16px;
                border-radius: 4px;
                background: root.member.discord ? (Theme.light ? #e8737c : #f04a5566) : #f04a55;
                Text { text: "LIVE"; color: #fff; font-size: 10px; font-weight: 800; }
            }
        }
        if root.member.muted || root.member.deafened: VerticalLayout {
            alignment: center;
            Icon {
                width: 16px;
                height: 16px;
                commands: root.member.deafened ? Icons.headphones-off : Icons.mic-off;
                tint: #f04a55;
            }
        }
    }
}

// A channel in the sidebar. A voice channel you're in also lists who's there.
component ChannelRow inherits VerticalLayout {
    in property <ChannelItem> item;
    in property <bool> selected;
    in property <bool> connected;
    in property <[VoiceMember]> members;
    callback clicked;
    callback watch(string);
    callback user-menu(string, length, length);
    // Right-click on a server's text channel: its notification menu.
    callback menu(length, length);
    // Under a folded category only what you are in, or what is new, stays.
    property <bool> hidden: root.item.folded && root.item.kind != 2 && !root.selected && !root.connected && !root.item.unread && root.item.badge == 0;

    Rectangle {
    opacity: root.hidden ? 0 : 1;
    clip: root.hidden;
    animate opacity, height { duration: Appearance.quick; easing: ease-out; }
    height: root.hidden ? 0px : root.item.kind == 2 ? 38px : root.item.has-avatar ? 44px : root.item.kind == 3 ? 42px : 34px;

    ta := TouchArea {
        enabled: root.item.clickable;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up && root.item.kind == 0) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    if root.item.kind == 2: Text {
        x: 8px;
        y: parent.height - self.height - 5px;
        width: parent.width - 32px;
        text: root.item.name;
        color: ta.has-hover ? Theme.text2 : Theme.muted;
        font-size: 12px;
        font-weight: 600;
        overflow: elide;
    }

    if root.item.kind == 2: Icon { x: parent.width - 22px; y: parent.height - 20px; width: 12px; height: 12px; stroke-width: 2.4px; commands: root.item.folded ? Icons.chevron-right : Icons.chevron; tint: Theme.muted; }

    // Unread: a small white pill at the very left, as in Discord.
    if root.item.unread && !root.selected && !root.item.muted: Rectangle {
        x: -10px;
        width: 4px;
        height: 8px;
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
        background: Theme.text;
    }

    if root.item.kind != 2: Rectangle {
        y: 1px;
        height: parent.height - 2px;
        border-radius: 8px;
        background: root.selected ? Theme.selected : (ta.has-hover && root.item.clickable ? Theme.hover : transparent);
        animate background { duration: Appearance.quick; }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: root.item.has-avatar ? 12px : 6px;

            if root.item.has-avatar: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    Rectangle {
                        border-radius: 16px;
                        clip: true;
                        background: Theme.surface3;
                        Image { width: 32px; height: 32px; source: root.item.avatar; }
                    }
                    if root.item.status > 0: StatusDot { x: 20px; y: 20px; status: root.item.status; ring: Theme.surface1; }
                }
            }
            if !root.item.has-avatar: VerticalLayout {
                alignment: center;
                Icon {
                    commands: root.item.kind == 3 ? (root.item.id == "friends" ? Icons.friends : Icons.mail)
                        : root.item.kind == 1 ? Icons.volume : Icons.hash;
                    tint: root.connected ? Theme.green : (root.selected ? Theme.text2 : Theme.muted);
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.item.name;
                    font-size: 16px;
                    font-weight: root.item.unread && !root.selected && !root.item.muted ? 600 : 500;
                    overflow: elide;
                    // Muted: dimmed, as in Discord, whatever is new there.
                    color: root.selected || root.connected ? Theme.text
                        : root.item.muted ? (ta.has-hover ? Theme.muted : Theme.faint)
                        : root.item.unread ? Theme.text : (root.item.has-avatar || (ta.has-hover && root.item.clickable) ? Theme.text2 : Theme.muted);
                }
                if root.item.subtitle != "": Text {
                    text: root.item.subtitle;
                    font-size: 11.5px;
                    overflow: elide;
                    color: Theme.faint;
                }
            }
            if root.item.badge > 0: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: max(18px, badge-text.preferred-width + 10px);
                    height: 18px;
                    border-radius: 9px;
                    background: #f23f43;
                    badge-text := Text { text: root.item.badge; color: #fff; font-size: 11px; font-weight: 800; }
                }
            }
        }
    }
    }

    // People in Discord's own voice first, then (if we're in) the Nimbus room.
    if !root.hidden && root.item.kind == 1 && (root.connected || root.item.people.length > 0): VerticalLayout {
        padding-left: 28px;
        padding-bottom: 4px;
        for p in root.item.people: VoiceMemberRow {
            member: p;
            can-watch: root.connected;
            watch(identity) => { root.watch(identity); }
            user-menu(id, x, y) => { root.user-menu(id, x, y); }
        }
        if root.connected: VerticalLayout {
            for m in root.members: VoiceMemberRow {
                member: m;
                watch(identity) => { root.watch(identity); }
                user-menu(id, x, y) => { root.user-menu(id, x, y); }
            }
        }
    }
}

component BlockView inherits VerticalLayout {
    in property <Block> block;
    in property <bool> system;
    in-out property <bool> revealed;
    callback open-link(string);

    if root.block.kind == 0: StyledText {
        text: root.block.styled;
        default-color: root.system ? Theme.muted : Theme.body;
        default-font-size: 16px * Appearance.scale;
        link-color: Theme.link;
        link-clicked(link) => { root.open-link(link); }
    }
    if root.block.kind == 1: Rectangle {
        background: Theme.card;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.line;
        VerticalLayout {
            padding: 8px;
            Text {
                text: root.block.text;
                font-family: "Cascadia Mono";
                font-size: 14px * Appearance.scale;
                color: Theme.body;
                wrap: word-wrap;
            }
        }
    }
    if root.block.kind == 2: HorizontalLayout {
        spacing: 10px;
        Rectangle { width: 4px; border-radius: 2px; background: Theme.light ? #c4c7cd : #4e5058; }
        StyledText {
            horizontal-stretch: 1;
            text: root.block.styled;
            default-color: Theme.body;
            default-font-size: 16px * Appearance.scale;
            link-color: Theme.link;
            link-clicked(link) => { root.open-link(link); }
        }
    }
    if root.block.kind == 3: Text {
        text: root.block.text;
        color: Theme.text;
        font-size: 20px;
        font-weight: 700;
        wrap: word-wrap;
    }
    if root.block.kind == 4: HorizontalLayout {
        alignment: start;
        Text {
            text: root.block.text;
            color: link-area.has-hover ? Theme.link-hover : Theme.link;
            font-size: 16px * Appearance.scale;
            overflow: elide;
            link-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-link(root.block.url); }
            }
        }
    }
    if root.block.kind == 5: HorizontalLayout {
        alignment: start;
        Rectangle {
            border-radius: 4px;
            background: root.revealed ? Theme.hover : (Theme.light ? #c4c7cd : #2b2c33);
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                Text {
                    text: root.block.text;
                    color: root.revealed ? Theme.body : transparent;
                    font-size: 16px * Appearance.scale;
                    wrap: word-wrap;
                }
            }
            TouchArea {
                mouse-cursor: root.revealed ? default : pointer;
                clicked => { root.revealed = true; }
            }
        }
    }
}

component ReactionChip inherits Rectangle {
    in property <ReactionItem> reaction;
    callback clicked();
    height: 26px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.reaction.me ? Theme.accent : (area.has-hover ? Theme.wash-hover : transparent);
    background: root.reaction.me ? Theme.accent.with-alpha(0.3) : (Appearance.glass ? Theme.wash : Theme.surface3);
    drop-shadow-blur: root.reaction.me ? 8px : 0px;
    drop-shadow-color: Theme.glow;
    animate background, border-color { duration: Appearance.quick; }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 9px;
        spacing: 6px;
        if root.reaction.has-image: VerticalLayout {
            alignment: center;
            Image { width: 18px; height: 18px; source: root.reaction.image; }
        }
        if !root.reaction.has-image: Text {
            text: root.reaction.text;
            color: Theme.text;
            font-family: "Segoe UI Emoji";
            font-size: 15px;
            vertical-alignment: center;
        }
        Text {
            text: root.reaction.count;
            color: root.reaction.me ? Theme.text : Theme.text2;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component CardView inherits Rectangle {
    in property <CardItem> card;
    callback open-link(string);
    height: card-body.preferred-height;
    border-radius: 4px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    area := TouchArea {
        mouse-cursor: root.card.url != "" ? pointer : default;
        clicked => {
            if (root.card.url != "") {
                root.open-link(root.card.url);
            }
        }
    }
    Rectangle { x: 0; width: 4px; background: root.card.has-color ? root.card.color : (root.card.kind == 0 ? Theme.accent : Theme.faint); }
    card-body := VerticalLayout {
        padding-left: 16px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            if root.card.kind == 0: Text { text: "📎"; font-family: "Segoe UI Emoji"; font-size: 15px; vertical-alignment: center; }
            Text {
                horizontal-stretch: 1;
                text: root.card.title;
                color: area.has-hover ? Theme.link-hover : Theme.link;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            if root.card.kind == 0: Text { text: root.card.text + @tr("" => "  ·  скачать"); color: Theme.muted; font-size: 12px; vertical-alignment: center; }
        }
        if root.card.kind == 1 && root.card.text != "": Text { text: root.card.text; color: Theme.text2; font-size: 13px; wrap: word-wrap; }
    }
}

// A poll: its question, its answers with how the votes stand; a click on an answer votes.
component PollView inherits Rectangle {
    in property <PollItem> poll;
    callback vote(int);
    width: 440px;
    height: poll-body.preferred-height;
    border-radius: 8px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;

    poll-body := VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text { text: root.poll.question; color: Theme.text; font-size: 16px; font-weight: 700; wrap: word-wrap; }
        Text {
            text: root.poll.ended ? @tr("" => "Опрос завершён") : (root.poll.multi ? @tr("" => "Можно выбрать несколько ответов") : @tr("" => "Выбери один ответ"));
            color: Theme.muted;
            font-size: 12px;
        }
        for a in root.poll.answers: Rectangle {
            height: 40px;
            border-radius: 6px;
            clip: true;
            background: Theme.surface3;
            border-width: 1px;
            border-color: a.me ? Theme.accent : (answer-area.has-hover && !root.poll.ended ? Theme.wash-hover : transparent);
            // How the votes stand, behind the answer.
            if root.poll.has-results: Rectangle {
                x: 0;
                width: parent.width * a.share;
                background: a.me ? Theme.accent.with-alpha(0.25) : Theme.wash;
            }
            answer-area := TouchArea {
                mouse-cursor: root.poll.ended ? default : pointer;
                clicked => {
                    if (!root.poll.ended) {
                        root.vote(a.id);
                    }
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                if a.emoji.has-image: VerticalLayout {
                    alignment: center;
                    Image { width: 20px; height: 20px; source: a.emoji.image; }
                }
                if !a.emoji.has-image && a.emoji.text != "": Text { text: a.emoji.text; color: Theme.text; font-family: "Segoe UI Emoji"; font-size: 16px; vertical-alignment: center; }
                Text { horizontal-stretch: 1; text: a.text; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                if a.me: Text { text: "✓"; color: Theme.accent; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                if root.poll.has-results: Text { text: a.count + " · " + round(a.share * 100) + "%"; color: Theme.text2; font-size: 13px; vertical-alignment: center; }
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 16px;
            if root.poll.has-results: Text { text: @tr("" => "Голосов: ") + root.poll.total; color: Theme.muted; font-size: 12px; }
            if !root.poll.ended && root.poll.ends != "": Text { text: @tr("" => "Закончится: ") + root.poll.ends; color: Theme.muted; font-size: 12px; }
        }
    }
}

// A voice message: play or pause, the waveform (played part brighter), the time.
component VoiceClipView inherits Rectangle {
    in property <VoiceClipItem> voice;
    callback play();
    width: 380px;
    height: 52px;
    border-radius: 26px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 16px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: play-area.has-hover ? Theme.accent-hover : Theme.accent;
                play-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.play(); }
                }
                if !root.voice.playing: Path {
                    x: 13px;
                    y: 11px;
                    width: 14px;
                    height: 14px;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    fill: Theme.on-accent;
                    commands: "M 1 0 L 13 7 L 1 14 Z";
                }
                if root.voice.playing: Path {
                    x: 11px;
                    y: 11px;
                    width: 14px;
                    height: 14px;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    fill: #ffffff;
                    commands: "M 2 1 L 5 1 L 5 13 L 2 13 Z M 9 1 L 12 1 L 12 13 L 9 13 Z";
                }
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;
            for b[i] in root.voice.bars: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 3px;
                    height: max(3px, b * 26px);
                    border-radius: 1.5px;
                    background: i < root.voice.progress * root.voice.bars.length ? Theme.strong : Theme.faint;
                }
            }
        }
        Text {
            text: root.voice.playing || root.voice.progress > 0 ? root.voice.elapsed : root.voice.total;
            color: Theme.text2;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// An invite link in a chat: its server's icon, name and counts; the button opens the join window
// (nothing is joined from here).
component InviteCard inherits Rectangle {
    in property <InviteItem> invite;
    callback join(string);
    callback open-server(string);
    width: 420px;
    height: 96px;
    border-radius: 8px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    Text {
        x: 16px;
        y: 10px;
        text: root.invite.state == 2 ? @tr("" => "ПРИГЛАШЕНИЕ НЕДЕЙСТВИТЕЛЬНО") : @tr("" => "ВАС ПРИГЛАСИЛИ НА СЕРВЕР");
        color: Theme.muted;
        font-size: 11px;
        font-weight: 800;
    }
    Rectangle {
        x: 16px;
        y: 32px;
        width: 48px;
        height: 48px;
        border-radius: 14px;
        clip: true;
        background: root.invite.state == 2 ? Theme.surface3 : Theme.accent;
        if root.invite.has-icon: Image { width: 48px; height: 48px; source: root.invite.icon; image-fit: cover; }
        if !root.invite.has-icon: Text {
            y: (parent.height - self.height) / 2 - self.font-size * 0.064;
            text: root.invite.state == 2 ? "?" : root.invite.initials;
            color: root.invite.state == 2 ? Theme.strong : Theme.on-accent;
            font-size: 15px;
            font-weight: 700;
        }
    }
    VerticalLayout {
        x: 76px;
        y: 32px;
        width: parent.width - 76px - 136px;
        height: 48px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.invite.state == 0 ? @tr("" => "Загрузка…") : root.invite.state == 2 ? @tr("" => "Попросите новое приглашение") : root.invite.name;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
            overflow: elide;
        }
        if root.invite.state == 1: Text { text: root.invite.counts; color: Theme.muted; font-size: 12.5px; overflow: elide; }
    }
    if root.invite.state == 1: Rectangle {
        x: parent.width - self.width - 16px;
        y: 37px;
        width: 116px;
        height: 38px;
        border-radius: 6px;
        background: card-join.has-hover ? #1a8f4c : #23a55a;
        card-join := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (root.invite.joined) {
                    root.open-server(root.invite.guild);
                } else {
                    root.join(root.invite.code);
                }
            }
        }
        Text { text: root.invite.joined ? @tr("" => "Открыть") : @tr("" => "Присоединиться"); color: #fff; font-size: 13px; font-weight: 600; }
    }
}

// A bot's button or select menu, drawn like Discord's. A link button opens its address; a select menu
// reports where it is so the window can open its options under it.
component BotComponent inherits Rectangle {
    in property <ComponentItem> item;
    callback clicked;
    callback open-link(string);
    callback open-select(length, length, length);
    property <bool> select: root.item.kind == 1;
    property <bool> active: !root.item.disabled && !root.item.pending && (!root.select || root.item.usable);
    property <color> base: root.item.style == 1 ? #5865f2 : root.item.style == 3 ? #248046 : root.item.style == 4 ? #da373c : #4e5058;
    property <bool> fired;
    width: root.select ? 400px : button-row.preferred-width;
    height: root.select ? 40px : 32px;
    border-radius: 4px;
    opacity: root.item.disabled || (root.select && !root.item.usable) ? 0.5 : 1.0;
    background: root.select
        ? (Theme.light ? #e3e5e8 : #1e1f22)
        : (area.has-hover && root.active ? root.base.darker(0.18) : root.base);
    border-width: root.select ? 1px : 0px;
    border-color: area.has-hover && root.active ? (Theme.light ? #00000040 : #000000) : (Theme.light ? #0000001a : #00000050);
    animate background { duration: Appearance.quick; }
    function open() {
        root.open-select(area.absolute-position.x, area.absolute-position.y + root.height, root.width);
    }
    area := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? pointer : default;
        clicked => {
            if (root.select) {
                root.open();
            } else if (root.item.style == 5) {
                root.open-link(root.item.url);
            } else {
                root.clicked();
            }
        }
    }
    button-row := HorizontalLayout {
        visible: !root.select;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 6px;
        alignment: center;
        if root.item.emoji.has-image: VerticalLayout {
            alignment: center;
            Image { width: 18px; height: 18px; source: root.item.emoji.image; image-fit: contain; opacity: root.item.pending ? 0 : 1; }
        }
        if !root.item.emoji.has-image && root.item.emoji.text != "": Text {
            text: root.item.emoji.text;
            font-family: "Segoe UI Emoji";
            font-size: 15px;
            color: #ffffff;
            vertical-alignment: center;
            opacity: root.item.pending ? 0 : 1;
        }
        if root.item.label != "": Text {
            text: root.item.label;
            color: #ffffff;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
            opacity: root.item.pending ? 0 : 1;
        }
        if root.item.style == 5: VerticalLayout {
            alignment: center;
            Icon { width: 16px; height: 16px; stroke-width: 2.4px; commands: Icons.external; tint: #ffffff; }
        }
    }
    // Waiting for the bot: three dots over the button.
    if root.item.pending && !root.select: Text {
        text: "• • •";
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.select: HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.item.summary != "" ? root.item.summary : root.item.placeholder != "" ? root.item.placeholder : @tr("" => "Сделайте выбор");
            color: root.item.summary != "" ? Theme.text : Theme.muted;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.item.pending: Text { text: "• • •"; color: Theme.muted; font-size: 13px; font-weight: 700; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            Icon { width: 18px; height: 18px; stroke-width: 2.4px; commands: Icons.chevron; tint: Theme.text2; }
        }
    }
    // The demo opens one menu by itself, once it is laid out.
    Timer {
        interval: 600ms;
        running: root.item.demo-open && !root.fired;
        triggered => {
            root.fired = true;
            root.open();
        }
    }
}

// A small button of an event card ("Поделиться", "⋯").
component EventCardButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked;
    width: self.text != "" ? event-btn-label.preferred-width + 24px : 32px;
    height: 32px;
    border-radius: 4px;
    background: event-btn.has-hover ? Theme.wash-hover : Theme.wash;
    event-btn := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    if root.icon != "": Icon { x: 6px; y: 6px; commands: root.icon; tint: Theme.text; stroke-width: 3px; }
    event-btn-label := Text { text: root.text; color: Theme.text; font-size: 14px; font-weight: 500; visible: root.text != ""; }
}

// A scheduled event as Discord draws it in the events window: when, who made it and how many are interested;
// its name and description; where, and the share / interested buttons. `preview`: shown before it exists.
component EventCard inherits Rectangle {
    in property <EventItem> event;
    in property <bool> preview;
    callback interest(bool);
    callback share();
    callback cancel-event();
    property <bool> menu-open;
    height: card-body.preferred-height;
    border-radius: 8px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    card-body := VerticalLayout {
        padding: 16px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Icon { width: 16px; height: 16px; commands: Icons.calendar; tint: root.event.active ? Theme.green : Theme.muted; }
            }
            Text {
                text: root.event.active ? @tr("" => "Идёт сейчас") : root.event.when;
                color: root.event.active ? Theme.green : Theme.text2;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            // Who made it, and how many are interested.
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                clip: true;
                background: Theme.accent;
                if root.event.has-avatar: Image { width: 20px; height: 20px; source: root.event.avatar; }
                if !root.event.has-avatar: Text { y: (parent.height - self.height) / 2 - self.font-size * 0.064; text: root.event.initial; color: Theme.on-accent; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Icon { width: 16px; height: 16px; commands: Icons.friends; tint: Theme.muted; }
                }
                Text { text: root.event.count; color: Theme.muted; font-size: 13px; font-weight: 600; vertical-alignment: center; }
            }
        }
        Text { text: root.event.name; color: Theme.text; font-size: 16px; font-weight: 700; wrap: word-wrap; }
        if root.event.description != "": Text {
            text: root.event.description;
            color: Theme.muted;
            font-size: 13.5px;
            wrap: word-wrap;
            max-height: 58px;
            overflow: elide;
        }
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Icon {
                    width: 18px;
                    height: 18px;
                    commands: root.event.place-kind == 1 ? Icons.stage : root.event.place-kind == 2 ? Icons.volume : Icons.location;
                    tint: Theme.muted;
                }
            }
            Text {
                text: root.event.place;
                color: Theme.text2;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if !root.preview && root.event.mine: EventCardButton {
                text: "•••";
                clicked => { root.menu-open = !root.menu-open; }
            }
            if !root.preview: EventCardButton {
                text: @tr("" => "Поделиться");
                clicked => { root.share(); }
            }
            // "Интересно": green with a tick when we are.
            Rectangle {
                width: interest-row.preferred-width;
                height: 32px;
                border-radius: 4px;
                background: root.event.interested ? (interest-area.has-hover ? #1a6334 : #248046) : (interest-area.has-hover ? Theme.wash : transparent);
                border-width: root.event.interested ? 0px : 1px;
                border-color: Theme.muted;
                interest-area := TouchArea {
                    enabled: !root.preview;
                    mouse-cursor: pointer;
                    clicked => { root.interest(!root.event.interested); }
                }
                interest-row := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    if root.event.interested: VerticalLayout {
                        alignment: center;
                        Icon { width: 16px; height: 16px; stroke-width: 3px; commands: Icons.check; tint: #ffffff; }
                    }
                    Text {
                        text: @tr("" => "Интересно");
                        color: root.event.interested ? #ffffff : Theme.text;
                        font-size: 14px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    // "⋯" of an event we made: cancel it.
    if root.menu-open: Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - 48px - self.height - 4px;
        width: cancel-label.preferred-width + 24px;
        height: 36px;
        border-radius: 4px;
        background: cancel-area.has-hover ? #da373c : Theme.popup;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 10px;
        drop-shadow-color: Theme.shadow;
        cancel-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.menu-open = false;
                root.cancel-event();
            }
        }
        cancel-label := Text { text: @tr("" => "Отменить мероприятие"); color: cancel-area.has-hover ? #ffffff : #f23f43; font-size: 14px; font-weight: 500; }
    }
}

component MessageRow inherits Rectangle {    in property <MessageItem> item;
    callback join-call();
    // A bot's button clicked: the message, the button's custom id.
    callback component-click(string, string);
    // A bot's select menu clicked: the message, its custom id, where it is (x, its bottom edge, width).
    callback select-open(string, string, length, length, length);
    // An invite card's button: the code to join by, or the server we are in already.
    callback open-invite(string);
    callback open-server(string);
    callback open-link(string);
    // A mention is about to be followed: where the pointer is.
    callback pointer-at(length, length);
    // The picture clicked.
    callback open-image(MessageItem);
    // The avatar or the name clicked: whose, where.
    callback user-card(string, length, length);
    // The bar over a hovered message.
    callback quick-react(string);
    callback quick-reply(string);
    callback quick-forward(string);
    // A reaction clicked: the message and the reaction's key.
    callback react(string, string);
    // A poll's answer clicked: the message and the answer's id.
    callback poll-vote(string, int);
    // The play button of a voice message.
    callback voice-play(string);
    // Right-click on a message: its author's menu.
    callback user-menu(string, length, length);
    // Right-click on a message: its id, its author, where.
    callback message-menu(string, string, bool, length, length);
    background: root.item.highlight ? Theme.active : root.item.mention ? Theme.hover : (ta.has-hover && !root.item.deleted ? Theme.hover : transparent);
    animate background { duration: Appearance.quick; }
    height: root.item.deleted ? 0px : body.preferred-height;
    clip: root.item.deleted;
    // A new message comes in the way the settings say. The list hands rows to other messages as it
    // scrolls, so this starts on each change of message, not only when the row is made.
    property <string> row-id: root.item.id;
    changed row-id => { root.enter(); }
    init => { root.enter(); }
    function enter() {
        root.entered-at = animation-tick();
        root.entering = root.item.fresh && !Appearance.reduce-motion;
    }
    property <bool> entering;
    property <duration> entered-at;
    property <int> enter-mode: Appearance.message-anim;
    property <duration> enter-time: root.enter-mode == 2 ? 300ms : 260ms;
    property <float> enter-t: root.entering ? clamp((animation-tick() - root.entered-at) / root.enter-time, 0, 1) : 1;
    property <float> enter-ease: 1 - (1 - root.enter-t) * (1 - root.enter-t) * (1 - root.enter-t);
    Timer {
        running: root.entering;
        interval: root.enter-time;
        triggered => { root.entering = false; }
    }
    opacity: root.enter-ease;
    transform-scale: root.enter-mode == 2 ? (0.92 + 0.08 * root.enter-ease) * 100% : 100%;

    // A mention of you: Discord's yellow bar along the left edge.
    if root.item.mention && !root.item.deleted: Rectangle { x: 0; width: 2px; background: Theme.text; }

    ta := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up && !root.item.system && root.item.author-id != "") {
                root.message-menu(root.item.id, root.item.author-id, root.item.pinned, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    body := VerticalLayout {
        x: root.enter-mode != 2 ? -72px * (1 - root.enter-ease) : 0px;
        y: root.enter-mode == 2 ? 8px * (1 - root.enter-ease) : 0px;
        visible: !root.item.deleted;
        padding-left: 16px;
        padding-right: 48px;
        padding-top: root.item.grouped ? 1px : (Appearance.compact ? 5px : 17px);
        padding-bottom: 1px;

        HorizontalLayout {
            spacing: 16px;

            VerticalLayout {
                alignment: start;
                min-width: 40px;
                max-width: 40px;
                if root.item.system-icon > 0: Rectangle {
                    height: 22px;
                    Icon {
                        width: 18px;
                        height: 18px;
                        commands: root.item.system-icon == 2 ? Icons.arrow-left : root.item.system-icon == 3 ? Icons.phone : root.item.system-icon == 4 ? Icons.pin : Icons.arrow-right;
                        tint: root.item.system-icon == 2 ? #f04a55 : root.item.system-icon == 4 || root.item.system-icon == 5 ? Theme.muted : #23a55a;
                    }
                }
                if !root.item.grouped && !root.item.system: Rectangle {
                    width: 40px;
                    height: 40px;
                    Rectangle {
                        border-radius: 20px;
                        clip: true;
                        background: Theme.surface3;
                        Image { width: 40px; height: 40px; source: root.item.avatar; }
                    }
                    if root.item.has-decoration: Image { x: -5px; y: -5px; width: 50px; height: 50px; source: root.item.decoration; }
                    avatar-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.user-card(root.item.author-id, self.absolute-position.x + 48px, self.absolute-position.y); }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                root.user-menu(root.item.author-id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                }
                if root.item.grouped: Text {
                    text: ta.has-hover ? root.item.short-time : "";
                    color: Theme.muted;
                    font-size: 10px;
                    horizontal-alignment: right;
                    height: 22px;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 2px;
                if !root.item.grouped && !root.item.system: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: root.item.author;
                        color: root.item.has-author-color ? root.item.author-color : Theme.text;
                        font-size: 16px;
                        font-weight: 600;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.user-card(root.item.author-id, self.absolute-position.x + self.width + 8px, self.absolute-position.y); }
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                    root.user-menu(root.item.author-id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                    if Appearance.show-time: Text { text: root.item.time; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
                // Forwarded: a line saying so; the original follows as a quote.
                if root.item.forwarded: HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    Icon { width: 14px; height: 14px; stroke-width: 2.2px; commands: Icons.forward; tint: Theme.muted; }
                    Text { text: @tr("" => "Переслано"); color: Theme.muted; font-size: 12.5px; font-italic: true; vertical-alignment: center; }
                }
                if root.item.system-icon > 0: HorizontalLayout {
                    height: 22px;
                    spacing: 4px;
                    alignment: start;
                    Text { text: root.item.author; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                    Text { text: root.item.system-what; color: Theme.text2; font-size: 14px; vertical-alignment: center; overflow: elide; }
                    if root.item.system-whom != "": Text { text: root.item.system-whom; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                    if root.item.system-rest != "": Text { text: root.item.system-rest; color: Theme.text2; font-size: 14px; vertical-alignment: center; overflow: elide; }
                    if root.item.system-call: Rectangle {
                        width: join-call-label.preferred-width;
                        join-call-area := TouchArea { mouse-cursor: pointer; clicked => { root.join-call(); } }
                        join-call-label := Text { text: @tr("" => "Присоединиться к звонку"); color: join-call-area.has-hover ? Theme.text : #00a8fc; font-size: 14px; vertical-alignment: center; }
                    }
                    Text { text: root.item.time; color: Theme.faint; font-size: 12px; vertical-alignment: center; }
                }
                for b in root.item.blocks: BlockView {
                    block: b;
                    system: root.item.system;
                    open-link(url) => {
                        root.pointer-at(ta.absolute-position.x + ta.mouse-x, ta.absolute-position.y + ta.mouse-y);
                        root.open-link(url);
                    }
                }
                // Only emoji: big, ten to a line.
                if root.item.emojis.length > 0: Rectangle {
                    height: ceil(root.item.emojis.length / 10) * 52px;
                    for e[i] in root.item.emojis: Rectangle {
                        x: mod(i, 10) * 52px;
                        y: floor(i / 10) * 52px;
                        width: 48px;
                        height: 48px;
                        if e.has-image: Image { width: 48px; height: 48px; source: e.image; image-fit: contain; }
                        if !e.has-image: Text {
                            text: e.text;
                            font-family: "Segoe UI Emoji";
                            font-size: e.key == e.text ? 38px : 12px;
                            color: Theme.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.item.sticker-kind == 1: HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    Image { width: 160px; height: 160px; source: root.item.sticker; image-fit: contain; }
                }
                if root.item.sticker-kind == 2: HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.surface3;
                        border-width: 1px;
                        border-color: Theme.line;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;
                            Text { text: "🏷"; font-family: "Segoe UI Emoji"; font-size: 14px; vertical-alignment: center; }
                            Text { text: root.item.sticker-name; color: Theme.text2; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                }
                if root.item.has-poll: HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    PollView {
                        poll: root.item.poll;
                        vote(answer) => { root.poll-vote(root.item.id, answer); }
                    }
                }
                if root.item.has-voice: HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    VoiceClipView {
                        voice: root.item.voice;
                        play => { root.voice-play(root.item.id); }
                    }
                }
                for c in root.item.cards: HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    CardView {
                        width: 420px;
                        card: c;
                        open-link(url) => { root.open-link(url); }
                    }
                }
                for v in root.item.invites: HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    InviteCard {
                        invite: v;
                        join(code) => { root.open-invite(code); }
                        open-server(guild) => { root.open-server(guild); }
                    }
                }
                if root.item.has-picture: HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    Rectangle {
                        width: root.item.picture-width;
                        height: root.item.picture-height;
                        border-radius: 8px;
                        clip: true;
                        background: Theme.surface3;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.item.picture;
                            image-fit: cover;
                        }
                        picture-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-image(root.item); }
                        }
                        // A thin edge that lights up under the pointer.
                        Rectangle {
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: picture-area.has-hover ? Theme.wash-hover : Theme.line;
                            animate border-color { duration: Appearance.quick; }
                        }
                    }
                }
                if root.item.components.length > 0: VerticalLayout {
                    padding-top: 4px;
                    spacing: 8px;
                    for r in root.item.components: HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        for c in r.items: BotComponent {
                            item: c;
                            clicked => { root.component-click(root.item.id, c.custom-id); }
                            open-link(url) => { root.open-link(url); }
                            open-select(x, y, w) => { root.select-open(root.item.id, c.custom-id, x, y, w); }
                        }
                    }
                }
                if root.item.edited: Text {
                    text: @tr("" => "(изменено)");
                    color: Theme.faint;
                    font-size: 11px;
                }
                if root.item.ephemeral: HorizontalLayout {
                    alignment: start;
                    spacing: 6px;
                    padding-top: 2px;
                    Text { text: "👁"; font-family: "Segoe UI Emoji"; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                    Text { text: @tr("" => "Только вы можете видеть это сообщение"); color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
                if root.item.reactions.length > 0: HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    padding-top: 4px;
                    padding-bottom: 2px;
                    for r in root.item.reactions: ReactionChip {
                        reaction: r;
                        clicked => { root.react(root.item.id, r.key); }
                    }
                }
            }
        }
    }
    // Reaction, reply, forward and the full menu, over the hovered message.
    bar-area := TouchArea {
        x: parent.width - self.width - 24px;
        y: root.item.grouped ? 0px : 4px;
        width: 4 * 32px + 10px;
        height: 38px;
        visible: (ta.has-hover || self.has-hover) && !root.item.system && !root.item.deleted && root.item.author-id != "";
        Rectangle {
            opacity: bar-area.visible ? 1 : 0;
            animate opacity { duration: Appearance.quick; }
            background: Theme.popup;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.edge;
            HorizontalLayout {
                padding: 3px;
                spacing: 1px;
                IconButton { icon: Icons.smile; clicked => { root.quick-react(root.item.id); } }
                IconButton { icon: Icons.reply; clicked => { root.quick-reply(root.item.id); } }
                IconButton { icon: Icons.forward; clicked => { root.quick-forward(root.item.id); } }
                Rectangle {
                    width: 32px;
                    border-radius: 8px;
                    background: more-ta.has-hover ? Theme.hover : transparent;
                    animate background { duration: Appearance.quick; }
                    more-ta := TouchArea {
                        clicked => { root.message-menu(root.item.id, root.item.author-id, root.item.pinned, self.absolute-position.x, self.absolute-position.y + 32px); }
                    }
                    Text { text: "•••"; color: Theme.text2; font-size: 9px; }
                }
            }
        }
    }
}

// A person's card: banner, avatar with its frame and dot, names, badges, what you share, "about me".
// Over the chat it ends with a message box; in the panel beside a DM, with a button for the big card.
// The badges of a profile in a row, as many as fit and "+N"; a click opens them all.
component BadgeRow inherits Rectangle {
    in property <[BadgeItem]> badges;
    in property <int> most: 11;
    callback open(int);
    property <int> shown: min(root.badges.length, root.most);
    property <int> left: root.badges.length - root.shown;
    width: root.shown * 24px + 10px + (root.left > 0 ? 30px : 0px);
    height: 28px;
    border-radius: 8px;
    background: Theme.wash;
    for b[i] in root.badges: Rectangle {
        x: 5px + i * 24px;
        y: 4px;
        width: 20px;
        height: 20px;
        visible: i < root.shown;
        Image { width: 20px; height: 20px; source: b.picture; }
        TouchArea { mouse-cursor: pointer; clicked => { root.open(i); } }
    }
    if root.left > 0: Rectangle {
        x: 5px + root.shown * 24px;
        y: 4px;
        width: 28px;
        height: 20px;
        more-badges := TouchArea { mouse-cursor: pointer; clicked => { root.open(root.shown); } }
        Text { text: "+" + root.left; color: more-badges.has-hover ? Theme.text : Theme.text2; font-size: 12px; font-weight: 600; }
    }
}

component UserCardView inherits Rectangle {
    in property <UserCardItem> item;
    in property <bool> panel;
    callback more(length, length);
    callback message(string);
    callback full();
    // A badge was clicked: which.
    callback open-badge(int);
    out property <length> wanted: 170px + body.preferred-height + 16px;
    border-radius: 12px;
    background: Theme.glass-strong;
    border-width: 1px;
    border-color: Theme.edge;
    drop-shadow-blur: 32px;
    drop-shadow-color: Theme.shadow;
    clip: true;
    TouchArea {}
    Rectangle {
        y: 0;
        height: 120px;
        background: root.item.has-color ? root.item.banner-color : Theme.accent.darker(0.4);
        if root.item.has-banner: Image { width: parent.width; height: parent.height; source: root.item.banner; image-fit: cover; }
    }
    // The "more" button on the banner: glass.
    Rectangle {
        x: parent.width - 42px;
        y: 10px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: more-area.has-hover ? #000000c0 : #00000080;
        border-width: 1px;
        border-color: #ffffff2e;
        animate background { duration: Appearance.quick; }
        more-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.more(self.absolute-position.x + self.width + 8px, self.absolute-position.y); }
        }
        Text { text: "•••"; color: #ffffff; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
    }
    // The ring has the card's colour, so the avatar looks cut out of the banner.
    Rectangle {
        x: 16px;
        y: 72px;
        width: 88px;
        height: 88px;
        border-radius: 44px;
        background: Theme.light ? #ffffff : #101014;
        Rectangle {
            x: 6px;
            y: 6px;
            width: 76px;
            height: 76px;
            border-radius: 38px;
            clip: true;
            background: Theme.surface3;
            Image { width: 76px; height: 76px; source: root.item.avatar; image-fit: cover; }
        }
        if root.item.has-decoration: Image { x: -7px; y: -7px; width: 102px; height: 102px; source: root.item.decoration; }
        if root.item.status > 0: PresenceDot { x: 60px; y: 60px; width: 24px; height: 24px; status: root.item.status - 1; border-width: 4px; border-color: Theme.light ? #ffffff : #101014; }
    }
    body := VerticalLayout {
        x: 16px;
        y: 170px;
        width: parent.width - 32px;
        height: self.preferred-height;
        spacing: 8px;
        alignment: start;
        Text { text: root.item.name; color: Theme.text; font-size: 20px; font-weight: 800; overflow: elide; }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: root.item.pronouns == "" ? root.item.username : root.item.username + " • " + root.item.pronouns; color: Theme.text2; font-size: 14px; vertical-alignment: center; overflow: elide; }
            if root.item.tag != "": Rectangle {
                width: tag-text.preferred-width + 14px;
                height: 22px;
                border-radius: 6px;
                background: Theme.wash;
                tag-text := Text { text: root.item.tag; color: Theme.text; font-size: 12px; font-weight: 600; }
            }
        }
        if root.item.badges.length > 0: HorizontalLayout {
            alignment: start;
            BadgeRow { badges: root.item.badges; open(i) => { root.open-badge(i); } }
        }
        if root.item.mutual != "": Text { text: root.item.mutual; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        if root.item.bio != "": Text { text: Fmt.stamps(root.item.bio); color: Theme.body; font-size: 14px; wrap: word-wrap; }
        if root.panel && root.item.since != "": VerticalLayout {
            spacing: 4px;
            Text { text: @tr("" => "В числе участников с"); color: Theme.text2; font-size: 12px; font-weight: 700; }
            Text { text: root.item.since; color: Theme.body; font-size: 14px; }
        }
        if !root.panel && !root.item.me: Rectangle {
            height: 42px;
            border-radius: 8px;
            background: Theme.card;
            border-width: 1px;
            border-color: card-input.has-focus ? Theme.accent.with-alpha(0.7) : Theme.line;
            animate border-color { duration: Appearance.quick; }
            card-input := TextInput {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                single-line: true;
                vertical-alignment: center;
                color: Theme.text;
                font-size: 14px;
                accepted => {
                    if (self.text != "") {
                        root.message(self.text);
                        self.text = "";
                    }
                }
            }
            if card-input.text == "": Text {
                x: 12px;
                height: parent.height;
                vertical-alignment: center;
                text: @tr("" => "Сообщение для @{}", root.item.username);
                color: Theme.faint;
                font-size: 14px;
            }
        }
        if !root.panel: Rectangle {
            height: 22px;
            full-link := TouchArea { mouse-cursor: pointer; clicked => { root.full(); } }
            Text { x: 0; text: @tr("" => "Полный профиль"); color: full-link.has-hover ? Theme.text : Theme.text2; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        }
    }
    if root.panel: Rectangle {
        x: 16px;
        y: parent.height - 56px;
        width: parent.width - 32px;
        height: 40px;
        border-radius: 8px;
        background: full-area.has-hover ? Theme.button-hover : Theme.button;
        animate background { duration: Appearance.quick; }
        full-area := TouchArea { mouse-cursor: pointer; clicked => { root.full(); } }
        Text { text: @tr("" => "Полный профиль"); color: Theme.text; font-size: 14px; font-weight: 600; }
    }
}

// All of someone's badges: pick one on the left, what it says on the right, and how far a growing one has come.
component BadgesWindow inherits Rectangle {
    in property <UserCardItem> card;
    in-out property <int> picked;
    callback closed();
    callback open-link(string);
    callback nitro-page();
    property <BadgeItem> badge: root.card.badges[root.picked];
    background: #000000b8;
    TouchArea { clicked => { root.closed(); } }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.closed();
                return accept;
            }
            return reject;
        }
    }
    init => { keys.focus(); }
    Rectangle {
        width: min(700px, root.width - 48px);
        height: min(580px, root.height - 64px);
        border-radius: 14px;
        background: Theme.glass-strong;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.shadow;
        clip: true;
        TouchArea {}
        // On the left: whose, and all of them.
        Rectangle {
            x: 0;
            width: 264px;
            background: Theme.surface0;
            Text { x: 22px; y: 24px; width: parent.width - 44px; text: @tr("" => "Значки пользователя") + " " + root.card.name; color: Theme.text; font-size: 18px; font-weight: 800; wrap: word-wrap; }
            Flickable {
                x: 22px;
                y: 100px;
                width: parent.width - 44px;
                height: parent.height - 120px;
                interactive: false;
                content-height: (ceil(root.card.badges.length / 4) * 56px);
                for b[i] in root.card.badges: Rectangle {
                    x: mod(i, 4) * 56px;
                    y: floor(i / 4) * 56px;
                    width: 48px;
                    height: 48px;
                    border-radius: 8px;
                    background: root.picked == i ? Theme.active : (tile-area.has-hover ? Theme.hover : Theme.wash);
                    border-width: root.picked == i ? 1px : 0px;
                    border-color: Theme.accent;
                    tile-area := TouchArea { mouse-cursor: pointer; clicked => { root.picked = i; } }
                    Image { width: 30px; height: 30px; source: b.picture; }
                }
            }
        }
        // On the right: the one picked.
        Flickable {
            x: 264px;
            width: parent.width - 264px;
            interactive: false;
            content-height: badge-body.preferred-height + 40px;
            badge-body := VerticalLayout {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                height: self.preferred-height;
                spacing: 14px;
                alignment: start;
                HorizontalLayout {
                    alignment: center;
                    Image { width: 96px; height: 96px; source: root.badge.picture; }
                }
                if root.badge.heading != "": Text { text: root.badge.heading; color: Theme.text; font-size: 20px; font-weight: 800; horizontal-alignment: center; }
                Text { text: root.badge.text; color: Theme.text2; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                if root.badge.link != "": HorizontalLayout {
                    alignment: center;
                    DialogButton { text: @tr("" => "Открыть страницу"); clicked => { root.open-link(root.badge.link); } }
                }
                if root.badge.tiers.length > 0: Rectangle {
                    height: ceil(root.badge.tiers.length / 3) * 52px + 42px;
                    border-radius: 10px;
                    background: Theme.surface0;
                    Text { x: 16px; y: 12px; text: @tr("" => "Прогресс"); color: Theme.text; font-size: 14px; font-weight: 700; }
                    for t[i] in root.badge.tiers: VerticalLayout {
                        x: 12px + mod(i, 3) * ((parent.width - 24px) / 3);
                        y: 42px + floor(i / 3) * 52px;
                        width: (parent.width - 24px) / 3;
                        height: 48px;
                        alignment: start;
                        spacing: 2px;
                        if t.name != "": Text { text: t.name; color: t.reached ? Theme.text : Theme.faint; font-size: 13px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
                        Text { text: (t.reached ? "" : "🔒 ") + t.after; color: t.reached ? Theme.text2 : Theme.faint; font-size: 12px; horizontal-alignment: center; overflow: elide; }
                    }
                }
            }
        }
        Rectangle {
            x: parent.width - 44px;
            y: 12px;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: badges-close.has-hover ? Theme.button-hover : Theme.button;
            badges-close := TouchArea { mouse-cursor: pointer; clicked => { root.closed(); } }
            Icon { x: 7px; y: 7px; width: 18px; height: 18px; commands: Icons.close; tint: Theme.text; }
        }
    }
}

// A person's whole profile over the window: who they are and what to do on the left, what you share on the right.
component FullProfile inherits Rectangle {
    in property <UserCardItem> item;
    in-out property <ProfileExtra> extra;
    callback close();
    callback message();
    // The button beside "Сообщение": add or remove as a friend.
    callback friend-button();
    callback more(length, length);
    callback open-link(string);
    callback open-person(string);
    callback open-server(string);
    callback note-saved(string);
    callback open-badge(int);
    property <int> tab;
    background: #000000b8;
    TouchArea { clicked => { root.close(); } }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            return reject;
        }
    }
    init => { keys.focus(); }
    Rectangle {
        width: min(960px, root.width - 80px);
        height: min(780px, root.height - 100px);
        border-radius: 14px;
        background: Theme.glass-strong;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.shadow;
        clip: true;
        TouchArea {}
        Rectangle {
            x: 0;
            width: 400px;
            background: Theme.surface0;
            Flickable {
                interactive: false;
                content-height: 190px + left-body.preferred-height + 24px;
                Rectangle {
                    y: 0;
                    height: 140px;
                    background: root.item.has-color ? root.item.banner-color : Theme.accent.darker(0.4);
                    if root.item.has-banner: Image { width: parent.width; height: parent.height; source: root.item.banner; image-fit: cover; }
                }
                Rectangle {
                    x: 24px;
                    y: 84px;
                    width: 104px;
                    height: 104px;
                    border-radius: 52px;
                    background: Theme.surface0;
                    Rectangle {
                        x: 6px;
                        y: 6px;
                        width: 92px;
                        height: 92px;
                        border-radius: 46px;
                        clip: true;
                        background: Theme.surface3;
                        Image { width: 92px; height: 92px; source: root.item.avatar; image-fit: cover; }
                    }
                    if root.item.has-decoration: Image { x: -8px; y: -8px; width: 120px; height: 120px; source: root.item.decoration; }
                    if root.item.status > 0: PresenceDot { x: 74px; y: 74px; width: 26px; height: 26px; status: root.item.status - 1; border-width: 4px; border-color: Theme.surface0; }
                }
                left-body := VerticalLayout {
                    x: 24px;
                    y: 196px;
                    width: 352px;
                    height: self.preferred-height;
                    spacing: 12px;
                    alignment: start;
                    Text { text: root.item.name; color: Theme.text; font-size: 22px; font-weight: 800; overflow: elide; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: root.item.pronouns == "" ? root.item.username : root.item.username + " • " + root.item.pronouns; color: Theme.text2; font-size: 14px; vertical-alignment: center; overflow: elide; }
                        if root.item.tag != "": Rectangle {
                            width: full-tag.preferred-width + 14px;
                            height: 22px;
                            border-radius: 6px;
                            background: Theme.wash;
                            full-tag := Text { text: root.item.tag; color: Theme.text; font-size: 12px; font-weight: 600; }
                        }
                    }
                    if root.item.badges.length > 0: HorizontalLayout {
                        alignment: start;
                        BadgeRow { badges: root.item.badges; most: 13; open(i) => { root.open-badge(i); } }
                    }
                    if !root.item.me: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Rectangle {
                            width: message-label.preferred-width + 28px;
                            height: 34px;
                            border-radius: 8px;
                            background: message-area.has-hover ? Theme.button-hover : Theme.button;
                            animate background { duration: Appearance.quick; }
                            message-area := TouchArea { mouse-cursor: pointer; clicked => { root.message(); } }
                            message-label := Text { text: @tr("" => "Сообщение"); color: Theme.text; font-size: 14px; font-weight: 600; }
                        }
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: friend-area.has-hover ? Theme.button-hover : Theme.button;
                            animate background { duration: Appearance.quick; }
                            friend-area := TouchArea { mouse-cursor: pointer; clicked => { root.friend-button(); } }
                            Icon { width: 18px; height: 18px; commands: Icons.user; tint: root.extra.friend ? Theme.green : Theme.text; }
                        }
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: dots-area.has-hover ? Theme.button-hover : Theme.button;
                            animate background { duration: Appearance.quick; }
                            dots-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.more(self.absolute-position.x + self.width + 8px, self.absolute-position.y); }
                            }
                            Text { text: "•••"; color: Theme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    if root.item.bio != "": Text { text: Fmt.stamps(root.item.bio); color: Theme.body; font-size: 14px; wrap: word-wrap; }
                    if root.item.since != "": VerticalLayout {
                        spacing: 4px;
                        Text { text: @tr("" => "В числе участников с"); color: Theme.text2; font-size: 12px; font-weight: 700; }
                        Text { text: root.item.since; color: Theme.body; font-size: 14px; }
                    }
                    if root.extra.friends-since != "": VerticalLayout {
                        spacing: 4px;
                        Text { text: @tr("" => "Друзья с"); color: Theme.text2; font-size: 12px; font-weight: 700; }
                        Text { text: root.extra.friends-since; color: Theme.body; font-size: 14px; }
                    }
                    if root.extra.accounts.length > 0: VerticalLayout {
                        spacing: 6px;
                        Text { text: @tr("" => "Интеграции"); color: Theme.text2; font-size: 12px; font-weight: 700; }
                        for a in root.extra.accounts: Rectangle {
                            height: 24px;
                            account-area := TouchArea {
                                enabled: a.url != "";
                                mouse-cursor: a.url != "" ? pointer : default;
                                clicked => { root.open-link(a.url); }
                            }
                            Text {
                                x: 0;
                                width: parent.width;
                                height: parent.height;
                                text: a.kind + " · " + a.name + (a.url != "" ? " ↗" : "");
                                color: account-area.has-hover && a.url != "" ? Theme.text : Theme.body;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    if !root.item.me: VerticalLayout {
                        spacing: 4px;
                        Text { text: @tr("" => "Заметка (видна только вам)"); color: Theme.text2; font-size: 12px; font-weight: 700; }
                        Rectangle {
                            height: 30px;
                            full-note := TextInput {
                                width: parent.width;
                                height: parent.height;
                                single-line: true;
                                vertical-alignment: center;
                                color: Theme.text;
                                font-size: 14px;
                                text: root.extra.note;
                                edited => { root.extra.note = self.text; }
                                accepted => { root.note-saved(self.text); }
                                changed has-focus => {
                                    if (!self.has-focus) {
                                        root.note-saved(self.text);
                                    }
                                }
                            }
                            if full-note.text == "": Text { x: 0; width: parent.width; height: parent.height; vertical-alignment: center; text: @tr("" => "Нажми, чтобы добавить заметку"); color: Theme.faint; font-size: 14px; }
                        }
                    }
                }
            }
        }
        Rectangle {
            x: 400px;
            width: parent.width - 400px;
            VerticalLayout {
                padding: 24px;
                padding-right: 56px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 20px;
                    alignment: start;
                    for label[i] in [@tr("" => "Активность"), @tr("" => "Общие друзья") + ": " + root.extra.friends.length, @tr("" => "Общие серверы") + ": " + root.extra.servers.length]: Rectangle {
                        width: tab-label.preferred-width;
                        height: 30px;
                        tab-area := TouchArea { mouse-cursor: pointer; clicked => { root.tab = i; } }
                        tab-label := Text { y: 0; height: 24px; text: label; color: root.tab == i || tab-area.has-hover ? Theme.text : Theme.text2; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                        if root.tab == i: Rectangle { y: parent.height - 2px; height: 2px; background: Theme.text; }
                    }
                }
                if root.tab == 0: Text {
                    vertical-stretch: 1;
                    text: root.extra.activity != "" ? root.extra.activity : @tr("" => "Сейчас ничего не происходит");
                    color: Theme.body;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                if root.tab == 1: ListView {
                    vertical-stretch: 1;
                    for f in root.extra.friends: Rectangle {
                        height: 44px;
                        border-radius: 6px;
                        background: friend-row.has-hover ? Theme.hover : transparent;
                        friend-row := TouchArea { mouse-cursor: pointer; clicked => { root.open-person(f.id); } }
                        Rectangle {
                            x: 6px;
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            clip: true;
                            background: Theme.surface3;
                            if f.has-avatar: Image { width: 32px; height: 32px; source: f.avatar; image-fit: cover; }
                        }
                        Text { x: 48px; width: parent.width - 54px; height: parent.height; text: f.name; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                    }
                }
                if root.tab == 2: ListView {
                    vertical-stretch: 1;
                    for s in root.extra.servers: Rectangle {
                        height: 40px;
                        border-radius: 6px;
                        background: server-row.has-hover ? Theme.hover : transparent;
                        server-row := TouchArea { mouse-cursor: pointer; clicked => { root.open-server(s.id); } }
                        Text { x: 10px; width: parent.width - 20px; height: parent.height; text: s.name; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
        }
        Rectangle {
            x: parent.width - 44px;
            y: 12px;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: close-area.has-hover ? Theme.button-hover : Theme.button;
            close-area := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
            Icon { x: 7px; y: 7px; width: 18px; height: 18px; commands: Icons.close; tint: Theme.text; }
        }
    }
}

// A picture almost as big as the window: it grows out of its size in the message. The author at the top left,
// the tools at the top right; a click on the picture zooms, a click beside it or Esc closes.
component ImageViewer inherits Rectangle {
    in property <MessageItem> item;
    in property <image> full-image;
    in property <bool> has-full;
    callback close();
    callback forward();
    callback save();
    callback open-outside();
    callback copy-address();
    property <bool> shown;
    property <bool> zoomed;
    // The wheel: on top of the fit, and where the enlarged picture was dragged to.
    property <float> wheel: 1;
    property <length> pan-x;
    property <length> pan-y;
    property <bool> dragged;
    function zoom-by(delta: length) {
        self.wheel = clamp(self.wheel * (delta > 0px ? 1.2 : 1 / 1.2), 1, 8);
        if (self.wheel == 1) {
            self.pan-x = 0px;
            self.pan-y = 0px;
        }
    }
    property <length> room-w: root.width - 96px;
    property <length> room-h: root.height - 150px;
    property <float> ratio: root.item.picture-height > 0px ? root.item.picture-width / root.item.picture-height : 1.0;
    // As big as fits without cutting anything; the file's own size unless zoomed.
    property <length> fit-w: min(root.room-w, root.room-h * root.ratio);
    property <length> own-w: root.has-full ? root.full-image.width * 1px : root.item.picture-width;
    property <length> open-w: root.zoomed ? root.fit-w : min(root.fit-w, max(root.own-w, root.item.picture-width));
    init => {
        self.shown = true;
        keys.focus();
    }
    background: self.shown ? #000000eb : #00000000;
    animate background { duration: Appearance.slow; easing: ease-out; }
    TouchArea {
        clicked => { root.close(); }
        scroll-event(e) => {
            root.zoom-by(e.delta-y);
            return accept;
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            return reject;
        }
    }
    Rectangle {
        property <length> w: root.shown ? root.open-w * root.wheel : root.item.picture-width;
        width: self.w;
        height: self.w / root.ratio;
        x: (root.width - self.width) / 2 + root.pan-x;
        y: 62px + (root.height - 62px - 24px - self.height) / 2 + root.pan-y;
        border-radius: 10px;
        clip: true;
        opacity: root.shown ? 1 : 0;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        animate width, height, x, y { duration: 220ms * (Appearance.reduce-motion || pic-ta.pressed ? 0 : 1); easing: ease-out; }
        animate opacity { duration: Appearance.quick; }
        Image { width: parent.width; height: parent.height; source: root.has-full ? root.full-image : root.item.picture; image-fit: contain; }
        pic-ta := TouchArea {
            mouse-cursor: root.wheel > 1 ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.pointer;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.dragged = false;
                }
            }
            moved => {
                if (self.pressed && root.wheel > 1) {
                    root.dragged = true;
                    root.pan-x += self.mouse-x - self.pressed-x;
                    root.pan-y += self.mouse-y - self.pressed-y;
                }
            }
            scroll-event(e) => {
                root.zoom-by(e.delta-y);
                return accept;
            }
            clicked => {
                if (!root.dragged) {
                    root.wheel = 1;
                    root.pan-x = 0px;
                    root.pan-y = 0px;
                    root.zoomed = !root.zoomed;
                }
            }
        }
    }
    // Who sent it.
    HorizontalLayout {
        x: 16px;
        y: 12px;
        height: 40px;
        spacing: 10px;
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: Appearance.slow; }
        Rectangle {
            width: 36px;
            height: 36px;
            y: 2px;
            border-radius: 18px;
            clip: true;
            background: Theme.surface3;
            Image { width: 36px; height: 36px; source: root.item.avatar; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.item.author; color: root.item.has-author-color ? root.item.author-color : #ffffff; font-size: 14px; font-weight: 600; }
            Text { text: root.item.time; color: #ffffffb0; font-size: 12px; }
        }
    }
    // The tools, on a strip of glass.
    Rectangle {
        x: root.width - self.width - 64px;
        y: 12px;
        width: 5 * 36px + 8px;
        height: 40px;
        border-radius: 10px;
        background: #ffffff14;
        border-width: 1px;
        border-color: #ffffff29;
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: Appearance.slow; }
        TouchArea {}
        Sheen { x: 10px; y: 0; width: parent.width - 20px; }
        HorizontalLayout {
            padding-left: 4px;
            padding-top: 4px;
            spacing: 4px;
            IconButton { icon: root.zoomed ? Icons.zoom-out : Icons.zoom-in; clicked => { root.zoomed = !root.zoomed; } }
            IconButton { icon: Icons.forward; clicked => { root.forward(); } }
            IconButton { icon: Icons.download; clicked => { root.save(); } }
            IconButton { icon: Icons.external; clicked => { root.open-outside(); } }
            IconButton { icon: Icons.link; clicked => { root.copy-address(); } }
        }
    }
    Rectangle {
        x: root.width - self.width - 16px;
        y: 12px;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #ffffff14;
        border-width: 1px;
        border-color: #ffffff29;
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: Appearance.slow; }
        IconButton { x: 4px; y: 4px; icon: Icons.close; clicked => { root.close(); } }
    }
}

// A small notification in the corner of the screen: who, and what they wrote.
// The small window before the app opens: Nimbus looks for an update, and installs it if there is one.
export component SplashWindow inherits Window {
    // 0 checking, 1 downloading, 2 installing, 3 starting, 4 no connection.
    in property <int> phase;
    in property <float> progress;
    in property <string> detail;
    // No pulsing or sliding.
    in property <bool> still;
    // The window's size in plain numbers, for placing it.
    out property <float> width-px: self.width / 1px;
    out property <float> height-px: self.height / 1px;
    callback skip();
    callback drag();
    no-frame: true;
    title: "Nimbus";
    icon: @image-url("../assets/icon.png");
    width: 320px;
    height: 380px;
    background: #000000;
    property <bool> shown;
    property <float> wave: root.still ? 1 : (sin(animation-tick() / 2400ms * 360deg) + 1) / 2;
    init => { self.shown = true; }
    Rectangle { border-width: 1px; border-color: #1c1c1c; }
    // No frame to hold it by, so all of it moves the window.
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.drag(); }
        }
    }
    NimbusMark {
        x: (root.width - self.width) / 2;
        y: 72px;
        width: 88px;
        height: 88px;
        animated: !root.still;
        opacity: root.shown ? 0.6 + 0.4 * root.wave : 0;
    }
    Text {
        y: 176px;
        width: root.width;
        horizontal-alignment: center;
        text: "Nimbus";
        color: #ffffff;
        font-size: 20px;
        font-weight: 700;
    }
    Text {
        x: 24px;
        y: 268px;
        width: root.width - 48px;
        horizontal-alignment: center;
        text: root.phase == 1 ? @tr("" => "Скачиваю обновление")
            : root.phase == 2 ? @tr("" => "Устанавливаю обновление")
            : root.phase == 3 ? @tr("" => "Запускаю Nimbus")
            : root.phase == 4 ? @tr("" => "Нет связи с сервером обновлений")
            : @tr("" => "Проверяю обновления");
        color: #ffffff;
        font-size: 14px;
        font-weight: 500;
    }
    Rectangle {
        x: 32px;
        y: 298px;
        width: root.width - 64px;
        height: 3px;
        border-radius: 2px;
        background: #1c1c1c;
        clip: true;
        if root.phase == 1: Rectangle {
            x: 0;
            width: parent.width * root.progress;
            border-radius: 2px;
            background: #ffffff;
            animate width { duration: root.still ? 0ms : 120ms; }
        }
        if root.phase != 1: Rectangle {
            property <float> moved: root.still ? 0.3 : mod(animation-tick(), 1300ms) / 1300ms;
            x: parent.width * (1.4 * self.moved - 0.4);
            width: parent.width * 0.4;
            border-radius: 2px;
            background: #ffffff;
        }
    }
    Text {
        x: 24px;
        y: 310px;
        width: root.width - 48px;
        horizontal-alignment: center;
        text: root.detail;
        color: #a1a1a1;
        font-size: 12px;
        overflow: elide;
    }
    if root.phase == 1: Rectangle {
        x: (root.width - self.width) / 2;
        y: 332px;
        width: skip-label.preferred-width + 24px;
        height: 32px;
        border-radius: 8px;
        background: skip-area.has-hover ? #1a1a1a : transparent;
        skip-area := TouchArea { mouse-cursor: pointer; clicked => { root.skip(); } }
        skip-label := Text { text: @tr("" => "Пропустить"); color: #a1a1a1; font-size: 13px; font-weight: 500; }
    }
}

export component ToastWindow inherits Window {
    // The sender's name, or "Nimbus" when the settings hide who wrote.
    in property <string> heading;
    // The server and channel, or "Direct message".
    in property <string> place;
    in property <string> body;
    // More messages from this chat since it opened.
    in property <int> more;
    in property <image> avatar;
    in property <bool> has-avatar;
    // The first letter on grey, until the picture comes.
    in property <string> initial;
    // No face or letter: the settings hide who wrote.
    in property <bool> anonymous;
    // No fading or rising.
    in property <bool> still;
    callback clicked();
    callback gone();
    // The pointer came or left: the time to close stops or starts again.
    callback hovered(bool);
    no-frame: true;
    always-on-top: true;
    width: 360px;
    height: 96px;
    background: #0a0a0a;
    property <bool> arrived;
    property <bool> fresh;
    property <bool> leaving;
    // Starts the way in; a new message in the same window only changes the words.
    public function appear() {
        self.leaving = false;
        self.arrived = false;
        self.fresh = true;
    }
    public function leave() {
        self.leaving = true;
    }
    Timer {
        interval: 16ms;
        running: root.fresh;
        triggered => {
            root.fresh = false;
            root.arrived = true;
        }
    }
    Timer {
        interval: root.still ? 1ms : 120ms;
        running: root.leaving;
        triggered => {
            root.leaving = false;
            root.gone();
        }
    }
    Rectangle { border-width: 1px; border-color: #262626; border-radius: 8px; }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
    Rectangle {
        y: root.arrived && !root.leaving ? 0px : 6px;
        opacity: root.arrived && !root.leaving ? 1 : 0;
        animate y, opacity { duration: root.still ? 0ms : root.leaving ? 120ms : 160ms; easing: ease-out; }
        // Who wrote.
        Rectangle {
            x: 14px;
            y: 14px;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            clip: true;
            background: #2a2a2a;
            if root.has-avatar && !root.anonymous: Image { width: 40px; height: 40px; source: root.avatar; image-fit: cover; }
            if !root.has-avatar && !root.anonymous: Text { y: (parent.height - self.height) / 2 - self.font-size * 0.064; text: root.initial; color: #ffffff; font-size: 16px; font-weight: 600; }
            if root.anonymous: NimbusMark { x: 8px; y: 8px; width: 24px; height: 24px; }
        }
        Text {
            x: 66px;
            y: 12px;
            width: root.width - 66px - (root.more > 0 ? 76px : 40px);
            text: root.heading;
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            overflow: elide;
        }
        if root.more > 0: Rectangle {
            x: root.width - self.width - 38px;
            y: 12px;
            width: more-text.preferred-width + 12px;
            height: 18px;
            border-radius: 9px;
            background: #262626;
            more-text := Text { text: "+" + root.more; color: #ffffff; font-size: 11px; font-weight: 700; }
        }
        Text {
            x: 66px;
            y: 31px;
            width: root.width - 66px - 14px;
            text: root.place;
            color: #8a8a8a;
            font-size: 12px;
            overflow: elide;
        }
        Text {
            x: 66px;
            y: root.place == "" ? 34px : 49px;
            width: root.width - 66px - 14px;
            height: 38px;
            text: root.body;
            color: #dcdcdc;
            font-size: 13px;
            wrap: word-wrap;
            overflow: elide;
        }
    }
    // Over the rest, so it never opens the chat.
    if area.has-hover: Rectangle {
        x: root.width - self.width - 8px;
        y: 8px;
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: close-area.has-hover ? #262626 : transparent;
        close-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.leave(); }
        }
        Icon { x: 5px; y: 5px; width: 16px; height: 16px; commands: Icons.close; tint: #a1a1a1; }
    }
}
// One of the three buttons on the right of the title bar: thin pictures, red under the cursor for closing.
component CaptionButton inherits Rectangle {
    // 0 minimize, 1 maximize, 2 restore, 3 close
    in property <int> kind;
    callback clicked();
    width: 46px;
    background: ta.has-hover ? (root.kind == 3 ? #e5484d : Theme.wash) : transparent;
    animate background { duration: Appearance.quick; }
    ta := TouchArea { clicked => { root.clicked(); } }
    property <color> ink: ta.has-hover && root.kind == 3 ? #ffffff : (ta.has-hover ? Theme.text : Theme.text2);
    if root.kind == 0: Rectangle { width: 10px; height: 1px; background: root.ink; }
    if root.kind == 1: Rectangle { width: 10px; height: 10px; border-width: 1px; border-color: root.ink; }
    if root.kind == 2: Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: root.ink;
        stroke-width: 1px;
        commands: "M 2 2 L 2 0 L 10 0 L 10 8 L 8 8 M 0 2 L 8 2 L 8 10 L 0 10 Z";
    }
    if root.kind == 3: Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: root.ink;
        stroke-width: 1px;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
    }
}

// Our own title bar (the window has no Windows frame): drag to move, double click to maximize.
component TitleBar inherits Rectangle {
    in property <string> title;
    in property <bool> maximized;
    callback drag();
    callback minimize();
    callback maximize();
    callback close();
    callback inbox();
    callback back();
    callback ahead();
    in property <bool> can-back;
    in property <bool> can-ahead;
    // An update is downloaded and waits for the click; this says which.
    in property <string> update-text;
    callback install-update();
    height: 32px;
    background: Theme.pane0;
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.drag(); }
        }
        double-clicked => { root.maximize(); }
    }
    NimbusMark {
        x: 12px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        ink: Theme.text;
    }
    back-ta := TouchArea {
        x: 46px;
        width: 30px;
        enabled: root.can-back;
        clicked => { root.back(); }
    }
    Rectangle {
        x: back-ta.x;
        width: back-ta.width;
        background: back-ta.has-hover ? Theme.wash : transparent;
        animate background { duration: Appearance.quick; }
        Icon { width: 16px; height: 16px; commands: Icons.chevron-left; tint: root.can-back ? Theme.text2 : Theme.faint; }
    }
    ahead-ta := TouchArea {
        x: 76px;
        width: 30px;
        enabled: root.can-ahead;
        clicked => { root.ahead(); }
    }
    Rectangle {
        x: ahead-ta.x;
        width: ahead-ta.width;
        background: ahead-ta.has-hover ? Theme.wash : transparent;
        animate background { duration: Appearance.quick; }
        Icon { width: 16px; height: 16px; commands: Icons.chevron-right; tint: root.can-ahead ? Theme.text2 : Theme.faint; }
    }
    Text {
        x: 160px;
        width: parent.width - 320px;
        height: parent.height;
        text: root.title;
        color: Theme.text2;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    HorizontalLayout {
        alignment: end;
        Rectangle {
            width: 40px;
            background: inbox-ta.has-hover ? Theme.wash : transparent;
            animate background { duration: Appearance.quick; }
            inbox-ta := TouchArea { clicked => { root.inbox(); } }
            Icon { width: 16px; height: 16px; commands: Icons.inbox; tint: Theme.text2; }
        }
        if root.update-text != "": Rectangle {
            width: 40px;
            background: update-ta.has-hover ? Theme.wash : transparent;
            animate background { duration: Appearance.quick; }
            update-ta := TouchArea { mouse-cursor: pointer; clicked => { root.install-update(); } }
            Icon { width: 16px; height: 16px; commands: Icons.download; tint: Theme.green; }
            if update-ta.has-hover: Rectangle {
                x: parent.width - self.width;
                y: parent.height + 4px;
                width: update-tip.preferred-width + 20px;
                height: 28px;
                border-radius: 6px;
                background: Theme.surface0;
                border-width: 1px;
                border-color: Theme.wash;
                update-tip := Text { text: root.update-text; color: Theme.strong; font-size: 12px; font-weight: 600; }
            }
        }
        CaptionButton { kind: 0; clicked => { root.minimize(); } }
        CaptionButton { kind: root.maximized ? 2 : 1; clicked => { root.maximize(); } }
        CaptionButton { kind: 3; clicked => { root.close(); } }
    }
}

export component AppWindow inherits Window {
    title: root.title-prefix + root.window-title;
    no-frame: true;
    resize-border-width: 6px;
    callback window-drag();
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    // "(3) " while someone has mentioned us.
    in property <string> title-prefix;
    icon: Appearance.icon-current;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 560px;
    background: Theme.surface2;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    in property <string> window-title: "Nimbus";
    in property <[GuildItem]> guilds;
    in property <[RailItem]> rail;
    in property <[ChannelItem]> channels;
    in property <[MessageItem]> messages;
    // in-out so a click highlights right away, before the network answers.
    in-out property <string> selected-guild;
    in-out property <string> selected-channel;
    in property <string> sidebar-title;
    in property <string> channel-title;
    in property <string> channel-topic;
    in property <bool> channel-is-dm;
    in property <string> placeholder: @tr("" => "Написать сообщение");
    in property <string> me-name;
    in property <image> me-avatar;
    // What the person bought for their profile: a banner (or a colour in its place) behind the user card,
    // and a frame around the avatar.
    in property <image> me-banner;
    in property <bool> me-has-banner;
    in property <color> me-banner-color: transparent;
    in property <image> me-decoration;
    in property <bool> me-has-decoration;
    // The profile card (the popup over the user panel and the editor): the profile banner or its colour,
    // the names, the pronouns; the "about me" is `my-bio` and the status `my-status`.
    in property <string> me-username;
    in property <image> prof-banner;
    in property <bool> prof-has-banner;
    in property <bool> prof-has-color;
    in property <color> prof-color;
    in-out property <string> prof-global-name;
    in-out property <string> prof-pronouns;
    in-out property <bool> profile-edit-open;
    property <bool> profile-status-open;
    // "avatar", "banner" or "banner-clear": ask for a picture (or none) and send it to the profile.
    callback profile-picture-pick(string);
    callback profile-name-saved(string);
    callback profile-pronouns-saved(string);
    public function show-profile-popup() { profile-popup.show(); }
    public function open-profile-status() { root.profile-status-open = true; }
    in property <string> status: @tr("" => "Подключение…");
    in property <bool> online;
    // Shown over the chat when no channel is open, or when something failed.
    in property <string> notice: @tr("" => "Выбери канал или личную переписку слева");
    // The sound of the stream being watched, in percent (the slider on the stream).
    in-out property <float> stream-volume: 100;
    // A new version is ready: the bar at the top says so, one click installs it.
    in property <string> update-text;
    callback install-update();
    // The sign-in screen: shown while there is no saved account.
    in property <bool> login-needed;
    in property <string> login-error;
    callback web-login();

    // Voice: the channel you're in (empty when none) and who's there.
    in property <string> voice-channel;
    in property <string> voice-channel-name;
    in property <string> voice-status;
    in property <bool> voice-connected;
    in property <[VoiceMember]> voice-members;
    // The call is in a DM or group (Discord's voice only): no screen sharing there yet.
    in property <bool> voice-dm;
    // The people in that DM call in Discord's voice (a guild's are under its channel instead).
    in property <[VoiceMember]> call-people;
    // The panel switches flip here at once; Rust is told through switches-changed.
    in-out property <bool> mic-muted;
    in-out property <bool> deafened;
    // Lights up our avatar while the mic hears us.
    in property <bool> me-speaking;
    // A voice problem, shown in the voice panel until dismissed.
    in property <string> voice-error;
    in property <[DeviceItem]> mic-devices;
    in property <[DeviceItem]> speaker-devices;
    in property <[DeviceItem]> camera-devices;
    // Our camera is on in the call.
    in property <bool> camera-on;
    // The settings' look at our camera: never on when the settings open.
    in-out property <bool> camera-preview-on;
    in property <image> camera-preview-frame;
    in property <string> camera-preview-error;
    // Screen sharing: ours, and the stream we're watching.
    in property <bool> sharing;
    in property <[ShareSourceItem]> share-sources;
