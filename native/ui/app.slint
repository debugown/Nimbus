// Nimbus native prototype: no WebView, drawn by Slint on the GPU.
// Colours and sizes match the design tokens of the web version.

import { ListView } from "std-widgets.slint";

export struct GuildItem {
    id: string,
    name: string,
    initials: string,
    icon: image,
    has-icon: bool,
    // New messages somewhere (white pill) and mentions of you (red count).
    unread: bool,
    mentions: int,
    // Voice on this server, shown as a small badge on its icon: 0 nobody, 1 someone is in voice,
    // 2 someone is showing their screen, 3 you are in voice there, 4 you are showing your screen there.
    voice: int,
}

// A line of the server rail: a server, or a folder of servers.
export struct RailItem {
    // A folder's: its key as id, and what its servers have going on.
    item: GuildItem,
    folder: bool,
    open: bool,
    // The selected server is in this folder.
    selected: bool,
    // A server in an open folder, and the last of them.
    inside: bool,
    last: bool,
    // The servers drawn small on a closed folder.
    thumbs: [GuildItem],
}

export struct VoiceMember {
    identity: string,
    name: string,
    initial: string,
    avatar: image,
    has-avatar: bool,
    muted: bool,
    deafened: bool,
    speaking: bool,
    streaming: bool,
    // In Discord's own voice (official client), not in the Nimbus room.
    discord: bool,
    // The avatar frame (an extra picture over the avatar) the person bought; from avatar_decoration_data.
    decoration: image,
    has-decoration: bool,
}

// One tile of the call screen: a person, or someone's stream.
export struct CallTile {
    identity: string,
    name: string,
    initial: string,
    avatar: image,
    has-avatar: bool,
    muted: bool,
    deafened: bool,
    speaking: bool,
    discord: bool,
    // A stream tile ("watch stream") rather than the person.
    stream: bool,
    tint: color,
    // A Discord stream's still preview, shown until it's watched.
    preview: image,
    has-preview: bool,
    // The avatar frame (an extra picture over the avatar) the person bought; from avatar_decoration_data.
    decoration: image,
    has-decoration: bool,
    // A stream tile: being received now, and how well ("1080P 60 КАДРОВ В СЕКУНДУ").
    watched: bool,
    // Its sound button: silent here, whatever the other streams do.
    sound-off: bool,
    quality: string,
    // Their camera's newest picture (ours mirrored), or the stream's; without it the avatar or the preview shows.
    video: image,
    has-video: bool,
}

// kind: 0 = text channel or DM, 1 = voice channel, 2 = category header,
// 3 = a page of the DM list ("friends" or "requests" in `id`)
export struct ChannelItem {
    id: string,
    name: string,
    kind: int,
    clickable: bool,
    avatar: image,
    has-avatar: bool,
    // For voice channels: who sits there in Discord's own voice.
    people: [VoiceMember],
    // DMs: what they're playing, or a group's size.
    subtitle: string,
    // Presence dot on a DM's avatar: 0 none, 1 online, 2 idle, 3 do not disturb, 4 offline.
    status: int,
    // A red count: message requests on that page row, mentions on a channel or DM.
    badge: int,
    // New messages since you last read it: bold, with a pill.
    unread: bool,
    // Muted (or in a muted server): drawn dimmed.
    muted: bool,
    // A folded category's header, or a row under one.
    folded: bool,
}

// A line of the member list. kind: 0 = group header ("Админ — 6"), 1 = a member.
// status as in the DM list: 1 online, 2 idle, 3 do not disturb, 4 offline.
export struct MemberItem {
    kind: int,
    id: string,
    name: string,
    subtitle: string,
    status: int,
    color: color,
    has-color: bool,
    avatar: image,
    has-avatar: bool,
    // The avatar frame, drawn 1.25 times the avatar.
    decoration: image,
    has-decoration: bool,
    // The nameplate: a picture behind the whole row.
    plate: image,
    has-plate: bool,
}

// A message found by the chat search.
export struct FoundItem {
    channel: string,
    message: string,
    author: string,
    detail: string,
    text: string,
}

// A post of a forum channel.
export struct ForumPostItem {
    id: string,
    title: string,
    author: string,
    preview: string,
    // The top reaction and its count; empty when none.
    reaction: string,
    reactions: int,
    replies: int,
    when: string,
    image: image,
    has-image: bool,
    pinned: bool,
}

// A voice channel someone can be moved to.
export struct MoveTarget {
    id: string,
    name: string,
}

// A role in someone's menu: whether they have it, and whether we may change that.
export struct RoleItem {
    id: string,
    name: string,
    has: bool,
    editable: bool,
}

// What someone's right-click menu offers. The can-* rights are ours in their
// server (and only where it makes sense: muting needs them in voice).
export struct UserMenuInfo {
    id: string,
    name: string,
    me: bool,
    friend: bool,
    in-voice: bool,
    // Their volume for us, percent; 0 = muted for us.
    volume: float,
    can-mute: bool,
    can-deafen: bool,
    can-move: bool,
    can-kick: bool,
    can-ban: bool,
    server-muted: bool,
    server-deafened: bool,
    targets: [MoveTarget],
    // Our own note about them (only we see it); filled in once Discord has said it.
    note: string,
    in-guild: bool,
    blocked: bool,
    ignored: bool,
    // Kept on this PC: their soundboard sounds and their camera, not for us.
    sound-muted: bool,
    video-hidden: bool,
    // Our own name for a friend.
    friend-nick: string,
    // Their nickname in this server.
    nick: string,
    can-nick: bool,
    can-roles: bool,
    roles: [RoleItem],
    invite-guilds: [MoveTarget],
    // From a row of the DM list: that chat. A group has no person (`id` empty).
    group: bool,
    dm-channel: string,
    dm-unread: bool,
    dm-muted: bool,
    dm-pinned: bool,
    dm-favorite: bool,
    // In one encrypted call with us.
    can-code: bool,
    // Any of a moderator's rights here: their moderator view opens.
    can-moderate: bool,
    // Their Spotify track right now; empty when not listening.
    spotify-track: string,
    // What the open chat's apps can do to them.
    apps: [MoveTarget],
}

// A result in "Find or start a conversation". kind: 0 DM, 1 friend, 2 server, 3 channel
export struct SearchItem {
    kind: int,
    name: string,
    detail: string,
    initial: string,
}

// Someone on the friends or message-requests page.
// kind: 0 friend, 1 incoming friend request, 2 outgoing request, 3 message request (`id` is the channel)
export struct PersonItem {
    id: string,
    name: string,
    initial: string,
    subtitle: string,
    avatar: image,
    has-avatar: bool,
    status: int,
    kind: int,
}

// One block of a message. kind: 0 = text, 1 = code, 2 = quote,
// 3 = heading, 4 = link (url), 5 = spoiler (hidden until clicked)
export struct Block {
    kind: int,
    text: string,
    url: string,
    // Text and quotes drawn with bold, italics, code and links.
    styled: styled-text,
}

// One cell of the emoji panel: a character, or a server's emoji with its picture.
export struct EmojiItem {
    glyph: string,
    // What goes into the message box.
    insert: string,
    // What a reaction is called (the character, or name:id).
    key: string,
    image: image,
    has-image: bool,
}

// A name offered while typing @ or #.
export struct SuggestItem {
    label: string,
    detail: string,
}

// A line of the slash command panel: a section's header (a bot's, or the recent one), or a command.
// `y` is where it sits in the panel's list.
export struct SlashRow {
    header: bool,
    recent: bool,
    app: string,
    title: string,
    detail: string,
    bot: string,
    pills: [string],
    letter: string,
    icon: image,
    has-icon: bool,
    y: length,
}

// A bot in the slash panel's left strip (the first one is the recent section), and where its section starts.
export struct SlashApp {
    id: string,
    name: string,
    recent: bool,
    letter: string,
    icon: image,
    has-icon: bool,
    y: length,
}

// A soundboard tile, or a section's header (`header`). `x`/`y` place it in the panel's list.
export struct SoundItem {
    header: bool,
    id: string,
    guild: string,
    name: string,
    emoji: string,
    emoji-image: image,
    has-emoji-image: bool,
    // `name:id` of a server emoji, for its picture.
    emoji-key: string,
    x: length,
    y: length,
}

// A section icon in the soundboard's left strip: 0 recent, 1 a server, 2 Discord's own sounds.
export struct SoundSection {
    kind: int,
    name: string,
    letter: string,
    icon: image,
    has-icon: bool,
    y: length,
}

// A file or a link preview under a message. kind: 0 file, 1 link preview.
export struct CardItem {
    kind: int,
    title: string,
    text: string,
    url: string,
    color: color,
    has-color: bool,
}

// A server an invite leads to. state: 0 asking Discord, 1 known, 2 the invite is invalid or expired.
// guild: the server's id; joined: we are in it already.
export struct InviteItem {
    code: string,
    guild: string,
    name: string,
    initials: string,
    icon: image,
    has-icon: bool,
    counts: string,
    state: int,
    joined: bool,
}

// A reaction under a message. key: how Discord names it (the emoji, or name:id).
export struct ReactionItem {
    key: string,
    text: string,
    image: image,
    has-image: bool,
    count: int,
    me: bool,
}

// An emoji drawn as a picture (a server's emoji) or, until then or for plain ones, as text.
// key: name:id for a server's emoji, the character itself for a plain one.
export struct EmojiPic {
    key: string,
    text: string,
    image: image,
    has-image: bool,
}

// One answer of a poll. share: its part of all the votes, 0..1.
export struct PollAnswerItem {
    id: int,
    text: string,
    emoji: EmojiPic,
    count: int,
    share: float,
    me: bool,
}

// A poll under a message. ends: when it ends, as a date and time ("" when unknown).
export struct PollItem {
    question: string,
    answers: [PollAnswerItem],
    total: int,
    has-results: bool,
    multi: bool,
    ended: bool,
    ends: string,
}

// A bot's button or select menu under a message. kind: 0 a button, 1 a select menu.
// style (buttons): 1 primary, 2 secondary, 3 success, 4 danger, 5 link (opens url).
// pending: the click went to the bot and its answer hasn't come yet. summary: the chosen options' labels.
// usable: a select menu that can be opened here (the bot's own options). demo-open: opens itself (demo only).
export struct ComponentItem {
    kind: int,
    style: int,
    label: string,
    emoji: EmojiPic,
    custom-id: string,
    url: string,
    disabled: bool,
    pending: bool,
    placeholder: string,
    summary: string,
    usable: bool,
    demo-open: bool,
}

export struct ComponentRow {
    items: [ComponentItem],
}

// A server's scheduled event. when: "Сегодня, в 18:00" and the like; active: going on now.
// place-kind: 1 a stage channel, 2 a voice channel, 3 elsewhere (place is then its text). link: what "Поделиться"
// copies. mine: we made it (it can be cancelled from "⋯").
export struct EventItem {
    id: string,
    link: string,
    when: string,
    active: bool,
    name: string,
    description: string,
    place: string,
    place-kind: int,
    count: int,
    interested: bool,
    avatar: image,
    has-avatar: bool,
    initial: string,
    mine: bool,
}

// A channel a new event can be held in.
export struct EventChannelItem {
    id: string,
    name: string,
    stage: bool,
}

// A file waiting above the message box (pasted), sent with the next message.
export struct PendingFileItem {
    name: string,
    size: string,
    image: image,
    has-image: bool,
}

// One option of an open select menu.
export struct SelectOptionItem {
    label: string,
    value: string,
    description: string,
    emoji: EmojiPic,
    chosen: bool,
}

// The player of a voice message. bars: the waveform, 0..1; progress: how much was played, 0..1.
export struct VoiceClipItem {
    bars: [float],
    total: string,
    elapsed: string,
    progress: float,
    playing: bool,
}

// A person's card: over the chat, or in the panel beside a DM.
// A step of a badge that grows.
export struct BadgeTier {
    name: string,
    after: string,
    reached: bool,
}

// A badge on a profile, as Discord tells it; `heading` and `tiers` only for those that grow.
export struct BadgeItem {
    picture: image,
    has-picture: bool,
    heading: string,
    text: string,
    link: string,
    tiers: [BadgeTier],
}

export struct UserCardItem {
    id: string,
    name: string,
    username: string,
    pronouns: string,
    bio: string,
    // The server tag worn beside the username.
    tag: string,
    mutual: string,
    // The day the account was made.
    since: string,
    status: int,
    me: bool,
    avatar: image,
    banner: image,
    has-banner: bool,
    has-color: bool,
    banner-color: color,
    decoration: image,
    has-decoration: bool,
    badges: [BadgeItem],
}

// A line of a profile's mutual friends or servers.
export struct ProfileRow {
    id: string,
    name: string,
    avatar: image,
    has-avatar: bool,
}

// An account linked to a profile; `url` empty when it has no page to open.
export struct ProfileAccount {
    kind: string,
    name: string,
    url: string,
}

// What the profile window shows beyond the card.
export struct ProfileExtra {
    activity: string,
    friends-since: string,
    note: string,
    friend: bool,
    blocked: bool,
    accounts: [ProfileAccount],
    friends: [ProfileRow],
    servers: [ProfileRow],
}

export struct MessageItem {
    id: string,
    // Just arrived: it comes in with the animation from the settings.
    fresh: bool,
    // The picture at full size (what the viewer loads), and the file as it was sent.
    picture-full: string,
    picture-original: string,
    author-id: string,
    edited: bool,
    // Deleted while on screen: the row folds away (rows keep their places).
    deleted: bool,
    reactions: [ReactionItem],
    author: string,
    avatar: image,
    decoration: image,
    has-decoration: bool,
    time: string,
    short-time: string,
    blocks: [Block],
    grouped: bool,
    system: bool,
    // A line of the chat itself: its mark (see SystemLine in main.rs), its words around a name, a call to join.
    system-icon: int,
    system-what: string,
    system-whom: string,
    system-rest: string,
    system-call: bool,
    // The space is reserved right away; the picture itself arrives later.
    picture: image,
    has-picture: bool,
    picture-width: length,
    picture-height: length,
    // The message a search jumped to: it's marked, so you see where you landed.
    highlight: bool,
    // The author's name colour from their role.
    author-color: color,
    has-author-color: bool,
    cards: [CardItem],
    // The message names us: marked.
    mention: bool,
    pinned: bool,
    // A message of emoji only: drawn big.
    emojis: [EmojiPic],
    // A sticker: 0 none, 1 its picture, 2 only its name (stickers that can't be drawn here).
    sticker-kind: int,
    sticker: image,
    sticker-name: string,
    has-poll: bool,
    poll: PollItem,
    has-voice: bool,
    voice: VoiceClipItem,
    // Forwarded from another chat: the blocks are the original's, under a "Forwarded" line.
    forwarded: bool,
    // Invite links in the text, each as a small card of its server.
    invites: [InviteItem],
    // A bot's buttons and select menus, row by row.
    components: [ComponentRow],
    // Only we can see it (a bot's ephemeral answer).
    ephemeral: bool,
}

// One tile of the GIF panel: a GIF (url: what is sent) or a category (label: what it searches for).
export struct GifItem {
    key: string,
    url: string,
    label: string,
    category: bool,
    image: image,
    has-image: bool,
}

// A place a message can be forwarded to: a channel of the open server, or a DM.
export struct ForwardTarget {
    id: string,
    name: string,
    detail: string,
    dm: bool,
}

// The notification menu of a server (channel empty) or a channel. level: 0 all messages, 1 only mentions,
// 2 nothing; inherits: the channel has no choice of its own and follows the server.
export struct NotifyMenuInfo {
    guild: string,
    channel: string,
    name: string,
    level: int,
    inherits: bool,
    muted: bool,
}

// Settings → Внешний вид, Специальные возможности, Язык и время.
// A line of the changelog. kind: 0 version, 1 section, 2 item, 3 plain text.
export struct ChangelogLine {
    kind: int,
    text: string,
}

export global Appearance {
    // How big the text of messages is; 1.0 = the usual.
    in-out property <float> scale: 1.0;
    // Closer messages (smaller gaps between authors).
    in-out property <bool> compact: false;
    in-out property <bool> show-time: true;
    // No sliding and fading.
    in-out property <bool> reduce-motion: false;
    // How a new message comes in: 0 from the side, 1 side then typing, 2 fade and zoom.
    in-out property <int> message-anim: 2;
    // Brighter text and edges.
    in-out property <bool> contrast: false;
    // See-through panels over a soft coloured light, and a glow on what is active.
    in-out property <bool> glass: true;
    // 12-hour clock and the date as 2026-10-29 (the texts are made in Rust, so it applies to messages opened after).
    in-out property <bool> time12: false;
    in-out property <bool> date-iso: false;
    // A code of `Languages`; English until the person picks another (here, or on the sign-in screen).
    in-out property <string> language: "en";
    // This version is new here: the window that says so. The changelog also opens from the settings.
    in-out property <bool> updated-open;
    in-out property <bool> changelog-open;
    in property <[ChangelogLine]> changelog;
    in property <string> nimbus-version;
    callback language-picked(string);
    // 0 black, 1 graphite, 2 midnight, 3 light.
    in-out property <int> theme: 0;
    // 0 white (black on the light theme), 1 blue, 2 green, 3 pink, 4 orange.
    in-out property <int> accent: 0;
    // Hides private data and keeps notifications quiet (by hand, or while a screen is shown).
    in-out property <bool> streamer: false;
    in-out property <bool> streamer-auto: true;
    // While a screen is shown, Nimbus's window stays out of the stream and of screenshots.
    in-out property <bool> hide-from-capture: false;
    in-out property <bool> sharing: false;
    out property <bool> streamer-live: root.streamer || (root.streamer-auto && root.sharing);
    // The icon of the app: 0 as made, 1..3 other colours (made in Rust).
    in-out property <int> app-icon: 0;
    in-out property <image> icon-current: @image-url("../assets/icon.png");
    in property <[image]> icon-previews;
    out property <duration> quick: root.reduce-motion ? 0ms : 120ms;
    out property <duration> slow: root.reduce-motion ? 0ms : 160ms;
}

// Text helpers that live in Rust: Discord's time stamps (`<t:…>`) written out in local time.
// The languages offered, each in its own words.
global Languages {
    out property <[{ code: string, name: string, flag: image }]> all: [
        { code: "en", name: "English", flag: @image-url("../assets/flags/gb.svg") },
        { code: "ru", name: "Русский", flag: @image-url("../assets/flags/ru.svg") },
        { code: "uk", name: "Українська", flag: @image-url("../assets/flags/ua.svg") },
        { code: "es", name: "Español", flag: @image-url("../assets/flags/es.svg") },
        { code: "de", name: "Deutsch", flag: @image-url("../assets/flags/de.svg") },
        { code: "fr", name: "Français", flag: @image-url("../assets/flags/fr.svg") },
        { code: "pt", name: "Português (Brasil)", flag: @image-url("../assets/flags/br.svg") },
        { code: "pl", name: "Polski", flag: @image-url("../assets/flags/pl.svg") },
        { code: "tr", name: "Türkçe", flag: @image-url("../assets/flags/tr.svg") },
    ];
}

export global Fmt {
    pure callback stamps(string) -> string;
}

global Theme {
    // The light theme turns the shades around: dark ink on light grey and white.
    out property <bool> light: Appearance.theme == 3;
    out property <color> surface0: Appearance.theme == 1 ? #1e1f22 : Appearance.theme == 2 ? #0a0e1a : Appearance.theme == 3 ? #e3e5e8 : #000000;
    out property <color> surface1: Appearance.theme == 1 ? #2b2d31 : Appearance.theme == 2 ? #121829 : Appearance.theme == 3 ? #f2f3f5 : #000000;
    out property <color> surface2: Appearance.theme == 1 ? #313338 : Appearance.theme == 2 ? #0d1220 : Appearance.theme == 3 ? #ffffff : #000000;
    out property <color> surface3: Appearance.theme == 1 ? #383a40 : Appearance.theme == 2 ? #1d2540 : Appearance.theme == 3 ? #e6e8eb : #1a1a1a;
    // Raised boxes on the chat: link cards, the message box, code.
    // Plain buttons, and their hover.
    out property <color> button: Appearance.theme == 0 ? #141414 : Theme.surface3;
    out property <color> button-hover: Appearance.theme == 0 ? #222222 : Theme.light ? #d9dbdf : #4e5058;
    out property <color> card: Appearance.glass ? (Theme.light ? #0000000a : #ffffff0a) : Appearance.theme == 1 ? #2b2d31 : Appearance.theme == 2 ? #121829 : Appearance.theme == 3 ? #f2f3f5 : #0e0e10;
    // The big areas: see-through over the light behind them, when glass is on.
    out property <color> pane0: Appearance.glass ? transparent : Theme.surface0;
    out property <color> pane1: Appearance.glass ? transparent : Theme.surface1;
    out property <color> pane2: Appearance.glass ? transparent : Theme.surface2;
    // Windows over everything: dark enough to read on, whatever is behind.
    out property <color> glass-strong: !Appearance.glass ? (Theme.light ? #ffffff : Theme.surface1) : Theme.light ? #fffffffa : Appearance.theme == 1 ? #26282cfb : Appearance.theme == 2 ? #0e1322fb : #0a0a0afb;
    out property <color> glow: transparent;
    out property <color> ambient: Theme.light ? #00000010 : #ffffff14;
    out property <color> shadow: #000000b0;
    out property <brush> selected: Theme.active;
    out property <color> hover: Theme.light ? (Appearance.contrast ? #0000001c : #0000000c) : (Appearance.contrast ? #ffffff1c : #ffffff0f);
    out property <color> active: Theme.light ? (Appearance.contrast ? #0000002c : #00000016) : (Appearance.contrast ? #ffffff2c : #ffffff1a);
    out property <color> line: Theme.light ? (Appearance.contrast ? #00000050 : #0000001a) : (Appearance.contrast ? #ffffff40 : #ffffff12);
    out property <color> text: Theme.light ? (Appearance.contrast ? #000000 : #1c1d22) : (Appearance.contrast ? #ffffff : #ffffff);
    out property <color> text2: Theme.light ? (Appearance.contrast ? #1f2024 : #43444d) : (Appearance.contrast ? #e6e7ee : #a1a1a1);
    out property <color> muted: Theme.light ? (Appearance.contrast ? #45464f : #686a75) : (Appearance.contrast ? #b4b5c2 : #8a8a8a);
    out property <color> faint: Theme.light ? (Appearance.contrast ? #60616b : #8b8d97) : (Appearance.contrast ? #9293a0 : #6a6a6a);
    out property <color> body: Theme.light ? (Appearance.contrast ? #0b0b0e : #2a2b31) : (Appearance.contrast ? #f4f4f8 : #dcdcdc);
    // Menus and small popups over the window.
    out property <color> popup: Theme.light ? #ffffff : Appearance.theme == 0 ? #0a0a0a : #111214;
    // The edge of a popup or dialog.
    out property <color> edge: Theme.light ? #00000024 : #ffffff1f;
    // Plain white on dark surfaces; the strongest ink on light ones.
    out property <color> strong: Theme.light ? Theme.text : #ffffff;
    // A light wash over a surface (buttons, poll answers, revealed spoilers) and its hovered form.
    out property <color> wash: Theme.light ? #0000000d : #ffffff12;
    out property <color> wash-hover: Theme.light ? #0000001f : #ffffff30;
    // Links in messages.
    out property <color> link: Theme.light ? #111111 : #e5e5e5;
    out property <color> link-hover: Theme.light ? #000000 : #ffffff;
    out property <color> accent: Appearance.accent == 1 ? #4f8cff : Appearance.accent == 2 ? #2fb36e : Appearance.accent == 3 ? #e865a0 : Appearance.accent == 4 ? #f0883e : Theme.light ? #111111 : #f2f2f2;
    out property <color> on-accent: Appearance.accent == 0 ? (Theme.light ? #ffffff : #000000) : #ffffff;
    out property <color> accent-hover: Appearance.accent == 0 ? (Theme.light ? #333333 : #c8c8c8) : Theme.accent.darker(0.2);
    out property <color> green: #4ade80;
}

