    // A line of words asked for from someone's menu: "nick", "friend-nick"; "" none.
    property <string> prompt-kind;
    // Where the small stream was moved to; below zero, its usual corner.
    property <length> pip-x: -1px;
    property <length> pip-y: -1px;
    // Our note in someone's menu was left: whose, the text.
    callback note-saved(string, string);
    // The notification menu of a server (channel "") or a channel: Rust fills it, then shows it where the click was.
