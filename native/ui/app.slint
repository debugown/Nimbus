    in property <string> mute-key-name: @tr("" => "Не задана");
    in property <string> deafen-key-name: @tr("" => "Не задана");
    callback hotkey-picked(int, string, bool, bool, bool);
    // The global keys: the same as the buttons.
    public function hotkey-mute() {
        if (root.deafened) {
            root.deafened = false;
            root.mic-muted = false;
        } else {
            root.mic-muted = !root.mic-muted;
        }
        root.switches-changed(root.mic-muted, root.deafened);
    }
    public function hotkey-deafen() {
        root.deafened = !root.deafened;
        root.switches-changed(root.mic-muted, root.deafened);
    }
    // @ and # suggestions above the message box.
    in property <[SuggestItem]> suggest;
