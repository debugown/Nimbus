    // Joining by an invite: what's typed, then Discord's preview, then the join click.
    // join-state: 0 typing, 1 asking for the preview, 2 preview shown, 3 joining, 4 joined, 5 refused, 6 Discord wants its own check.
    in-out property <bool> join-open;
    in-out property <int> join-state;
    in-out property <string> join-text;
    in property <InviteItem> join-preview;
    in-out property <string> join-error;
    callback invite-lookup(string);
    callback invite-join(string);
    callback invite-official(string);
    public function open-join(code: string) {
        root.join-text = code;
        root.join-error = "";
        root.join-state = code == "" ? 0 : 1;
        root.join-open = true;
        if (code != "") {
            root.invite-lookup(code);
        }
    }
    // A new invite to a channel. made-invite-state: 0 none, 1 being made, 2 made, 3 refused.
    in-out property <int> made-invite-state;
    in-out property <string> made-invite-place;
    in property <string> made-invite-link;
    in property <string> made-invite-error;
    callback create-invite(string);
    // The same for a whole server: the bigger window, with friends to send the link to. `kind` of a
    // friend: 0 not yet, 1 being sent, 2 sent.
    in-out property <bool> invite-rich;
    in property <string> made-invite-channel;
    in property <[PersonItem]> invite-people;
    in-out property <string> invite-query;
    callback invite-to-guild(string);
    callback invite-friend(string, string);
    callback invite-search();
    function close-invite() {
        root.made-invite-state = 0;
        root.invite-rich = false;
    }
    // A new thread from a message (kind 1) or a new forum post (kind 2).
    in-out property <int> thread-dialog;
    in-out property <bool> thread-busy;
    in-out property <string> thread-error;
    property <string> thread-message;
    // What is typed in the window: the name (or title), and the post's text.
    in-out property <string> thread-draft;
    in-out property <string> thread-draft-text;
    callback create-thread(string, string);
    callback create-post(string, string, string);
    function open-thread-dialog(kind: int, message: string) {
        root.thread-message = message;
        root.thread-error = "";
        root.thread-busy = false;
        root.thread-draft = "";
        root.thread-draft-text = "";
        root.thread-dialog = kind;
    }
    // A voice message: 0 none, 1 recording, 2 being sent; the time so far, and whether the limit was reached.
    in-out property <int> rec-state;
    in property <string> rec-time: "0:00";
    in property <bool> rec-full;
    callback record-start();
    callback record-send();
    callback record-cancel();

    public function scroll-to-bottom() {
        message-list.content-y = min(0px, message-list.visible-height - message-list.content-height);
    }
    function follow-step() {
        let target = min(0px, message-list.visible-height - message-list.content-height);
        let left = target - message-list.content-y;
        message-list.content-y = Appearance.reduce-motion || abs(left) < 2px ? target : message-list.content-y + left * 0.28;
    }

    // The soft light the glass lies on: it stays still, so it costs nothing while nothing changes.
    if Appearance.glass && !root.watching: Rectangle {
        background: Theme.surface2;
        clip: true;
        Rectangle { x: (root.width - 1200px) / 2 + 160px; y: -520px; width: 1200px; height: 900px; background: @radial-gradient(circle, Theme.ambient 0%, #00000000 70%); }
    }
    // The space the panels at the bottom of the left column take, rail included.
    property <length> dock-height: 64px + (root.voice-error != "" ? 84px : root.voice-channel != "" ? 60px : 0px);
    // After a real sign-in, not an ordinary start: 1 the mark flies to the title bar, 2 the greeting,
    // 3 the greeting goes and the client comes in, 0 done. With less motion none of this runs.
    in-out property <bool> login-signing;
    property <int> welcome-step;
    changed login-needed => {
        if (!self.login-needed) {
            self.login-signing = false;
            if (!Appearance.reduce-motion) {
                self.welcome-step = 1;
            }
        }
    }
    changed login-error => {
        if (self.login-error != "") {
            self.login-signing = false;
        }
    }
    Timer {
        interval: 600ms;
        running: root.welcome-step == 1;
        triggered => { root.welcome-step = 2; }
    }
    Timer {
        interval: 2s;
        running: root.welcome-step == 2;
        triggered => { root.welcome-step = 3; }
    }
    Timer {
        interval: 700ms;
        running: root.welcome-step == 3;
        triggered => { root.welcome-step = 0; }
    }
    // Hidden behind the sign-in page and the greeting; then the parts come in one by one and rise a little.
    property <bool> client-hidden: root.login-needed || root.welcome-step == 1 || root.welcome-step == 2;
    property <duration> client-in: Appearance.reduce-motion ? 0ms : 260ms;
    // A new chat fades in: hidden for an instant, then it appears.
    property <bool> chat-hidden;
    public function chat-appear() {
        root.chat-hidden = true;
    }
    Timer {
        interval: 16ms;
        running: root.chat-hidden;
        triggered => { root.chat-hidden = false; }
    }
    // The same for the channels of a server just picked.
    property <bool> channels-hidden;
    changed selected-guild => {
        root.rail-refresh();
        self.channels-hidden = true;
    }
    Timer {
        interval: 16ms;
        running: root.channels-hidden;
        triggered => { root.channels-hidden = false; }
    }
    // Follows the end of the list smoothly for a moment: the list's height settles only after it is drawn.
    property <int> follow-ticks;
    public function follow-bottom() {
        root.follow-ticks = 30;
    }
    Timer {
        interval: 16ms;
        running: root.follow-ticks > 0;
        triggered => {
            root.follow-ticks -= 1;
            root.follow-step();
        }
    }
    property <RailItem> rail-drag;
    property <bool> rail-dragging;
    property <length> rail-drag-y;
    // The pointer's place on the rail, in lines; the first line (messages) stays first.
    property <float> rail-drag-line: (root.rail-drag-y - rail-list.y - rail-list.content-y) / 48px;
    property <int> rail-drop-row: clamp(floor(root.rail-drag-line), 1, max(1, root.rail.length - 1));
    property <float> rail-drop-part: clamp(root.rail-drag-line - root.rail-drop-row, 0, 1);
    property <int> rail-drop-zone: root.rail-drag.folder ? (root.rail-drop-part < 0.5 ? 0 : 2)
        : root.rail-drop-part < 0.25 ? 0 : root.rail-drop-part > 0.75 ? 2 : 1;
    HorizontalLayout {
        y: 32px + root.banner-h;
        height: root.height - 32px - root.banner-h;
        // Server rail
        rail-box := Rectangle {
            width: 72px;
            background: Theme.pane0;
            opacity: root.client-hidden ? 0 : 1;
            animate opacity { delay: 160ms; duration: root.client-in; easing: ease-out; }
            // Join a server by an invite.
            add-server := Rectangle {
                x: 16px;
                y: parent.height - 48px - root.dock-height;
                width: 40px;
                height: 40px;
                border-radius: 12px;
                background: add-area.has-hover ? #23a55a : Theme.surface3;
                animate border-radius, background { duration: Appearance.slow; easing: ease-out; }
                add-area := TouchArea { mouse-cursor: pointer; clicked => { root.open-join(""); } }
                Icon { width: 22px; height: 22px; commands: Icons.plus; tint: add-area.has-hover ? #fff : #23a55a; }
            }
            rail-list := ListView {
                height: parent.height - 56px - root.dock-height;
                y: root.client-hidden ? 10px : 0px;
                animate y { delay: 160ms; duration: root.client-in; easing: ease-out; }
                for r in root.rail: GuildButton {
                    item: r.item;
                    selected: r.selected || r.item.id == root.selected-guild;
                    folder: r.folder;
                    open: r.open;
                    inside: r.inside;
                    last: r.last;
                    thumbs: r.thumbs;
                    draggable: r.item.id != "@me";
                    opacity: root.rail-dragging && root.rail-drag.item.id == r.item.id ? 0.35 : 1;
                    menu(x, y) => {
                        if (r.item.id != "@me" && !r.folder) {
                            root.open-notify-menu(r.item.id, "", x, y);
                        }
                    }
                    clicked => {
                        if (r.folder) {
                            root.rail-toggle(r.item.id);
                            return;
                        }
                        root.selected-guild = r.item.id;
                        root.people-page = 0;
                        root.forum-open = false;
                        root.guild-clicked(r.item.id);
                    }
                    drag-begin => {
                        root.rail-drag = r;
                        root.rail-dragging = true;
                    }
                    drag-at(x, y) => {
                        root.rail-drag-y = y - rail-box.absolute-position.y;
                    }
                    drag-end(drop) => {
                        root.rail-dragging = false;
                        if (drop) {
                            root.rail-drop(r.item.id, root.rail-drop-row, root.rail-drop-zone);
                        }
                    }
                }
            }
            // Where it will land: a ring around a line to go into, or a bar between two lines.
            if root.rail-dragging && root.rail-drop-zone == 1: Rectangle {
                x: 12px;
                y: rail-list.y + rail-list.content-y + 48px * root.rail-drop-row;
                width: 48px;
                height: 48px;
                border-radius: 14px;
                border-width: 2px;
                border-color: Theme.accent;
            }
            if root.rail-dragging && root.rail-drop-zone != 1: Rectangle {
                x: 12px;
                y: rail-list.y + rail-list.content-y + 48px * (root.rail-drop-row + (root.rail-drop-zone == 2 ? 1 : 0)) - 1px;
                width: 48px;
                height: 3px;
                border-radius: 2px;
                background: Theme.accent;
            }
            // What is being dragged, under the pointer.
            if root.rail-dragging: GuildButton {
                y: root.rail-drag-y - 24px;
                width: 72px;
                item: root.rail-drag.item;
                folder: root.rail-drag.folder;
                thumbs: root.rail-drag.thumbs;
                opacity: 0.85;
            }
        }

        // Sidebar: server name, channels, user panel
        Rectangle {
            width: root.sidebar-width;
            background: Theme.pane0;
            opacity: root.client-hidden ? 0 : 1;
            animate opacity { delay: 260ms; duration: root.client-in; easing: ease-out; }
            Rectangle {
            y: root.client-hidden ? 10px : 0px;
            animate y { delay: 260ms; duration: root.client-in; easing: ease-out; }
            background: Theme.pane1;
            VerticalLayout {
                Rectangle {
                    height: root.selected-guild != "@me" && root.has-guild-banner ? 136px : 48px;
                    clip: true;
                    // A server's banner fills the header, its name over it.
                    if root.selected-guild != "@me" && root.has-guild-banner: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.guild-banner;
                        image-fit: cover;
                    }
                    if root.selected-guild != "@me" && root.has-guild-banner: Rectangle {
                        height: 56px;
                        y: 0;
                        background: @linear-gradient(180deg, #000000b0 0%, #00000000 100%);
                    }
                    // On the DM side, Discord's search field instead of a title.
                    if root.selected-guild == "@me": Rectangle {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 32px;
                        border-radius: 8px;
                        background: find-area.has-hover ? Theme.button-hover : Theme.button;
                        animate background { duration: Appearance.quick; }
                        find-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-search(); }
                        }
                        Text {
                            text: @tr("" => "Найти или начать беседу");
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 500;
                        }
                    }
                    if root.selected-guild != "@me": Text {
                        x: 16px;
                        y: 0;
                        width: parent.width - 48px;
                        height: 48px;
                        text: root.sidebar-title;
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.selected-guild != "@me": Icon { x: parent.width - 30px; y: 15px; width: 18px; height: 18px; commands: Icons.chevron; tint: Theme.text2; }
                    if root.selected-guild != "@me": TouchArea {
                        y: 0;
                        height: 48px;
                        mouse-cursor: pointer;
                        clicked => { server-menu.show(); }
                    }
                    server-menu := PopupWindow {
                        x: 8px;
                        y: 44px;
                        width: 232px;
                        height: server-menu-body.preferred-height;
                        close-policy: close-on-click-outside;
                        Rectangle {
                            property <bool> menu-shown;
                            init => { self.menu-shown = true; }
                            opacity: self.menu-shown ? 1 : 0;
                            animate opacity { duration: Appearance.quick; easing: ease-out; }
                            background: Theme.popup;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.edge;
                            server-menu-body := VerticalLayout {
                                padding: 6px;
                                MenuItem {
                                    text: @tr("" => "Пригласить на сервер");
                                    clicked => {
                                        root.made-invite-place = root.sidebar-title;
                                        root.made-invite-state = 1;
                                        root.create-invite(root.selected-channel);
                                        server-menu.close();
                                    }
                                }
                                MenuItem {
                                    text: @tr("" => "Мероприятия");
                                    clicked => {
                                        root.events-open = true;
                                        root.events-opened();
                                        server-menu.close();
                                    }
                                }
                                MenuItem {
                                    text: @tr("" => "Параметры уведомлений");
                                    clicked => {
                                        root.open-notify-menu(root.selected-guild, "", 90px, 90px);
                                        server-menu.close();
                                    }
                                }
                                MenuLine {}
                                MenuItem {
                                    text: @tr("" => "Копировать ID сервера");
                                    clicked => {
                                        root.copy-text(root.selected-guild);
                                        server-menu.close();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                }
                // The server's scheduled events: "Мероприятия", or how many there are.
                if root.selected-guild != "@me": VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 8px;
                    spacing: 8px;
                    Rectangle {
                        height: 34px;
                        border-radius: 4px;
                        background: events-row-area.has-hover ? Theme.hover : transparent;
                        events-row-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.events-open = true;
                                root.events-opened();
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon { width: 20px; height: 20px; commands: Icons.calendar; tint: events-row-area.has-hover ? Theme.text : Theme.muted; }
                            }
                            Text {
                                text: root.events-title;
                                color: root.events.length > 0 ? Theme.text : (events-row-area.has-hover ? Theme.text : Theme.muted);
                                font-size: 15px;
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                }
                VerticalLayout {
                    vertical-stretch: 1;
                    padding-left: 8px;
                    padding-right: 4px;
                    padding-top: 4px;
                    ListView {
                        opacity: root.channels-hidden ? 0 : 1;
                        animate opacity { duration: root.channels-hidden ? 0ms : Appearance.slow; easing: ease-out; }
                        for c in root.channels: ChannelRow {
                            item: c;
                            selected: c.id == root.selected-channel;
                            connected: c.id == root.voice-channel;
                            members: root.voice-members;
                            watch(identity) => {
                                root.show-call = true;
                                root.call-grid = false;
                                root.watched-identity = identity;
                                root.watch-stream(identity);
                            }
                            user-menu(id, x, y) => { root.open-user-menu(id, x, y); }
                            menu(x, y) => {
                                if (root.selected-guild != "@me") {
                                    root.open-notify-menu(root.selected-guild, c.id, x, y);
                                } else {
                                    root.open-dm-menu(c.id, x, y);
                                }
                            }
                            clicked => {
                                if (c.kind == 2) {
                                    root.category-toggled(c.id);
                                } else if (c.kind == 1) {
                                    root.show-call = true;
                                    root.voice-clicked(c.id);
                                } else {
                                    root.show-call = false;
                                    root.forum-open = false;
                                    root.people-page = c.kind == 3 ? (c.id == "friends" ? 1 : 2) : 0;
                                    root.selected-channel = c.id;
                                    root.channel-clicked(c.id);
                                }
                            }
                        }
                    }
                }
                if root.voice-channel != "" || root.voice-error != "": Rectangle {
                    height: root.voice-error != "" ? 84px : 60px;
                    Rectangle {
                    x: -64px;
                    y: 0px;
                    width: parent.width + 56px;
                    height: parent.height;
                    border-radius: 8px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.line;
                    Sheen { x: 12px; y: 0; width: parent.width - 24px; }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 2px;
                        VerticalLayout {
                            padding-right: 6px;
                            alignment: center;
                            Icon {
                                commands: Icons.signal;
                                tint: root.voice-error != "" ? #f04a55 : (root.voice-connected ? Theme.green : #f0b232);
                                width: 18px;
                                height: 18px;
                            }
                        }
                        VerticalLayout {
                            padding-right: 4px;
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.voice-error != "" ? @tr("" => "Голос не работает") : root.voice-status;
                                color: root.voice-error != "" ? #f04a55 : (root.voice-connected ? Theme.green : #f0b232);
                                font-size: 13px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: root.voice-error != "" ? root.voice-error : root.voice-channel-name + root.voice-ping;
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: root.voice-error != "" ? word-wrap : no-wrap;
                                overflow: elide;
                            }
                        }
                        // No sharing in a DM call (the call screen says so).
                        if root.voice-connected && !root.voice-dm: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 8px;
                                background: root.sharing ? Theme.accent : (share-area.has-hover ? Theme.hover : transparent);
                                // Click: pick what to show, or stop showing. Right-click while
                                // showing: switch to something else.
                                share-area := TouchArea {
                                    clicked => {
                                        if (root.sharing) {
                                            stream-menu.show();
                                        } else {
                                            root.share-sources-requested();
                                            root.share-picker-open = true;
                                        }
                                    }
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                            root.share-sources-requested();
                                            root.share-picker-open = true;
                                        }
                                    }
                                }
                                Icon {
                                    x: 4px;
                                    y: 4px;
                                    commands: Icons.screen;
                                    tint: root.sharing ? Theme.on-accent : Theme.text2;
                                }
                            }
                        }
                        // The soundboard: only in a call, with the mic and sound on (as in Discord).
                        if root.voice-connected: VerticalLayout {
                            alignment: center;
                            IconButton {
                                width: 28px;
                                height: 28px;
                                icon: Icons.soundboard;
                                disabled: !root.soundboard-usable;
                                lit: root.soundboard-open;
                                clicked => {
                                    if (root.soundboard-usable) {
                                        root.sound-text = "";
                                        root.soundboard-open = !root.soundboard-open;
                                        if (root.soundboard-open) {
                                            root.soundboard-opened();
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                width: 28px;
                                height: 28px;
                                icon: Icons.hangup;
                                filled: true;
                                clicked => { root.voice-leave(); }
                            }
                        }
                    }
                    }
                }
                Rectangle {
                    height: 64px;
                    Rectangle {
                    x: -64px;
                    y: 8px;
                    width: parent.width + 56px;
                    height: 48px;
                    border-radius: 8px;
                    clip: true;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.line;
                    Sheen { x: 12px; y: 0; width: parent.width - 24px; }
                    // The nameplate as Discord made it, stretched over the whole card.
                    if root.me-has-banner: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.me-banner;
                        image-fit: fill;
                    }
                    // A click on the avatar or the name opens the profile card; the buttons on the right keep their own.
                    TouchArea {
                        x: 0;
                        y: 0;
                        width: parent.width - 124px;
                        height: parent.height;
                        mouse-cursor: pointer;
                        clicked => { root.profile-status-open = false; profile-popup.show(); }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                // Green ring while the mic hears us.
                                Rectangle {
                                    x: -3px;
                                    y: -3px;
                                    width: 38px;
                                    height: 38px;
                                    border-radius: 19px;
                                    background: root.me-speaking ? Theme.green : transparent;
                                }
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    clip: true;
                                    background: Theme.surface3;
                                    Image { width: 32px; height: 32px; source: root.me-avatar; }
                                }
                                // The avatar frame: a little larger than the avatar, as in Discord.
                                if root.me-has-decoration: Image {
                                    x: -4px;
                                    y: -4px;
                                    width: 40px;
                                    height: 40px;
                                    source: root.me-decoration;
                                }
                                Rectangle {
                                    x: 21px;
                                    y: 21px;
                                    width: 13px;
                                    height: 13px;
                                    border-radius: 6.5px;
                                    border-width: 3px;
                                    border-color: Theme.surface0;
                                    // Our own status once connected: idle yellow, do not disturb red, invisible grey.
                                    background: !root.online ? Theme.faint : root.my-status == 1 ? #f0b232 : root.my-status == 2 ? #f23f43 : root.my-status == 3 ? #80848e : Theme.green;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: root.me-name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                            // Connected: the custom status line, or the status itself; otherwise how the connection stands.
                            Text {
                                text: !root.online ? root.status
                                    : root.my-custom-status != "" ? root.my-custom-status
                                    : root.my-status == 1 ? @tr("" => "Неактивен") : root.my-status == 2 ? @tr("" => "Не беспокоить") : root.my-status == 3 ? @tr("" => "Невидимый") : root.status;
                                color: Theme.muted;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                width: 28px;
                                height: 28px;
                                icon: root.mic-muted || root.deafened || !root.ptt-open ? Icons.mic-off : Icons.mic;
                                off: root.mic-muted || root.deafened || !root.ptt-open;
                                secondary-clicked => {
                                    root.devices-requested();
                                    mic-menu.show();
                                }
                                clicked => {
                                    // Turning the mic on while deafened turns sound back on too.
                                    if (root.deafened) {
                                        root.deafened = false;
                                        root.mic-muted = false;
                                    } else {
                                        root.mic-muted = !root.mic-muted;
                                    }
                                    root.switches-changed(root.mic-muted, root.deafened);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                width: 28px;
                                height: 28px;
                                icon: root.deafened ? Icons.headphones-off : Icons.headphones;
                                off: root.deafened;
                                secondary-clicked => {
                                    root.devices-requested();
                                    speaker-menu.show();
                                }
                                clicked => {
                                    root.deafened = !root.deafened;
                                    root.switches-changed(root.mic-muted, root.deafened);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                width: 28px;
                                height: 28px;
                                icon: Icons.gear;
                                clicked => {
                                    root.devices-requested();
                                    root.settings-open = true;
                                }
                            }
                        }
                    }
                    }
                    profile-popup := PopupWindow {
                        // 12 px of margin around the card, for its shadow.
                        x: -64px - 12px;
                        y: -self.height - 6px + 12px;
                        width: root.profile-status-open ? 12px + 340px + 8px + 272px + 12px : 340px + 24px;
                        height: 12px + pcard.height + 8px + 81px + 8px + 40px + 12px + 12px;
                        Rectangle {
                            property <bool> menu-shown;
                            init => { self.menu-shown = true; }
                            opacity: self.menu-shown ? 1 : 0;
                            animate opacity { duration: Appearance.quick; easing: ease-out; }
                            x: 12px;
                            y: 12px;
                            width: 340px;
                            height: parent.height - 24px;
                            background: Theme.glass-strong;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.edge;
                            drop-shadow-blur: 24px;
                            drop-shadow-color: Theme.shadow;
                            drop-shadow-offset-y: 6px;
                            clip: true;
                            pcard := ProfileCard {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                banner: root.prof-banner;
                                has-banner: root.prof-has-banner;
                                has-color: root.prof-has-color;
                                banner-color: root.prof-color;
                                avatar: root.me-avatar;
                                decoration: root.me-decoration;
                                has-decoration: root.me-has-decoration;
                                name: root.me-name;
                                username: root.me-username;
                                pronouns: root.prof-pronouns;
                                bio: root.my-bio;
                                status: root.my-status;
                                custom-status: root.my-custom-status;
                                avatar-clicked => { profile-popup.close(); root.profile-edit-open = true; }
                                bubble-clicked => { profile-popup.close(); root.profile-edit-open = true; }
                            }
                            // Two blocks of rows, a thin line between the rows of a block.
                            Rectangle {
                                x: 12px;
                                y: pcard.height + 8px;
                                width: parent.width - 24px;
                                height: 81px;
                                background: Theme.surface3;
                                border-radius: 8px;
                                clip: true;
                                VerticalLayout {
                                    MenuRow {
                                        icon: Icons.edit;
                                        text: @tr("" => "Редактировать профиль");
                                        clicked => { profile-popup.close(); root.profile-edit-open = true; }
                                        changed hovered => { if (self.hovered) { root.profile-status-open = false; } }
                                        Icon { x: parent.width - 32px; y: 11px; width: 18px; height: 18px; commands: Icons.chevron-right; tint: Theme.text2; }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    MenuRow {
                                        text: root.my-status == 0 ? @tr("" => "В сети") : root.my-status == 1 ? @tr("" => "Неактивен") : root.my-status == 2 ? @tr("" => "Не беспокоить") : @tr("" => "Невидимый");
                                        clicked => { root.profile-status-open = !root.profile-status-open; }
                                        // Like a menu: pointing at the row opens the list next to it.
                                        changed hovered => { if (self.hovered) { root.profile-status-open = true; } }
                                        PresenceDot { x: 14px; y: 13px; width: 14px; height: 14px; status: root.my-status; }
                                        Icon { x: parent.width - 32px; y: 11px; width: 18px; height: 18px; commands: Icons.chevron-right; tint: Theme.text2; }
                                    }
                                }
                            }
                            Rectangle {
                                x: 12px;
                                y: pcard.height + 8px + 81px + 8px;
                                width: parent.width - 24px;
                                height: 40px;
                                background: Theme.surface3;
                                border-radius: 8px;
                                clip: true;
                                MenuRow {
                                    icon: Icons.id-card;
                                    text: @tr("" => "Копировать ID пользователя");
                                    clicked => { root.user-action("copy-id", root.me-id); profile-popup.close(); }
                                    changed hovered => { if (self.hovered) { root.profile-status-open = false; } }
                                }
                            }
                        }
                        // The status list: its own panel to the right of the row, lined up with the row's lower edge.
                        if root.profile-status-open: Rectangle {
                            x: 12px + 340px + 8px;
                            y: 12px + pcard.height + 8px + 81px - self.height;
                            width: 272px;
                            height: 40px + 9px + 40px + 56px + 56px + 16px;
                            background: Theme.glass-strong;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.edge;
                            drop-shadow-blur: 24px;
                            drop-shadow-color: Theme.shadow;
                            drop-shadow-offset-y: 6px;
                            VerticalLayout {
                                padding: 8px;
                                MenuRow {
                                    text: @tr("" => "В сети");
                                    pad: 40px;
                                    clicked => { root.my-status = 0; root.privacy-changed("status", 0); profile-popup.close(); }
                                    PresenceDot { x: 14px; y: 13px; width: 14px; height: 14px; status: 0; }
                                }
                                // The current state apart from the other choices, as in a menu.
                                Rectangle { height: 9px; Rectangle { x: 8px; width: parent.width - 16px; height: 1px; background: Theme.line; } }
                                MenuRow {
                                    text: @tr("" => "Неактивен");
                                    pad: 40px;
                                    clicked => { root.my-status = 1; root.privacy-changed("status", 1); profile-popup.close(); }
                                    PresenceDot { x: 14px; y: 13px; width: 14px; height: 14px; status: 1; }
                                }
                                MenuRow {
                                    height: 56px;
                                    text: @tr("" => "Не беспокоить");
                                    hint: @tr("" => "Уведомления отключены");
                                    pad: 40px;
                                    clicked => { root.my-status = 2; root.privacy-changed("status", 2); profile-popup.close(); }
                                    PresenceDot { x: 14px; y: 21px; width: 14px; height: 14px; status: 2; }
                                }
                                MenuRow {
                                    height: 56px;
                                    text: @tr("" => "Невидимый");
                                    hint: @tr("" => "Ты в сети, но показываешься как не в сети");
                                    pad: 40px;
                                    clicked => { root.my-status = 3; root.privacy-changed("status", 3); profile-popup.close(); }
                                    PresenceDot { x: 14px; y: 21px; width: 14px; height: 14px; status: 3; }
                                }
                            }
                        }
                    }
                    mic-menu := DeviceMenu {
                        x: 8px;
                        y: -self.height - 6px;
                        title: @tr("" => "УСТРОЙСТВО ВВОДА");
                        devices: root.mic-devices;
                        picked(index) => { root.mic-device-selected(index); }
                    }
                    speaker-menu := DeviceMenu {
                        x: 8px;
                        y: -self.height - 6px;
                        title: @tr("" => "УСТРОЙСТВО ВЫВОДА");
                        devices: root.speaker-devices;
                        picked(index) => { root.speaker-device-selected(index); }
                    }
                    stream-menu := StreamMenu {
                        x: 8px;
                        y: -self.height - 58px;
                        watching: root.watching;
                        watching-name: root.stream-name;
                        sound: root.share-sound;
                        stop-watching => { root.stop-watching(); }
                        stop => { root.stop-share(); }
                        change => {
                            root.share-sources-requested();
                            root.share-picker-open = true;
                        }
                        toggle-sound => { root.share-sound = !root.share-sound; }
                    }
                }
            }
            }
        }

        // Chat
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.pane2;
            opacity: root.client-hidden ? 0 : 1;
            animate opacity { delay: 360ms; duration: root.client-in; easing: ease-out; }
            Rectangle { x: 0; width: 1px; background: Theme.line; }
            VerticalLayout {
                y: root.client-hidden ? 10px : 0px;
                animate y { delay: 360ms; duration: root.client-in; easing: ease-out; }
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        if root.channel-is-dm && root.dm-card.id != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                clip: true;
                                background: Theme.surface3;
                                Image { width: 24px; height: 24px; source: root.dm-card.avatar; }
                            }
                        }
                        if !root.channel-is-dm || root.dm-card.id == "": VerticalLayout {
                            alignment: center;
                            Icon {
                                commands: root.channel-is-dm ? Icons.chat : Icons.hash;
                                tint: Theme.muted;
                                width: 22px;
                                height: 22px;
                            }
                        }
                        Text { text: root.channel-title; color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; }
                        Text {
                            horizontal-stretch: 1;
                            text: root.channel-topic;
                            color: Theme.muted;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // Show or hide the member list.
                        if root.members-open: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 6px;
                                background: members-area.has-hover ? Theme.hover : transparent;
                                members-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.members-shown = !root.members-shown;
                                        root.members-toggled(root.members-shown);
                                    }
                                }
                                Icon { x: 5px; y: 5px; width: 20px; height: 20px; commands: Icons.friends; tint: root.members-shown ? Theme.text : Theme.muted; }
                            }
                        }
                        // Start a call in this DM or group (rings the others once); hidden while we're in it.
                        if root.channel-is-dm && root.people-page == 0 && root.voice-channel != root.selected-channel: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 6px;
                                background: call-area.has-hover ? Theme.hover : transparent;
                                call-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-call = true;
                                        root.dm-call-start(true);
                                    }
                                }
                                Icon { x: 5px; y: 5px; width: 20px; height: 20px; commands: Icons.phone; tint: call-area.has-hover ? Theme.text : Theme.text2; }
                            }
                        }
                        // The same with the camera on: it turns on only after this click, once the call is connected.
                        if root.channel-is-dm && root.people-page == 0 && root.voice-channel != root.selected-channel: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 6px;
                                background: video-area.has-hover ? Theme.hover : transparent;
                                animate background { duration: Appearance.quick; }
                                video-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.video-after-connect = true;
                                        root.show-call = true;
                                        root.dm-call-start(true);
                                    }
                                }
                                Icon { x: 5px; y: 5px; width: 20px; height: 20px; commands: Icons.camera; tint: video-area.has-hover ? Theme.text : Theme.text2; }
                            }
                        }
                        // Pinned messages.
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 6px;
                                background: pins-area.has-hover ? Theme.hover : transparent;
                                pins-area := TouchArea { mouse-cursor: pointer; clicked => { root.show-pins(); } }
                                Icon { x: 5px; y: 5px; width: 20px; height: 20px; commands: Icons.pin; tint: pins-area.has-hover ? Theme.text : Theme.muted; }
                            }
                        }
                        // The other person's panel beside a DM.
                        if root.channel-is-dm && root.people-page == 0 && root.dm-card.id != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 6px;
                                background: root.dm-panel-shown ? Theme.active : (panel-area.has-hover ? Theme.hover : transparent);
                                animate background { duration: Appearance.quick; }
                                panel-area := TouchArea { mouse-cursor: pointer; clicked => { root.dm-panel-shown = !root.dm-panel-shown; } }
                                Icon { x: 5px; y: 5px; width: 20px; height: 20px; commands: Icons.user; tint: root.dm-panel-shown || panel-area.has-hover ? Theme.text : Theme.muted; }
                            }
                        }
                        // Search the messages of this server (or DM).
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: search-input.has-focus ? 260px : 190px;
                                height: 28px;
                                border-radius: 8px;
                                background: Theme.card;
                                border-width: 1px;
                                border-color: Theme.line;
                                animate width { duration: Appearance.quick; }
                                search-input := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    single-line: true;
                                    vertical-alignment: center;
                                    color: Theme.text;
                                    font-size: 13px;
                                    accepted => {
                                        root.found-open = self.text != "";
                                        root.find-messages(self.text);
                                    }
                                }
                                Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    visible: search-input.text == "";
                                    text: root.selected-guild == "@me" ? (root.channel-is-dm ? @tr("" => "Искать «{}»", root.channel-title) : @tr("" => "Поиск в переписке")) : @tr("" => "Искать на сервере");
                                    color: Theme.faint;
                                    font-size: 13px;
                                }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                }

                message-list := ListView {
                    opacity: root.chat-hidden ? 0 : 1;
                    animate opacity { duration: root.chat-hidden ? 0ms : Appearance.slow; easing: ease-out; }
                    vertical-stretch: 2;
                    for m in root.messages: MessageRow {
                        item: m;
                        open-link(url) => { root.open-link(url); }
                        pointer-at(x, y) => {
                            root.pointer-x = x;
                            root.pointer-y = y;
                        }
                        open-image(i) => { root.open-image(i); }
                        quick-react(id) => { root.open-emoji(id); }
                        quick-reply(id) => {
                            root.editing = "";
                            root.replying = id;
                        }
                        quick-forward(id) => {
                            root.forwarding = true;
                            root.forward-open(id);
                        }
                        user-card(id, x, y) => { root.open-user-card(id, x, y); }
                        react(id, key) => { root.react(id, key); }
                        poll-vote(id, answer) => { root.poll-vote(id, answer); }
                        component-click(id, custom) => { root.component-click(id, custom); }
                        select-open(id, custom, x, y, w) => { root.open-select(id, custom, x, y, w); }
                        voice-play(id) => { root.voice-play(id); }
                        join-call => { root.dm-call-start(false); }
                        user-menu(id, x, y) => { root.open-user-menu(id, x, y); }
                        message-menu(id, author, pinned, x, y) => { root.open-message-menu(id, author, pinned, x, y); }
                        open-invite(code) => { root.open-join(code); }
                        open-server(guild) => {
                            root.selected-guild = guild;
                            root.people-page = 0;
                            root.forum-open = false;
                            root.guild-clicked(guild);
                        }
                    }
                }

                Rectangle {
                    property <length> files-h: root.pending-files.length > 0 ? 236px : 0px;
                    height: 72px + self.files-h;
                    // Pasted files waiting to go with the message: a card each, over the box.
                    if root.pending-files.length > 0: Rectangle {
                        x: 16px;
                        y: 8px;
                        width: parent.width - 32px;
                        height: parent.files-h;
                        border-top-left-radius: 8px;
                        border-top-right-radius: 8px;
                        background: Theme.surface3;
                        clip: true;
                        Flickable {
                            x: 16px;
                            y: 16px;
                            width: parent.width - 32px;
                            height: 212px;
                            content-width: max(self.width, files-row.preferred-width);
                            files-row := HorizontalLayout {
                                alignment: start;
                                spacing: 16px;
                                for f[i] in root.pending-files: Rectangle {
                                    width: 200px;
                                    height: 200px;
                                    border-radius: 6px;
                                    background: Theme.card;
                                    Rectangle {
                                        x: 8px;
                                        y: 8px;
                                        width: parent.width - 16px;
                                        height: 144px;
                                        border-radius: 4px;
                                        clip: true;
                                        background: Theme.surface0;
                                        if f.has-image: Image { width: parent.width; height: parent.height; source: f.image; image-fit: contain; }
                                        if !f.has-image: Text { text: "📄"; font-family: "Segoe UI Emoji"; font-size: 48px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { x: 8px; y: 158px; width: parent.width - 16px; text: f.name; color: Theme.text; font-size: 14px; overflow: elide; }
                                    Text { x: 8px; y: 178px; width: parent.width - 16px; text: f.size; color: Theme.muted; font-size: 12px; overflow: elide; }
                                    // Remove it from the message.
                                    Rectangle {
                                        x: parent.width - 36px;
                                        y: 4px;
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: Theme.card;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        drop-shadow-blur: 6px;
                                        drop-shadow-color: Theme.shadow;
                                        remove-area := TouchArea { mouse-cursor: pointer; clicked => { root.pending-remove(i); } }
                                        Icon { x: 7px; y: 7px; width: 18px; height: 18px; stroke-width: 2.4px; commands: Icons.close; tint: remove-area.has-hover ? #f23f43 : Theme.text2; }
                                    }
                                }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                    }
                    Rectangle {
                        x: 16px;
                        y: 8px + parent.files-h;
                        width: parent.width - 32px;
                        height: 44px;
                        border-top-left-radius: parent.files-h > 0 ? 0px : 8px;
                        border-top-right-radius: parent.files-h > 0 ? 0px : 8px;
                        border-bottom-left-radius: 8px;
                        border-bottom-right-radius: 8px;
                        background: Theme.card;
                        border-width: 1px;
                        border-color: input.has-focus ? (Appearance.glass ? Theme.edge : Theme.edge) : Theme.line;
                        drop-shadow-blur: input.has-focus ? 18px : 0px;
                        drop-shadow-color: Theme.glow;
                        animate border-color { duration: Appearance.slow; }
                        Sheen { x: 12px; y: 0; width: parent.width - 24px; }
                        input := TextInput {
                            x: 48px;
                            width: parent.width - 136px - (input.text == "" && root.editing == "" ? 36px : 0px);
                            height: parent.height;
                            single-line: true;
                            vertical-alignment: center;
                            color: Theme.text;
                            font-size: 15px;
                            accepted => {
                                if (self.text != "" || (root.pending-files.length > 0 && root.editing == "")) {
                                    if (root.editing != "") {
                                        root.edit-message(root.editing, self.text);
                                        root.editing = "";
                                    } else if (root.replying != "" && root.pending-files.length == 0) {
                                        root.reply-message(root.replying, self.text);
                                        root.replying = "";
                                    } else {
                                        root.send(self.text);
                                    }
                                    self.text = "";
                                }
                            }
                            key-pressed(event) => {
                                if (event.modifiers.alt && event.text == Key.LeftArrow) {
                                    root.go-back();
                                    return accept;
                                }
                                if (event.modifiers.alt && event.text == Key.RightArrow) {
                                    root.go-ahead();
                                    return accept;
                                }
                                if (root.slash-open) {
                                    if (event.text == Key.DownArrow) {
                                        root.slash-index = root.slash-step(root.slash-index, 1);
                                        return accept;
                                    }
                                    if (event.text == Key.UpArrow) {
                                        root.slash-index = root.slash-step(root.slash-index, -1);
                                        return accept;
                                    }
                                    if (event.text == Key.Return || event.text == Key.Tab) {
                                        root.slash-picked(root.slash-index);
                                        return accept;
                                    }
                                    if (event.text == Key.Escape) {
                                        root.slash-open = false;
                                        return accept;
                                    }
                                }
                                if (root.suggest-open) {
                                    if (event.text == Key.DownArrow) {
                                        root.suggest-index = min(root.suggest-index + 1, root.suggest.length - 1);
                                        return accept;
                                    }
                                    if (event.text == Key.UpArrow) {
                                        root.suggest-index = max(root.suggest-index - 1, 0);
                                        return accept;
                                    }
                                    if (event.text == Key.Return || event.text == Key.Tab) {
                                        root.suggest-picked(root.suggest-index);
                                        return accept;
                                    }
                                    if (event.text == Key.Escape) {
                                        root.suggest-open = false;
                                        return accept;
                                    }
                                }
                                if (event.text == Key.Escape && root.replying != "") {
                                    root.replying = "";
                                    return accept;
                                }
                                if (event.text == Key.Escape && root.editing != "") {
                                    root.editing = "";
                                    self.text = "";
                                    return accept;
                                }
                                return reject;
                            }
                            edited => {
                                root.input-changed(self.text);
                                if (self.text != "") {
                                    root.typing();
                                }
                            }
                        }
                        // Attach a file.
                        Rectangle {
                            x: 8px;
                            y: 8px;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: attach-area.has-hover ? Theme.hover : transparent;
                            attach-area := TouchArea { mouse-cursor: pointer; clicked => { root.attach-file(); } }
                            Icon { width: 20px; height: 20px; stroke-width: 2.4px; commands: Icons.plus; tint: Theme.text2; }
                        }
                        // A voice message, while nothing is typed: a click starts recording.
                        if input.text == "" && root.editing == "": Rectangle {
                            x: parent.width - 114px;
                            y: 8px;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: rec-area.has-hover ? Theme.hover : transparent;
                            rec-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (root.rec-state == 0) {
                                        root.rec-state = 1;
                                        root.record-start();
                                    }
                                }
                            }
                            Icon { x: 4px; y: 4px; commands: Icons.mic; tint: rec-area.has-hover ? Theme.text : Theme.text2; }
                        }
                        // A GIF from Discord's GIF search, sent as it is picked.
                        Rectangle {
                            x: parent.width - 78px;
                            y: 8px;
                            width: 34px;
                            height: 28px;
                            border-radius: 6px;
                            background: gif-area.has-hover ? Theme.hover : transparent;
                            gif-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-gif(); }
                            }
                            Rectangle {
                                width: 28px;
                                height: 18px;
                                border-radius: 4px;
                                border-width: 1.5px;
                                border-color: gif-area.has-hover ? Theme.text : Theme.text2;
                                Text { text: "GIF"; color: gif-area.has-hover ? Theme.text : Theme.text2; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        // Emoji into the message.
                        Rectangle {
                            x: parent.width - 40px;
                            y: 8px;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: smile-area.has-hover ? Theme.hover : transparent;
                            smile-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-emoji(""); }
                            }
                            Icon { x: 3px; y: 3px; width: 22px; height: 22px; commands: Icons.smile; tint: smile-area.has-hover ? Theme.text : Theme.text2; }
                        }
                        Text {
                            x: 48px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: root.editing != "" ? @tr("" => "Редактирование сообщения · Esc отменяет") : root.replying != "" ? @tr("" => "Ответ на сообщение · Esc отменяет") : root.placeholder;
                            color: Theme.faint;
                            font-size: 15px;
                            visible: input.text == "";
                        }
                        // Recording a voice message: over the box, with the time, cancel and send.
                        if root.rec-state > 0: Rectangle {
                            border-radius: 8px;
                            background: Theme.surface3;
                            TouchArea {}
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 12px;
                                        height: 12px;
                                        border-radius: 6px;
                                        background: root.rec-full || root.rec-state == 2 ? Theme.faint : #f23f43;
                                    }
                                }
                                Text {
                                    text: root.rec-state == 2 ? @tr("" => "Отправка голосового сообщения…")
                                        : root.rec-full ? @tr("" => "Запись длится 20 минут, это предел. Отправить?")
                                        : @tr("" => "Запись голосового сообщения");
                                    color: Theme.text;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text { text: root.rec-time; color: Theme.text2; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                if root.rec-state == 1: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: cancel-rec-label.preferred-width + 20px;
                                        height: 28px;
                                        border-radius: 6px;
                                        background: cancel-rec.has-hover ? Theme.hover : transparent;
                                        cancel-rec := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.rec-state = 0;
                                                root.record-cancel();
                                            }
                                        }
                                        cancel-rec-label := Text { text: @tr("" => "Отмена"); color: Theme.text2; font-size: 13px; font-weight: 600; }
                                    }
                                }
                                // Stop and send: the one click that sends it.
                                if root.rec-state == 1: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 30px;
                                        height: 30px;
                                        border-radius: 15px;
                                        background: send-rec.has-hover ? Theme.accent-hover : Theme.accent;
                                        send-rec := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if (root.rec-state == 1) {
                                                    root.rec-state = 2;
                                                    root.record-send();
                                                }
                                            }
                                        }
                                        Path {
                                            x: 8px;
                                            y: 8px;
                                            width: 14px;
                                            height: 14px;
                                            viewbox-width: 14;
                                            viewbox-height: 14;
                                            fill: #ffffff;
                                            commands: "M 1 1 L 13 7 L 1 13 L 3 7 Z";
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        x: 18px;
                        y: 53px + parent.files-h;
                        height: 18px;
                        width: parent.width - 36px;
                        text: root.flash != "" ? root.flash : root.typing-line;
                        color: root.flash != "" ? #f23f43 : Theme.text2;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }

            if root.dm-call != "" && !root.forum-open && root.people-page == 0: Rectangle {
                x: 0;
                y: 48px;
                width: parent.width;
                height: 30px;
                background: Theme.light ? #d3f1df : #1c3a2f;
                Text { x: 16px; height: parent.height; text: "📞 " + root.dm-call; color: Theme.green; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                // Answer: into the call (no ring). Decline: the line goes away here only.
                if !root.dm-call-joined: HorizontalLayout {
                    width: self.preferred-width;
                    x: parent.width - self.width - 12px;
                    height: parent.height;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 8px;
                    Rectangle {
                        width: answer-label.preferred-width + 20px;
                        border-radius: 4px;
                        background: answer-area.has-hover ? #1a8f4c : #23a55a;
                        answer-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-call = true;
                                root.dm-call-start(false);
                            }
                        }
                        answer-label := Text { text: @tr("" => "Присоединиться"); color: #fff; font-size: 12.5px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                    }
                    Rectangle {
                        width: decline-label.preferred-width + 20px;
                        border-radius: 4px;
                        background: decline-area.has-hover ? Theme.hover : Theme.wash;
                        decline-area := TouchArea { mouse-cursor: pointer; clicked => { root.dm-call-decline(); } }
                        decline-label := Text { text: @tr("" => "Отклонить"); color: Theme.text; font-size: 12.5px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                    }
                }
            }

            // While the list sits at an old message (after a search): the way back.
            if root.detached && !root.forum-open && root.people-page == 0: Rectangle {
                x: (parent.width - self.width) / 2;
                y: 56px;
                width: back-label.preferred-width + 36px;
                height: 34px;
                border-radius: 17px;
                background: back-area.has-hover ? Theme.accent-hover : Theme.accent;
                drop-shadow-blur: 12px;
                drop-shadow-color: Theme.shadow;
                back-area := TouchArea { mouse-cursor: pointer; clicked => { root.return-latest(); } }
                back-label := Text { text: @tr("" => "Вернуться к последним"); color: Theme.on-accent; font-size: 13px; font-weight: 700; }
            }

            if root.suggest-open: Rectangle {
                property <bool> menu-shown;
                init => { self.menu-shown = true; }
                opacity: self.menu-shown ? 1 : 0;
                animate opacity { duration: Appearance.quick; easing: ease-out; }
                x: 16px;
                y: parent.height - 72px - self.height + 4px;
                width: min(340px, parent.width - 32px);
                height: min(7, root.suggest.length) * 38px + 8px;
                border-radius: 8px;
                background: Theme.popup;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 14px;
                drop-shadow-color: Theme.shadow;
                for s[i] in root.suggest: Rectangle {
                    x: 4px;
                    y: 4px + i * 38px;
                    width: parent.width - 8px;
                    height: 38px;
                    border-radius: 6px;
                    background: sg-area.has-hover || i == root.suggest-index ? Theme.accent : transparent;
                    sg-area := TouchArea { mouse-cursor: pointer; clicked => { root.suggest-picked(i); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { text: s.label; color: sg-area.has-hover || i == root.suggest-index ? Theme.on-accent : Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                        Text { text: s.detail; color: sg-area.has-hover ? Theme.on-accent : Theme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    }
                }
            }

            // Slash commands, as in Discord: the bots down the left, their commands in sections on the right.
            if root.slash-open && root.slash-rows.length > 0: Rectangle {
                x: 16px;
                y: parent.height - 72px - self.height + 4px;
                width: parent.width - 32px;
                height: min(400px, root.slash-height + 16px, parent.height - 140px);
                border-radius: 8px;
                clip: true;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 14px;
                drop-shadow-color: Theme.shadow;
                // Keeps the row picked with the arrow keys in sight.
                property <int> picked: root.slash-index;
                changed picked => {
                    if (self.picked >= 0 && self.picked < root.slash-rows.length) {
                        if (root.slash-rows[self.picked].y + slash-list.content-y < 0) {
                            slash-list.content-y = -root.slash-rows[self.picked].y + (self.picked > 0 && root.slash-rows[self.picked - 1].header ? 32px : 0px);
                        } else if (root.slash-rows[self.picked].y + 56px + slash-list.content-y > slash-list.height) {
                            slash-list.content-y = slash-list.height - root.slash-rows[self.picked].y - 56px;
                        }
                    }
                }
                // The strip of bots; a click scrolls to that bot's section.
                Rectangle {
                    x: 0;
                    y: 0;
                    width: 56px;
                    height: parent.height;
                    background: Theme.surface0;
                    for a[i] in root.slash-apps: Rectangle {
                        x: 8px;
                        y: 8px + i * 48px;
                        width: 40px;
                        height: 40px;
                        border-radius: 8px;
                        background: strip-area.has-hover || (root.slash-index >= 0 && root.slash-index < root.slash-rows.length && root.slash-rows[root.slash-index].app == a.id) ? Theme.active : transparent;
                        strip-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { slash-list.content-y = -min(a.y, max(0px, slash-list.content-height - slash-list.height)); }
                        }
                        if a.recent: Icon { x: 10px; y: 10px; commands: Icons.clock; tint: strip-area.has-hover ? Theme.text : Theme.text2; }
                        if !a.recent: Rectangle {
                            x: 6px;
                            y: 6px;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            clip: true;
                            background: Theme.accent;
                            if !a.has-icon: Text { text: a.letter; color: Theme.on-accent; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            if a.has-icon: Image { width: 28px; height: 28px; source: a.icon; }
                        }
                    }
                }
                slash-list := Flickable {
                    x: 56px;
                    y: 8px;
                    width: parent.width - 56px;
                    height: parent.height - 16px;
                    content-height: root.slash-height;
                    for r[i] in root.slash-rows: Rectangle {
                        x: 8px;
                        y: r.y;
                        width: parent.width - 16px;
                        height: r.header ? 32px : 56px;
                        border-radius: 6px;
                        background: !r.header && (row-area.has-hover || i == root.slash-index) ? Theme.active : transparent;
                        row-area := TouchArea {
                            enabled: !r.header;
                            mouse-cursor: pointer;
                            clicked => { root.slash-picked(i); }
                        }
                        // A section: a clock for the recent one, else the bot's small avatar, and the name.
                        if r.header: HorizontalLayout {
                            padding-left: 8px;
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                if r.recent: Icon { width: 16px; height: 16px; commands: Icons.clock; tint: Theme.muted; }
                                if !r.recent: Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    clip: true;
                                    background: Theme.accent;
                                    if !r.has-icon: Text { text: r.letter; color: Theme.on-accent; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    if r.has-icon: Image { width: 16px; height: 16px; source: r.icon; }
                                }
                            }
                            Text { text: r.title; color: Theme.muted; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                        }
                        if !r.header: Rectangle {
                            Rectangle {
                                x: 10px;
                                y: 16px;
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                clip: true;
                                background: Theme.accent;
                                if !r.has-icon: Text { text: r.letter; color: Theme.on-accent; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                if r.has-icon: Image { width: 24px; height: 24px; source: r.icon; }
                            }
                            HorizontalLayout {
                                x: 46px;
                                y: 8px;
                                width: parent.width - 46px - bot-label.width - 24px;
                                height: 22px;
                                spacing: 6px;
                                alignment: start;
                                Text { text: r.title; color: Theme.strong; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                for p in r.pills: Rectangle {
                                    width: pill-label.preferred-width + 12px;
                                    height: 20px;
                                    y: 1px;
                                    border-radius: 4px;
                                    background: Theme.wash;
                                    pill-label := Text { text: p; color: Theme.text2; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            Text {
                                x: 46px;
                                y: 30px;
                                width: parent.width - 46px - bot-label.width - 24px;
                                height: 18px;
                                text: r.detail;
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            bot-label := Text {
                                x: parent.width - self.width - 12px;
                                height: parent.height;
                                width: min(self.preferred-width, 160px);
                                text: r.bot;
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // The picked command's options over the box.
            if !root.slash-open && root.slash-hint-name != "": Rectangle {
                x: 16px;
                y: parent.height - 72px - self.height + 4px;
                width: parent.width - 32px;
                height: 36px;
                border-radius: 8px;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.line;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    alignment: start;
                    Text { text: root.slash-hint-name; color: Theme.strong; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                    for p[i] in root.slash-hint: Rectangle {
                        y: 8px;
                        height: 20px;
                        width: hint-label.preferred-width + 12px;
                        border-radius: 4px;
                        background: i == root.slash-hint-active ? Theme.accent : Theme.wash;
                        hint-label := Text { text: p; color: i == root.slash-hint-active ? Theme.on-accent : Theme.text2; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            if root.found-open: FoundPanel {                x: parent.width - self.width - 16px;
                y: 52px;
                width: min(460px, parent.width - 32px);
                height: min(560px, parent.height - 70px);
                found: root.found;
                total: root.found-total;
                title: root.found-title;
                picked(channel, message) => {
                    root.found-open = false;
                    root.show-call = false;
                    root.selected-channel = channel;
                    root.jump-to(channel, message);
                }
                close => { root.found-open = false; }
            }

            if root.notice != "": Rectangle {
                background: Theme.surface2;
                Text {
                    width: parent.width - 64px;
                    text: root.notice;
                    color: Theme.muted;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.forum-open && root.people-page == 0: ForumView {
                title: root.channel-title;
                posts: root.forum-posts;
                new-post => { root.open-thread-dialog(2, ""); }
                open(id) => {
                    root.forum-open = false;
                    root.selected-channel = id;
                    root.channel-clicked(id);
                }
            }

            if root.people-page > 0: PeopleView {
                friends-page: root.people-page == 1;
                tab <=> root.friends-tab;
                people: root.people;
                add-result: root.add-friend-result;
                add-friend(name) => { root.add-friend(name); }
                open(id) => { root.person-open(id); }
                user-menu(id, x, y) => { root.open-user-menu(id, x, y); }
                accept(id) => { root.person-accept(id); }
                remove(id) => { root.person-remove(id); }
                tab-changed(i) => { root.friends-tab-changed(i); }
            }

        }
        // Members of the server, on the right of a text channel.
        if root.members-open && root.members-shown && !root.forum-open: MemberPanel {
            width: root.members-width;
            members: root.members;
            user-menu(id, x, y) => { root.open-user-menu(id, x, y); }
            user-card(id, x, y) => { root.open-user-card(id, x, y); }
            near-end => { root.members-near-end(); }
        }
        // The other person, beside a DM.
        if root.channel-is-dm && root.people-page == 0 && root.dm-panel-shown && root.dm-card.id != "" && !root.show-call: Rectangle {
            width: root.dm-panel-width;
            UserCardView {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                panel: true;
                item: root.dm-card;
                more(x, y) => {
                    root.open-user-menu(root.dm-card.id, x - 260px, y + 36px);
                    root.menu-from-card = true;
                }
                full => {
                    root.user-card = root.dm-card;
                    root.open-full-profile(root.dm-card.id);
                }
                open-badge(i) => { root.open-badges(root.dm-card, i); }
            }
        }
    }

    // The edges of the side panels: dragged, they change the panel's width.
    if !root.call-fullscreen: TouchArea {
        x: 72px + root.sidebar-width - 3px;
        y: 32px + root.banner-h;
        width: 6px;
        height: root.height - 32px - root.banner-h;
        mouse-cursor: ew-resize;
        moved => {
            if (self.pressed) {
                root.sidebar-width = clamp(root.sidebar-width + self.mouse-x - self.pressed-x, 190px, 440px);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.save-panel-widths();
            }
        }
    }
    if !root.call-fullscreen && root.members-open && root.members-shown && !root.forum-open: TouchArea {
        x: root.width - root.members-width - 3px;
        y: 32px + root.banner-h;
        width: 6px;
        height: root.height - 32px - root.banner-h;
        mouse-cursor: ew-resize;
        moved => {
            if (self.pressed) {
                root.members-width = clamp(root.members-width - (self.mouse-x - self.pressed-x), 180px, 400px);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.save-panel-widths();
            }
        }
    }
    if !root.call-fullscreen && root.channel-is-dm && root.people-page == 0 && root.dm-panel-shown && root.dm-card.id != "" && !root.show-call: TouchArea {
        x: root.width - root.dm-panel-width - 3px;
        y: 32px + root.banner-h;
        width: 6px;
        height: root.height - 32px - root.banner-h;
        mouse-cursor: ew-resize;
        moved => {
            if (self.pressed) {
                root.dm-panel-width = clamp(root.dm-panel-width - (self.mouse-x - self.pressed-x), 280px, 480px);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.save-panel-widths();
            }
        }
    }
    // A stream watched while reading a chat: small, as in Discord, and it goes wherever it is dragged.
    // A click or the arrow: back to the call; the corner: full screen; ×: stop watching.
    if root.watching && !root.show-call && root.voice-channel != "": pip := Rectangle {
        property <bool> hovered: pip-area.has-hover || pip-back.has-hover || pip-full.has-hover || pip-stop.has-hover;
        property <length> highest: 32px + root.banner-h;
        width: min(360px, root.width * 0.4);
        height: self.width * 9 / 16;
        x: max(0px, min(root.pip-x < 0px ? root.width - self.width - 20px : root.pip-x, root.width - self.width));
        y: max(self.highest, min(root.pip-y < 0px ? root.height - self.height - 84px : root.pip-y, root.height - self.height));
        border-radius: 10px;
        clip: true;
        background: #000;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.shadow;
        pip-area := TouchArea {
            property <bool> dragged;
            mouse-cursor: self.dragged ? move : pointer;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    self.dragged = false;
                }
            }
            moved => {
                if (self.pressed && (self.dragged || abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px)) {
                    self.dragged = true;
                    root.pip-x = max(0px, pip.x + self.mouse-x - self.pressed-x);
                    root.pip-y = max(pip.highest, pip.y + self.mouse-y - self.pressed-y);
                }
            }
            clicked => {
                if (!self.dragged) {
                    root.show-call = true;
                }
            }
        }
        Image { width: parent.width; height: parent.height; source: root.stream-frame; image-fit: contain; }
        if root.stream-frame.width == 0: Text { text: @tr("" => "Жду видео…"); color: Theme.muted; font-size: 13px; }
        // Top left: the way back to the call, and which one it is.
        Rectangle {
            x: 6px;
            y: 6px;
            height: 26px;
            width: min(parent.width - 12px, 44px + pip-place.preferred-width);
            border-radius: 6px;
            opacity: pip.hovered ? 1 : 0;
            background: pip-back.has-hover ? #000000d0 : #00000090;
            animate opacity { duration: Appearance.quick; }
            pip-back := TouchArea { mouse-cursor: pointer; clicked => { root.show-call = true; } }
            Icon { x: 4px; y: 4px; width: 18px; height: 18px; commands: Icons.chevron-left; tint: #fff; }
            Icon { x: 22px; y: 6px; width: 14px; height: 14px; commands: Icons.volume; tint: #fff; }
            pip-place := Text { x: 40px; width: parent.width - 44px; height: parent.height; text: root.voice-channel-name; color: #fff; font-size: 12px; font-weight: 600; overflow: elide; vertical-alignment: center; }
        }
        // Bottom left: whose stream.
        Rectangle {
            x: 8px;
            y: parent.height - self.height - 8px;
            height: 22px;
            width: min(parent.width - 88px, pip-label.preferred-width + 12px + (root.stream-viewers > 0 ? 40px : 0px));
            border-radius: 5px;
            background: #000000a8;
            pip-label := Text { x: 6px; width: parent.width - 12px - (root.stream-viewers > 0 ? 40px : 0px); text: root.stream-name; color: #fff; font-size: 12px; font-weight: 600; overflow: elide; vertical-alignment: center; }
            if root.stream-viewers > 0: Icon { x: parent.width - 40px; y: 4px; width: 14px; height: 14px; commands: Icons.eye; tint: #fff; }
            if root.stream-viewers > 0: Text { x: parent.width - 23px; width: 20px; text: root.stream-viewers; color: #fff; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        }
        // Bottom right: full screen, stop watching.
        Rectangle {
            x: parent.width - 66px;
            y: parent.height - 34px;
            width: 28px;
            height: 28px;
            border-radius: 7px;
            opacity: pip.hovered ? 1 : 0;
            background: pip-full.has-hover ? #000000d0 : #00000090;
            animate opacity { duration: Appearance.quick; }
            pip-full := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.show-call = true;
                    root.call-fullscreen = true;
                    root.fullscreen-changed(true);
                }
            }
            Icon { x: 6px; y: 6px; width: 16px; height: 16px; commands: Icons.maximize; tint: #fff; }
        }
        Rectangle {
            x: parent.width - 34px;
            y: parent.height - 34px;
            width: 28px;
            height: 28px;
            border-radius: 7px;
            opacity: pip.hovered ? 1 : 0;
            background: pip-stop.has-hover ? #da373c : #00000090;
            animate opacity { duration: Appearance.quick; }
            pip-stop := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.watched-identity = "";
                    root.stop-watching();
                }
            }
            Icon { x: 5px; y: 5px; width: 18px; height: 18px; commands: Icons.close; tint: #fff; }
        }
    }

    if root.banner-h > 0: Rectangle {
        y: 32px;
        width: root.width;
        height: root.banner-h;
        clip: true;
        background: #4a241c;
        HorizontalLayout {
            x: 44px;
            width: parent.width - 88px;
            height: 36px;
            alignment: center;
            spacing: 12px;
            Text {
                text: @tr("" => "Голосовой чат был отключён, так как вы подключились из другого места.");
                color: #f8a878;
                font-size: 13.5px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: reconnect-label.preferred-width + 20px;
                    height: 24px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #f8a878;
                    background: reconnect-area.has-hover ? #f8a87830 : transparent;
                    animate background { duration: Appearance.quick; }
                    reconnect-area := TouchArea { mouse-cursor: pointer; clicked => { root.voice-reconnect(); } }
                    reconnect-label := Text { text: @tr("" => "Переподключиться"); color: #f8a878; font-size: 12.5px; font-weight: 600; }
                }
            }
        }
        Rectangle {
            x: parent.width - self.width - 8px;
            y: 6px;
            width: 24px;
            height: 24px;
            border-radius: 4px;
            background: banner-close.has-hover ? #f8a87830 : transparent;
            banner-close := TouchArea { mouse-cursor: pointer; clicked => { root.voice-taken = false; } }
            Icon { x: 5px; y: 5px; width: 14px; height: 14px; commands: Icons.close; tint: #f8a878; }
        }
    }

    if root.show-call && root.voice-channel != "": CallView {
                // Beside the server list and channels, or over everything in full screen.
                x: root.call-fullscreen ? 0px : 320px;
                y: 32px + root.banner-h;
                width: root.width - self.x;
                height: root.height - 32px - root.banner-h;
                fullscreen: root.call-fullscreen;
                toggle-fullscreen => {
                    root.call-fullscreen = !root.call-fullscreen;
                    root.fullscreen-changed(root.call-fullscreen);
                }
                title: root.voice-channel-name;
                tiles: root.call-tiles;
                watching: root.watching;
                watched: root.watched-identity;
                stream-name: root.stream-name;
                stream-frame: root.stream-frame;
                grid-view <=> root.call-grid;
                focus-stream(identity) => { root.focus-stream(identity); }
                set-sound(identity) => { root.set-stream-sound(identity); }
                stop-one(identity) => { root.stop-one(identity); }
                stream-quality: root.stream-quality;
                muted: root.mic-muted;
                deafened: root.deafened;
                ptt-open: root.ptt-open;
                sharing: root.sharing;
                camera-on: root.camera-on;
                toggle-camera => { root.toggle-camera(!root.camera-on); }
                share-off: root.voice-dm;
                stream-volume <=> root.stream-volume;
                stream-volume-changed(v) => { root.user-volume("stream:" + root.watched-identity, v); }
                watch(identity) => {
                    root.watched-identity = identity;
                    root.watch-stream(identity);
                }
                stop-watching => {
                    root.watched-identity = "";
                    root.stop-watching();
                }
                // Same rules as the switches in the user panel.
                toggle-mic => {
                    if (root.deafened) {
                        root.deafened = false;
                        root.mic-muted = false;
                    } else {
                        root.mic-muted = !root.mic-muted;
                    }
                    root.switches-changed(root.mic-muted, root.deafened);
                }
                toggle-deafen => {
                    root.deafened = !root.deafened;
                    root.switches-changed(root.mic-muted, root.deafened);
                }
                share-clicked => {
                    if (root.sharing) {
                        stream-menu.show();
                    } else {
                        root.share-sources-requested();
                        root.share-picker-open = true;
                    }
                }
                leave => { root.voice-leave(); }
                user-menu(id, x, y) => { root.open-user-menu(id, x, y); }
            }

    // Emoji: into the message box, or as a reaction to the message in `picker-target`.
    emoji-popup := PopupWindow {
        x: root.picker-target == "" ? root.width - self.width - 360px : max(4px, min(root.msg-menu-x, root.width - self.width - 4px));
        y: root.picker-target == "" ? root.height - self.height - 90px : max(4px, min(root.msg-menu-y, root.height - self.height - 4px));
        width: 8 * 38px + 16px;
        height: 52px + max(1, ceil(root.emoji-items.length / 8)) * 38px + 8px;
        close-policy: close-on-click-outside;
        Rectangle {
            property <bool> menu-shown;
            init => { self.menu-shown = true; }
            opacity: self.menu-shown ? 1 : 0;
            animate opacity { duration: Appearance.quick; easing: ease-out; }
            background: Theme.popup;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow;
            // Search by name: "кот", "heart", or a server emoji's name.
            Rectangle {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: 34px;
                border-radius: 6px;
                background: Theme.surface0;
                emoji-search := TextInput {
                    text <=> root.emoji-text;
                    init => { self.focus(); }
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    single-line: true;
                    vertical-alignment: center;
                    color: Theme.text;
                    font-size: 14px;
                    edited => { root.emoji-query(self.text); }
                }
                Text {
                    x: 10px;
                    height: parent.height;
                    vertical-alignment: center;
                    visible: root.emoji-text == "";
                    text: @tr("" => "Найти эмодзи по названию");
                    color: Theme.faint;
                    font-size: 14px;
                }
            }
            if root.emoji-items.length == 0: Text { y: 52px; x: 12px; text: @tr("" => "Ничего не нашлось"); color: Theme.muted; font-size: 13px; }
            for e[i] in root.emoji-items: Rectangle {
                x: 8px + mod(i, 8) * 38px;
                y: 52px + floor(i / 8) * 38px;
                width: 38px;
                height: 38px;
                border-radius: 6px;
                background: e-area.has-hover ? Theme.hover : transparent;
                e-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.picker-target == "") {
                            input.text = input.text + e.insert;
                            input.focus();
                        } else {
                            root.react(root.picker-target, e.key);
                        }
                        emoji-popup.close();
                    }
                }
                if !e.has-image: Text { text: e.glyph; font-family: "Segoe UI Emoji"; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                if e.has-image: Image { x: 7px; y: 7px; width: 24px; height: 24px; source: e.image; }
            }
        }
    }
    // GIFs from Discord's GIF search: what's typed (or trending), a few at a time, more when scrolled down.
    gif-popup := PopupWindow {
        x: max(4px, root.width - self.width - 360px);
        y: root.height - self.height - 90px;
        width: 3 * 156px + 16px;
        height: 460px;
        close-policy: close-on-click-outside;
        Rectangle {
            property <bool> menu-shown;
            init => { self.menu-shown = true; }
            opacity: self.menu-shown ? 1 : 0;
            animate opacity { duration: Appearance.quick; easing: ease-out; }
            background: Theme.popup;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow;
            Rectangle {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: 34px;
                border-radius: 6px;
                background: Theme.surface0;
                gif-search := TextInput {
                    text <=> root.gif-text;
                    init => { self.focus(); }
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    single-line: true;
                    vertical-alignment: center;
                    color: Theme.text;
                    font-size: 14px;
                    edited => {
                        root.gif-busy = true;
                        root.gif-query(self.text);
                    }
                }
                Text {
                    x: 10px;
                    height: parent.height;
                    vertical-alignment: center;
                    visible: root.gif-text == "";
                    text: @tr("" => "Искать в Tenor");
                    color: Theme.faint;
                    font-size: 14px;
                }
            }
            if root.gif-items.length == 0: Text {
                y: 56px;
                x: 12px;
                text: root.gif-busy ? @tr("" => "Ищу GIF…") : @tr("" => "Ничего не нашлось");
                color: Theme.muted;
                font-size: 13px;
            }
            Flickable {
                x: 8px;
                y: 50px;
                width: parent.width - 16px;
                height: parent.height - 58px;
                content-height: ceil(root.gif-items.length / 3) * 116px;
                // Near the end: the next few tiles (Rust ignores it when there are no more).
                changed content-y => {
                    if (self.content-y < self.height - self.content-height + 160px) {
                        root.gif-more();
                    }
                }
                for g[i] in root.gif-items: Rectangle {
                    x: mod(i, 3) * 156px;
                    y: floor(i / 3) * 116px;
                    width: 152px;
                    height: 112px;
                    border-radius: 6px;
                    clip: true;
                    background: Theme.surface3;
                    border-width: tile-area.has-hover ? 2px : 0px;
                    border-color: Theme.accent;
                    if g.has-image: Image { width: parent.width; height: parent.height; source: g.image; image-fit: cover; }
                    if g.category: Rectangle {
                        background: g.has-image ? #00000080 : transparent;
                        Text {
                            width: parent.width - 12px;
                            text: g.label;
                            color: g.has-image ? #fff : Theme.text;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    tile-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (g.category) {
                                root.gif-text = g.label;
                                root.gif-busy = true;
                                root.gif-query(g.label);
                            } else {
                                root.send-gif(g.url);
                                gif-popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
    message-menu-popup := PopupWindow {
        x: max(4px, min(root.msg-menu-x, root.width - self.width - 4px));
        y: max(4px, min(root.msg-menu-y, root.height - self.height - 4px));
        width: 230px;
        height: msg-body.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            property <bool> menu-shown;
            init => { self.menu-shown = true; }
            opacity: self.menu-shown ? 1 : 0;
            animate opacity { duration: Appearance.quick; easing: ease-out; }
            background: Theme.popup;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow;
            msg-body := VerticalLayout {
                padding: 6px;
                MenuItem {
                    text: @tr("" => "Добавить реакцию");
                    clicked => {
                        message-menu-popup.close();
                        root.open-emoji(root.msg-menu-id);
                    }
                }
                if !root.msg-menu-pinned: MenuItem { text: @tr("" => "Закрепить"); clicked => { root.user-action("pin", root.msg-menu-id); message-menu-popup.close(); } }
                if root.msg-menu-pinned: MenuItem { text: @tr("" => "Открепить"); clicked => { root.user-action("unpin", root.msg-menu-id); message-menu-popup.close(); } }
                MenuItem { text: @tr("" => "Ответить"); clicked => { root.editing = ""; root.replying = root.msg-menu-id; message-menu-popup.close(); input.focus(); } }
                // Not in DMs, and not inside a thread (a thread has none of its own).
                if !root.channel-is-dm && !root.channel-is-thread: MenuItem {
                    text: @tr("" => "Создать ветку");
                    clicked => {
                        root.open-thread-dialog(1, root.msg-menu-id);
                        message-menu-popup.close();
                    }
                }
                MenuItem {
                    text: @tr("" => "Переслать");
                    clicked => {
                        message-menu-popup.close();
                        root.forwarding = true;
                        root.forward-open(root.msg-menu-id);
                    }
                }
                MenuItem { text: @tr("" => "Копировать текст"); clicked => { root.copy-message(root.msg-menu-id); message-menu-popup.close(); } }
                MenuItem { text: @tr("" => "Копировать ссылку"); clicked => { root.copy-link(root.msg-menu-id); message-menu-popup.close(); } }
                MenuItem { text: @tr("" => "Копировать ID сообщения"); clicked => { root.copy-text(root.msg-menu-id); message-menu-popup.close(); } }
                MenuItem { text: @tr("" => "Меню автора"); clicked => { message-menu-popup.close(); root.open-user-menu(root.msg-menu-author, root.msg-menu-x, root.msg-menu-y); } }
                if root.msg-menu-author == root.me-id: MenuLine {}
                if root.msg-menu-author == root.me-id: MenuItem {
                    text: @tr("" => "Редактировать");
                    clicked => {
                        root.begin-edit(root.msg-menu-id);
                        message-menu-popup.close();
                    }
                }
                if root.msg-menu-author == root.me-id: MenuItem {
                    text: @tr("" => "Удалить");
                    danger: true;
                    clicked => {
                        root.confirm-user = root.msg-menu-id;
                        root.confirm-name = @tr("" => "сообщение");
                        root.confirm-action = "delete-message";
                        message-menu-popup.close();
                    }
                }
            }
        }
    }

    user-menu-popup := UserMenu {
        x: max(4px, min(root.menu-x, root.width - self.width - 4px));
        y: max(4px, min(root.menu-y, root.height - self.height - 4px));
        info <=> root.user-menu;
        most: root.height - 8px;
        from-card: root.menu-from-card;
        action(a) => {
            if (a == "profile") {
                root.open-full-profile(root.user-menu.id);
            } else {
                root.user-action(a, root.user-menu.id);
            }
        }
        ask(kind) => { root.prompt-kind = kind; }
        volume(v) => { root.user-volume(root.user-menu.id, v); }
        note-saved(text) => { root.note-saved(root.user-menu.id, text); }
        confirm(a) => {
            root.confirm-user = root.user-menu.id;
            root.confirm-name = root.user-menu.name;
            root.confirm-action = a;
        }
    }

    // What a server or channel tells about, and its mute (until turned off).
    notify-menu-popup := PopupWindow {
        x: max(4px, min(root.menu-x, root.width - self.width - 4px));
        y: max(4px, min(root.menu-y, root.height - self.height - 4px));
        width: 248px;
        height: notify-body.preferred-height;
        close-policy: close-on-click-outside;
        property <bool> own-level: root.notify-menu.channel == "" || !root.notify-menu.inherits;
        Rectangle {
            property <bool> menu-shown;
            init => { self.menu-shown = true; }
            opacity: self.menu-shown ? 1 : 0;
            animate opacity { duration: Appearance.quick; easing: ease-out; }
            background: Theme.popup;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow;
            notify-body := VerticalLayout {
                padding: 6px;
                HorizontalLayout {
                    padding-left: 8px;
                    height: 30px;
                    Text { text: root.notify-menu.name; color: Theme.text; font-size: 13px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                }
                // A new invite to this channel: made only by this click, then shown with its link.
                if root.notify-menu.channel != "": MenuItem {
                    text: @tr("" => "Пригласить");
                    clicked => {
                        root.made-invite-place = root.notify-menu.name;
                        root.made-invite-state = 1;
                        root.create-invite(root.notify-menu.channel);
                        notify-menu-popup.close();
                    }
                }
                // A new invite to the server, with its friends to send it to.
                if root.notify-menu.channel == "": MenuItem {
                    text: @tr("" => "Пригласить на сервер");
                    clicked => {
                        root.invite-query = "";
                        root.invite-rich = true;
                        root.made-invite-place = root.notify-menu.name;
                        root.made-invite-state = 1;
                        root.invite-to-guild(root.notify-menu.guild);
                        // Last: nothing after closing the popup runs in an item of it.
                        notify-menu-popup.close();
                    }
                }
                MenuLine {}
                HorizontalLayout {
                    padding-left: 8px;
                    height: 22px;
                    Text { text: @tr("" => "Уведомления"); color: Theme.muted; font-size: 11.5px; font-weight: 700; vertical-alignment: center; }
                }
                if root.notify-menu.channel != "": MenuItem {
                    text: @tr("" => "Как на сервере");
                    checkable: true;
                    radio: true;
                    checked: root.notify-menu.inherits;
                    clicked => {
                        root.notify-change(root.notify-menu.guild, root.notify-menu.channel, "level:3");
                        notify-menu-popup.close();
                    }
                }
                MenuItem {
                    text: @tr("" => "Все сообщения");
                    checkable: true;
                    radio: true;
                    checked: own-level && root.notify-menu.level == 0;
                    clicked => {
                        root.notify-change(root.notify-menu.guild, root.notify-menu.channel, "level:0");
                        notify-menu-popup.close();
                    }
                }
                MenuItem {
                    text: @tr("" => "Только упоминания");
                    checkable: true;
                    radio: true;
                    checked: own-level && root.notify-menu.level == 1;
                    clicked => {
                        root.notify-change(root.notify-menu.guild, root.notify-menu.channel, "level:1");
                        notify-menu-popup.close();
                    }
                }
                MenuItem {
                    text: @tr("" => "Ничего");
                    checkable: true;
                    radio: true;
                    checked: own-level && root.notify-menu.level == 2;
                    clicked => {
                        root.notify-change(root.notify-menu.guild, root.notify-menu.channel, "level:2");
                        notify-menu-popup.close();
                    }
                }
                MenuLine {}
                MenuItem {
                    text: root.notify-menu.channel == "" ? @tr("" => "Заглушить сервер") : @tr("" => "Заглушить канал");
                    checkable: true;
                    checked: root.notify-menu.muted;
                    clicked => {
                        root.notify-change(root.notify-menu.guild, root.notify-menu.channel, root.notify-menu.muted ? "unmute" : "mute");
                        notify-menu-popup.close();
                    }
                }
                if root.notify-menu.channel == "": MenuLine {}
                if root.notify-menu.channel == "": MenuItem {
                    text: @tr("" => "Покинуть сервер");
                    danger: true;
                    clicked => {
                        root.confirm-user = root.notify-menu.guild;
                        root.confirm-name = root.notify-menu.name;
                        root.confirm-action = "leave-server";
                        notify-menu-popup.close();
                    }
                }
            }
        }
    }

    // "Переслать": where the message goes. One click on a place sends it there.
    // The soundboard over the voice panel, as in Discord: a search, a strip of sections on the left,
    // the sounds as tiles three to a row. A click on a tile plays it for everyone in the call.
    if root.soundboard-open: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clicked => { root.soundboard-open = false; }
    }
    if root.soundboard-open: Rectangle {
        property <bool> menu-shown;
        init => { self.menu-shown = true; }
        opacity: self.menu-shown ? 1 : 0;
        animate opacity { duration: Appearance.quick; easing: ease-out; }
        x: 80px;
        y: root.height - self.height - 132px;
        width: 352px;
        height: min(400px, root.height - 180px);
        border-radius: 8px;
        clip: true;
        background: Theme.glass-strong;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.shadow;
        // Clicks inside don't close it.
        TouchArea {}
        Rectangle {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: 32px;
            border-radius: 6px;
            background: Theme.surface0;
            sound-search := TextInput {
                text <=> root.sound-text;
                init => { self.focus(); }
                x: 10px;
                width: parent.width - 52px;
                height: parent.height;
                single-line: true;
                vertical-alignment: center;
                color: Theme.text;
                font-size: 13px;
                edited => { root.sound-query(self.text); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.soundboard-open = false;
                        return accept;
                    }
                    return reject;
                }
            }
            Text {
                x: 10px;
                height: parent.height;
                vertical-alignment: center;
                visible: root.sound-text == "";
                text: @tr("" => "Найдите идеальный звук");
                color: Theme.faint;
                font-size: 13px;
            }
            // Others' sounds heard here, or not.
            Rectangle {
                x: parent.width - 32px;
                y: 2px;
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: mute-area.has-hover ? Theme.hover : transparent;
                mute-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.sounds-muted = !root.sounds-muted;
                        root.sounds-muted-changed(root.sounds-muted);
                    }
                }
                Icon {
                    x: 5px;
                    y: 5px;
                    width: 18px;
                    height: 18px;
                    commands: root.sounds-muted ? Icons.volume-off : Icons.volume;
                    tint: root.sounds-muted ? #f04a55 : (mute-area.has-hover ? Theme.text : Theme.text2);
                }
            }
        }
        // The sections; a click scrolls to one.
        Rectangle {
            x: 0;
            y: 48px;
            width: 48px;
            height: parent.height - 48px;
            background: Theme.surface0;
            for s[i] in root.sound-sections: Rectangle {
                x: 6px;
                y: 6px + i * 42px;
                width: 36px;
                height: 36px;
                border-radius: 8px;
                background: section-area.has-hover ? Theme.active : transparent;
                section-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { sound-list.content-y = -min(s.y, max(0px, sound-list.content-height - sound-list.height)); }
                }
                if s.kind != 1: Icon {
                    x: 8px;
                    y: 8px;
                    commands: s.kind == 0 ? Icons.clock : Icons.soundboard;
                    tint: section-area.has-hover ? Theme.text : Theme.text2;
                }
                if s.kind == 1: Rectangle {
                    x: 4px;
                    y: 4px;
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    clip: true;
                    background: Theme.surface3;
                    if !s.has-icon: Text { text: s.letter; color: Theme.text; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    if s.has-icon: Image { width: 28px; height: 28px; source: s.icon; }
                }
            }
        }
        if root.sound-items.length == 0: Text {
            x: 60px;
            y: 60px;
            text: root.sounds-busy ? @tr("" => "Загружаю звуки…") : @tr("" => "Звуков не нашлось");
            color: Theme.muted;
            font-size: 13px;
        }
        sound-list := Flickable {
            x: 56px;
            y: 48px;
            width: parent.width - 64px;
            height: parent.height - 56px;
            content-height: root.sound-height;
            for t in root.sound-items: Rectangle {
                x: t.x;
                y: t.y;
                width: t.header ? parent.width : 92px;
                height: t.header ? 28px : 40px;
                border-radius: 6px;
                background: t.header ? transparent : (sound-tile-area.has-hover && root.soundboard-usable ? Theme.wash-hover : Theme.wash);
                opacity: t.header || root.soundboard-usable ? 1 : 0.5;
                sound-tile-area := TouchArea {
                    enabled: !t.header && root.soundboard-usable;
                    mouse-cursor: pointer;
                    clicked => { root.sound-play(t.id, t.guild); }
                }
                if t.header: Text {
                    x: 2px;
                    height: parent.height;
                    text: t.name;
                    color: Theme.muted;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if !t.header: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    spacing: 5px;
                    alignment: start;
                    if t.has-emoji-image: VerticalLayout {
                        alignment: center;
                        Image { width: 18px; height: 18px; source: t.emoji-image; }
                    }
                    if !t.has-emoji-image && t.emoji != "": Text { text: t.emoji; font-family: "Segoe UI Emoji"; font-size: 15px; vertical-alignment: center; }
                    Text { text: t.name; color: Theme.text; font-size: 12.5px; font-weight: 500; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
            }
        }
    }
    if root.forwarding: Rectangle {
        width: root.width;
        height: root.height;
        background: #000000a0;
        TouchArea { clicked => { root.forwarding = false; } }
        Rectangle {
            width: min(440px, root.width - 32px);
            height: min(520px, root.height - 64px);
            background: Theme.glass-strong;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            // Clicks inside don't close it.
            TouchArea {}
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: @tr("" => "Переслать сообщение"); color: Theme.text; font-size: 17px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    IconButton { icon: Icons.close; clicked => { root.forwarding = false; } }
                }
                Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: Theme.surface0;
                    forward-search := TextInput {
                        init => { self.focus(); }
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        single-line: true;
                        vertical-alignment: center;
                        color: Theme.text;
                        font-size: 14px;
                        edited => { root.forward-query(self.text); }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.forwarding = false;
                                return accept;
                            }
                            return reject;
                        }
                    }
                    Text {
                        x: 10px;
                        height: parent.height;
                        vertical-alignment: center;
                        visible: forward-search.text == "";
                        text: @tr("" => "Найти канал или беседу");
                        color: Theme.faint;
                        font-size: 14px;
                    }
                }
                if root.forward-targets.length == 0: Text { text: @tr("" => "Ничего не нашлось"); color: Theme.muted; font-size: 13px; }
                ListView {
                    vertical-stretch: 1;
                    for t in root.forward-targets: Rectangle {
                        height: 42px;
                        border-radius: 6px;
                        background: target-area.has-hover ? Theme.hover : transparent;
                        target-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.forward-to(t.id);
                                root.forwarding = false;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Icon { commands: t.dm ? Icons.chat : Icons.hash; tint: Theme.muted; }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { text: t.name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                                Text { text: t.detail; color: Theme.faint; font-size: 11.5px; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }
    }

    // Joining a server: the invite typed, Discord's preview of it, and only then the join button.
    if root.join-open: Rectangle {
        property <bool> menu-shown;
        init => { self.menu-shown = true; }
        opacity: self.menu-shown ? 1 : 0;
        animate opacity { duration: Appearance.quick; easing: ease-out; }
        width: root.width;
        height: root.height;
        background: #000000a0;
        TouchArea { clicked => { root.join-open = false; } }
        Rectangle {
            width: min(460px, root.width - 32px);
            height: join-body.preferred-height;
            background: Theme.glass-strong;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            TouchArea {}
            join-body := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: @tr("" => "Присоединиться к серверу"); color: Theme.text; font-size: 19px; font-weight: 800; vertical-alignment: center; horizontal-stretch: 1; }
                    IconButton { icon: Icons.close; clicked => { root.join-open = false; } }
                }
                Text {
                    text: @tr("" => "Вставьте приглашение: .gg/invite.");
                    color: Theme.text2;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    join-field := SettingField {
                        horizontal-stretch: 1;
                        text <=> root.join-text;
                        placeholder: "https://discord.gg/…";
                        init => { self.focus-input(); }
                        edited => {
                            if (root.join-state != 1 && root.join-state != 3) {
                                root.join-state = 0;
                                root.join-error = "";
                            }
                        }
                        accepted => {
                            if (root.join-state != 1 && root.join-state != 3 && root.join-text != "") {
                                root.join-state = 1;
                                root.invite-lookup(root.join-text);
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        DialogButton {
                            text: @tr("" => "Найти");
                            enabled: root.join-text != "" && root.join-state != 1 && root.join-state != 3;
                            clicked => {
                                root.join-state = 1;
                                root.invite-lookup(root.join-text);
                            }
                        }
                    }
                }
                if root.join-state == 1: Text { text: @tr("" => "Спрашиваю Discord о приглашении…"); color: Theme.muted; font-size: 13px; }
                if root.join-state >= 2 && root.join-preview.name != "": Rectangle {
                    height: 76px;
                    border-radius: 8px;
                    background: Theme.surface0;
                    border-width: 1px;
                    border-color: Theme.line;
                    Rectangle {
                        x: 14px;
                        width: 48px;
                        height: 48px;
                        border-radius: 14px;
                        clip: true;
                        background: Theme.accent;
                        if root.join-preview.has-icon: Image { width: 48px; height: 48px; source: root.join-preview.icon; image-fit: cover; }
                        if !root.join-preview.has-icon: Text { y: (parent.height - self.height) / 2 - self.font-size * 0.064; text: root.join-preview.initials; color: Theme.on-accent; font-size: 15px; font-weight: 700; }
                    }
                    VerticalLayout {
                        x: 76px;
                        width: parent.width - 90px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: root.join-preview.name; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
                        Text { text: root.join-preview.counts; color: Theme.muted; font-size: 12.5px; overflow: elide; }
                        if root.join-preview.joined || root.join-state == 4: Text {
                            text: root.join-state == 4 ? @tr("" => "Вы присоединились к серверу") : @tr("" => "Вы уже на этом сервере");
                            color: Theme.green;
                            font-size: 12.5px;
                            font-weight: 600;
                        }
                    }
                }
                if root.join-error != "": Text { text: root.join-error; color: #f23f43; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    DialogButton { text: root.join-state == 4 ? @tr("" => "Закрыть") : @tr("" => "Отмена"); clicked => { root.join-open = false; } }
                    if root.join-state == 6: DialogButton {
                        text: @tr("" => "Открыть в Discord");
                        primary: true;
                        clicked => { root.invite-official(root.join-preview.code); }
                    }
                    if !(root.join-preview.joined || root.join-state == 4 || root.join-state == 6): DialogButton {
                        text: root.join-state == 3 ? @tr("" => "Присоединение…") : @tr("" => "Присоединиться");
                        primary: true;
                        enabled: root.join-state == 2;
                        clicked => {
                            if (root.join-state == 2) {
                                root.join-state = 3;
                                root.invite-join(root.join-preview.code);
                            }
                        }
                    }
                    if root.join-preview.joined || root.join-state == 4: DialogButton {
                        text: @tr("" => "Открыть сервер");
                        primary: true;
                        clicked => {
                            root.join-open = false;
                            root.selected-guild = root.join-preview.guild;
                            root.people-page = 0;
                            root.forum-open = false;
                            root.guild-clicked(root.join-preview.guild);
                        }
                    }
                }
            }
        }
    }

    // A new invite to a server: friends to send it to, and its link to copy.
    if root.made-invite-state > 0 && root.invite-rich: Rectangle {
        width: root.width;
        height: root.height;
        background: #000000a0;
        TouchArea { clicked => { root.close-invite(); } }
        Rectangle {
            width: min(480px, root.width - 32px);
            height: min(760px, root.height - 48px);
            clip: true;
            background: Theme.glass-strong;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            TouchArea {}
            VerticalLayout {
                VerticalLayout {
                    vertical-stretch: 0;
                    padding: 20px;
                    padding-bottom: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        Text { text: @tr("" => "Пригласить друзей в ") + root.made-invite-place; color: Theme.text; font-size: 20px; font-weight: 800; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        IconButton { icon: Icons.close; clicked => { root.close-invite(); } }
                    }
                    if root.made-invite-state == 2 && root.made-invite-channel != "": Text {
                        text: @tr("" => "Участники окажутся в ") + "# " + root.made-invite-channel;
                        color: Theme.muted;
                        font-size: 14px;
                        overflow: elide;
                    }
                    if root.made-invite-state == 2: Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: Theme.surface0;
                        border-width: 1px;
                        border-color: Theme.line;
                        Icon { x: 12px; y: 11px; width: 18px; height: 18px; commands: Icons.search; tint: Theme.muted; }
                        if root.invite-query == "": Text {
                            x: 40px;
                            height: parent.height;
                            text: @tr("" => "Найти друзей");
                            color: Theme.muted;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                        TextInput {
                            x: 40px;
                            width: parent.width - 52px;
                            height: parent.height;
                            text: root.invite-query;
                            color: Theme.text;
                            font-size: 15px;
                            vertical-alignment: center;
                            edited => {
                                root.invite-query = self.text;
                                root.invite-search();
                            }
                        }
                    }
                }
                if root.made-invite-state == 1: Text { vertical-stretch: 1; text: @tr("" => "Создаю приглашение…"); color: Theme.muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                if root.made-invite-state == 3: Text { vertical-stretch: 1; text: root.made-invite-error; color: #f23f43; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                if root.made-invite-state == 2 && root.invite-people.length == 0: Text { vertical-stretch: 1; text: @tr("" => "Друзья не найдены"); color: Theme.muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                if root.made-invite-state == 2 && root.invite-people.length > 0: ListView {
                    vertical-stretch: 1;
                    for friend in root.invite-people: Rectangle {
                        height: 48px;
                        Rectangle {
                            x: 20px;
                            y: 6px;
                            width: 36px;
                            height: 36px;
                            clip: true;
                            border-radius: 18px;
                            background: Theme.surface3;
                            if friend.has-avatar: Image { width: 36px; height: 36px; source: friend.avatar; image-fit: cover; }
                            if !friend.has-avatar: Text { text: friend.initial; color: Theme.text; font-size: 15px; font-weight: 600; }
                        }
                        Text { x: 68px; y: 6px; width: parent.width - 200px; text: friend.name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                        Text { x: 68px; y: 26px; width: parent.width - 200px; text: friend.subtitle; color: Theme.muted; font-size: 12px; overflow: elide; }
                        Rectangle {
                            x: parent.width - self.width - 20px;
                            y: 8px;
                            width: 108px;
                            height: 32px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: friend.kind == 2 ? #23a55a : Theme.line;
                            background: friend.kind == 0 && send-area.has-hover ? Theme.button-hover : Theme.button;
                            animate background { duration: Appearance.quick; }
                            send-area := TouchArea {
                                enabled: friend.kind == 0;
                                mouse-cursor: friend.kind == 0 ? pointer : default;
                                clicked => { root.invite-friend(friend.id, root.made-invite-link); }
                            }
                            Text {
                                text: friend.kind == 2 ? @tr("" => "Отправлено") : friend.kind == 1 ? "…" : @tr("" => "Пригласить");
                                color: friend.kind == 2 ? #23a55a : Theme.text;
                                font-size: 13.5px;
                                font-weight: 600;
                            }
                        }
                    }
                }
                Rectangle { vertical-stretch: 0; height: 1px; background: Theme.line; }
                if root.made-invite-state == 2: VerticalLayout {
                    vertical-stretch: 0;
                    padding: 20px;
                    padding-top: 14px;
                    spacing: 8px;
                    Text { text: @tr("" => "Или отправьте другу ссылку-приглашение на сервер"); color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                    guild-link-box := Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: Theme.surface0;
                        border-width: 1px;
                        border-color: Theme.line;
                        property <bool> copied;
                        Text { x: 12px; width: parent.width - 130px; text: root.made-invite-link; color: Theme.text; font-size: 15px; vertical-alignment: center; overflow: elide; }
                        Rectangle {
                            x: parent.width - self.width - 5px;
                            width: 100px;
                            height: 34px;
                            border-radius: 6px;
                            background: guild-link-box.copied ? #23a55a : (guild-copy-area.has-hover ? Theme.accent-hover : Theme.accent);
                            guild-copy-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.copy-text(root.made-invite-link);
                                    guild-link-box.copied = true;
                                }
                            }
                            Text { text: guild-link-box.copied ? @tr("" => "Скопировано") : @tr("" => "Копировать"); color: Theme.on-accent; font-size: 13.5px; font-weight: 600; }
                        }
                    }
                    Text { text: @tr("" => "Ссылка перестанет действовать через 1 день."); color: Theme.muted; font-size: 12px; }
                }
            }
        }
    }

    // A new invite: being made, then its link to copy (or Discord's refusal).
    if root.made-invite-state > 0 && !root.invite-rich: Rectangle {
        width: root.width;
        height: root.height;
        background: #000000a0;
        TouchArea { clicked => { root.made-invite-state = 0; } }
        Rectangle {
            width: min(460px, root.width - 32px);
            height: made-body.preferred-height;
            background: Theme.glass-strong;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            TouchArea {}
            made-body := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: @tr("" => "Пригласить друзей в ") + root.made-invite-place; color: Theme.text; font-size: 18px; font-weight: 800; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton { icon: Icons.close; clicked => { root.made-invite-state = 0; } }
                }
                if root.made-invite-state == 1: Text { text: @tr("" => "Создаю приглашение…"); color: Theme.muted; font-size: 13px; }
                if root.made-invite-state == 2: Text { text: @tr("" => "Отправьте эту ссылку другу. Она действует 1 день, число использований не ограничено."); color: Theme.text2; font-size: 13px; wrap: word-wrap; }
                if root.made-invite-state == 2: link-box := Rectangle {
                    height: 44px;
                    border-radius: 8px;
                    background: Theme.surface0;
                    border-width: 1px;
                    border-color: Theme.line;
                    property <bool> copied;
                    Text { x: 12px; width: parent.width - 130px; text: root.made-invite-link; color: Theme.text; font-size: 15px; vertical-alignment: center; overflow: elide; }
                    Rectangle {
                        x: parent.width - self.width - 5px;
                        width: 100px;
                        height: 34px;
                        border-radius: 6px;
                        background: link-box.copied ? #23a55a : (copy-area.has-hover ? Theme.accent-hover : Theme.accent);
                        copy-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.copy-text(root.made-invite-link);
                                link-box.copied = true;
                            }
                        }
                        Text { text: link-box.copied ? @tr("" => "Скопировано") : @tr("" => "Копировать"); color: Theme.on-accent; font-size: 13.5px; font-weight: 600; }
                    }
                }
                if root.made-invite-state == 3: Text { text: root.made-invite-error; color: #f23f43; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    DialogButton { text: @tr("" => "Готово"); clicked => { root.made-invite-state = 0; } }
                }
            }
        }
    }

    // The server's scheduled events: a card each, or a word that there are none; "Создать событие" for those allowed.
    if root.events-open && root.event-step == 0: Rectangle {
        width: root.width;
        height: root.height;
        background: #000000a0;
        property <bool> shown;
        init => { self.shown = true; }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Appearance.quick; easing: ease-out; }
        TouchArea { clicked => { root.events-open = false; } }
        Rectangle {
            width: min(440px, root.width - 32px);
            height: events-body.preferred-height;
            background: Theme.glass-strong;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            clip: true;
            TouchArea {}
            events-body := VerticalLayout {
                HorizontalLayout {
                    padding: 16px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Icon { width: 22px; height: 22px; commands: Icons.calendar; tint: Theme.text; }
                    }
                    Text {
                        text: root.events-title;
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.events-can-create: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: create-event-label.preferred-width + 24px;
                            height: 32px;
                            border-radius: 4px;
                            background: create-event-area.has-hover ? Theme.accent-hover : Theme.accent;
                            create-event-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.event-error = "";
                                    root.event-step = 1;
                                    root.event-create-open();
                                }
                            }
                            create-event-label := Text { text: @tr("" => "Создать событие"); color: Theme.on-accent; font-size: 14px; font-weight: 500; }
                        }
                    }
                    IconButton { icon: Icons.close; clicked => { root.events-open = false; } }
                }
                Rectangle { height: 1px; background: Theme.line; }
                if root.events.length == 0: VerticalLayout {
                    padding: 32px;
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        height: 64px;
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            border-radius: 32px;
                            background: Theme.surface3;
                            Icon { width: 32px; height: 32px; x: 16px; y: 16px; commands: Icons.calendar; tint: Theme.text2; }
                        }
                    }
                    Text {
                        text: root.events-loading ? @tr("" => "Загрузка…") : @tr("" => "Нет предстоящих событий.");
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    if !root.events-loading: Text {
                        text: @tr("" => "Планируйте мероприятия: созвоны, стримы, игры и встречи. Участники смогут отметить, что им интересно.");
                        color: Theme.muted;
                        font-size: 14px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
                if root.events.length > 0: Flickable {
                    height: min(events-list.preferred-height, root.height - 160px);
                    content-height: events-list.preferred-height;
                    events-list := VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        for e in root.events: EventCard {
                            event: e;
                            interest(on) => { root.event-interest(e.id, on); }
                            share => { root.copy-text(e.link); }
                            cancel-event => { root.event-delete(e.id); }
                        }
                    }
                }
            }
        }
    }

    // Creating a scheduled event, as Discord does it: where, then the details, then how it will look.
    if root.event-step > 0: Rectangle {
        width: root.width;
        height: root.height;
        background: #000000a0;
        TouchArea { clicked => { if (!root.event-busy) { root.event-step = 0; } } }
        Rectangle {
            width: min(440px, root.width - 32px);
            height: create-body.preferred-height;
            background: Theme.glass-strong;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            clip: true;
            TouchArea {}
            create-body := VerticalLayout {
                // The three steps, the current one lit.
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    padding-top: 12px;
                    spacing: 12px;
                    for s[i] in [@tr("" => "Где"), @tr("" => "Сведения"), @tr("" => "Предпросмотр")]: VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: s;
                            color: root.event-step == i + 1 ? Theme.text : Theme.muted;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Rectangle { height: 3px; border-radius: 2px; background: root.event-step >= i + 1 ? Theme.accent : Theme.line; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { icon: Icons.close; clicked => { if (!root.event-busy) { root.event-step = 0; } } }
                }
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    if root.event-step == 1: VerticalLayout {
                        spacing: 10px;
                        Text { text: @tr("" => "Где пройдёт мероприятие?"); color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: @tr("" => "Чтобы никто не потерялся."); color: Theme.muted; font-size: 14px; horizontal-alignment: center; }
                        for k[i] in [
                            { kind: 1, icon: Icons.stage, title: @tr("" => "Трибуна"), text: @tr("" => "Выступайте перед слушателями в канале-трибуне") },
                            { kind: 2, icon: Icons.volume, title: @tr("" => "Голосовой канал"), text: @tr("" => "Общайтесь голосом и по видео, показывайте экран") },
                            { kind: 3, icon: Icons.location, title: @tr("" => "В другом месте"), text: @tr("" => "Текстовый канал, внешняя ссылка или место встречи") },
                        ]: Rectangle {
                            height: 60px;
                            border-radius: 6px;
                            background: root.event-kind == k.kind ? Theme.active : kind-area.has-hover ? Theme.hover : Theme.surface2;
                            kind-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.event-kind = k.kind;
                                    root.event-channel = "";
                                }
                            }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon { width: 22px; height: 22px; commands: k.icon; tint: Theme.text2; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: k.title; color: Theme.text; font-size: 15px; font-weight: 600; }
                                    Text { text: k.text; color: Theme.muted; font-size: 12.5px; overflow: elide; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        border-width: 2px;
                                        border-color: root.event-kind == k.kind ? Theme.accent : Theme.muted;
                                        if root.event-kind == k.kind: Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.accent; }
                                    }
                                }
                            }
                        }
                        if root.event-kind != 3: Text { text: @tr("" => "ВЫБЕРИТЕ КАНАЛ"); color: Theme.muted; font-size: 11.5px; font-weight: 800; }
                        if root.event-kind != 3: Rectangle {
                            height: 120px;
                            border-radius: 6px;
                            background: Theme.surface0;
                            border-width: 1px;
                            border-color: Theme.line;
                            ListView {
                                for ch in root.event-channels: Rectangle {
                                    height: ch.stage == (root.event-kind == 1) ? 34px : 0px;
                                    visible: ch.stage == (root.event-kind == 1);
                                    background: root.event-channel == ch.id ? Theme.active : ch-area.has-hover ? Theme.hover : transparent;
                                    ch-area := TouchArea { mouse-cursor: pointer; clicked => { root.event-channel = ch.id; } }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            Icon { width: 16px; height: 16px; commands: ch.stage ? Icons.stage : Icons.volume; tint: Theme.muted; }
                                        }
                                        Text { text: ch.name; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }
                        }
                        if root.event-kind == 3: Text { text: @tr("" => "УКАЖИТЕ МЕСТО"); color: Theme.muted; font-size: 11.5px; font-weight: 800; }
                        if root.event-kind == 3: SettingField {
                            text <=> root.event-location;
                            placeholder: @tr("" => "Добавьте место, ссылку или что-то ещё.");
                        }
                    }
                    if root.event-step == 2: VerticalLayout {
                        spacing: 8px;
                        Text { text: @tr("" => "Расскажите о мероприятии"); color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: @tr("" => "ТЕМА МЕРОПРИЯТИЯ") + " *"; color: Theme.muted; font-size: 11.5px; font-weight: 800; }
                        SettingField { text <=> root.event-name; placeholder: @tr("" => "О чём ваше мероприятие?"); }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: @tr("" => "ДАТА НАЧАЛА") + " *"; color: Theme.muted; font-size: 11.5px; font-weight: 800; }
                                SettingField { text <=> root.event-date; placeholder: @tr("" => "дд.мм.гггг"); }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: @tr("" => "ВРЕМЯ НАЧАЛА") + " *"; color: Theme.muted; font-size: 11.5px; font-weight: 800; }
                                SettingField { text <=> root.event-time; placeholder: @tr("" => "чч:мм"); }
                            }
                        }
                        if root.event-kind == 3: HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: @tr("" => "ДАТА ОКОНЧАНИЯ") + " *"; color: Theme.muted; font-size: 11.5px; font-weight: 800; }
                                SettingField { text <=> root.event-end-date; placeholder: @tr("" => "дд.мм.гггг"); }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: @tr("" => "ВРЕМЯ ОКОНЧАНИЯ") + " *"; color: Theme.muted; font-size: 11.5px; font-weight: 800; }
                                SettingField { text <=> root.event-end-time; placeholder: @tr("" => "чч:мм"); }
                            }
                        }
                        Text { text: @tr("" => "ЧАСТОТА"); color: Theme.muted; font-size: 11.5px; font-weight: 800; }
                        Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: Theme.surface0;
                            border-width: 1px;
                            border-color: Theme.line;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                Text { text: @tr("" => "Не повторяется"); color: Theme.text; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; }
                                VerticalLayout {
                                    alignment: center;
                                    Icon { width: 18px; height: 18px; commands: Icons.chevron; tint: Theme.muted; }
                                }
                            }
                        }
                        Text { text: @tr("" => "ОПИСАНИЕ"); color: Theme.muted; font-size: 11.5px; font-weight: 800; }
                        SettingField { text <=> root.event-desc; multiline: true; placeholder: @tr("" => "Расскажите подробнее. Можно использовать разметку и ссылки."); }
                    }
                    if root.event-step == 3: VerticalLayout {
                        spacing: 12px;
                        Text { text: @tr("" => "Всё верно?"); color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: @tr("" => "Так участники сервера увидят ваше мероприятие."); color: Theme.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                        EventCard { event: root.event-preview; preview: true; }
                    }
                    if root.event-error != "": Text { text: root.event-error; color: #f23f43; font-size: 13px; wrap: word-wrap; }
                }
                Rectangle {
                    height: 64px;
                    background: Theme.surface2;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 10px;
                        DialogButton {
                            text: root.event-step == 1 ? @tr("" => "Отмена") : @tr("" => "Назад");
                            height: 36px;
                            enabled: !root.event-busy;
                            clicked => {
                                root.event-error = "";
                                root.event-step = root.event-step - 1;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        DialogButton {
                            primary: true;
                            height: 36px;
                            enabled: !root.event-busy && (root.event-step != 1 || (root.event-kind == 3 ? root.event-location != "" : root.event-channel != ""));
                            text: root.event-step == 3 ? @tr("" => "Создать событие") : @tr("" => "Далее");
                            clicked => {
                                root.event-error = "";
                                if (root.event-step == 1) {
                                    root.event-step = 2;
                                } else if (root.event-step == 2) {
                                    root.event-preview-make();
                                } else {
                                    root.event-busy = true;
                                    root.event-create();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // An open select menu of a bot's message: its options under the box (over it when there's no room below).
    // A click outside closes it and sends the choice (one click picks, for a single-choice menu).
    if root.select-open: Rectangle {
        property <bool> menu-shown;
        init => { self.menu-shown = true; }
        opacity: self.menu-shown ? 1 : 0;
        animate opacity { duration: Appearance.quick; easing: ease-out; }
        width: root.width;
        height: root.height;
        TouchArea {
            clicked => {
                root.select-open = false;
                root.select-apply();
            }
        }
        property <length> row-h: root.select-tall ? 52px : 40px;
        property <length> list-h: min(root.select-options.length * self.row-h, 6.5 * self.row-h) + 8px;
        Rectangle {
            x: min(root.select-x, root.width - self.width - 8px);
            y: root.select-y + 4px + parent.list-h > root.height - 8px ? root.select-y - 44px - parent.list-h : root.select-y + 4px;
            width: root.select-w;
            height: parent.list-h;
            border-radius: 4px;
            background: Theme.light ? #ffffff : #2b2d31;
            border-width: 1px;
            border-color: Theme.light ? #0000001f : #1e1f22;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;
            clip: true;
            TouchArea {}
            ListView {
                x: 0;
                y: 4px;
                height: parent.height - 8px;
                for o[i] in root.select-options: Rectangle {
                    height: root.select-tall ? 52px : 40px;
                    background: o.chosen && !root.select-multi ? Theme.active : option-area.has-hover ? Theme.hover : transparent;
                    option-area := TouchArea { mouse-cursor: pointer; clicked => { root.select-toggle(i); } }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        if o.emoji.has-image: VerticalLayout {
                            alignment: center;
                            Image { width: 20px; height: 20px; source: o.emoji.image; image-fit: contain; }
                        }
                        if !o.emoji.has-image && o.emoji.text != "": Text { text: o.emoji.text; font-family: "Segoe UI Emoji"; font-size: 17px; color: Theme.text; vertical-alignment: center; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 1px;
                            Text { text: o.label; color: Theme.text; font-size: 14px; font-weight: 500; overflow: elide; }
                            if o.description != "": Text { text: o.description; color: Theme.muted; font-size: 12.5px; overflow: elide; }
                        }
                        // Several may be chosen: a box each; one: a mark on the chosen one.
                        if root.select-multi: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                background: o.chosen ? Theme.accent : transparent;
                                border-width: o.chosen ? 0px : 2px;
                                border-color: Theme.muted;
                                if o.chosen: Icon { x: 2px; y: 2px; width: 16px; height: 16px; stroke-width: 3px; commands: Icons.check; tint: Theme.on-accent; }
                            }
                        }
                        if !root.select-multi && o.chosen: VerticalLayout {
                            alignment: center;
                            Icon { width: 18px; height: 18px; stroke-width: 2.6px; commands: Icons.check; tint: Theme.accent; }
                        }
                    }
                }
            }
        }
    }

    // A new thread from a message, or a new forum post: a name (and the post's text), one click creates it.
    if root.thread-dialog > 0: Rectangle {
        width: root.width;
        height: root.height;
        background: #000000a0;
        TouchArea { clicked => { if (!root.thread-busy) { root.thread-dialog = 0; } } }
        thread-card := Rectangle {
            width: min(480px, root.width - 32px);
            height: thread-body.preferred-height;
            background: Theme.glass-strong;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            TouchArea {}
            property <int> name-length: thread-name.text.character-count;
            property <bool> name-ok: thread-name.text != "" && self.name-length <= 100;
            property <bool> text-ok: root.thread-dialog == 1 || (thread-text.text != "" && thread-text.text.character-count <= 2000);
            thread-body := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: root.thread-dialog == 1 ? @tr("" => "Создать ветку") : @tr("" => "Новая публикация");
                        color: Theme.text;
                        font-size: 19px;
                        font-weight: 800;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton { icon: Icons.close; clicked => { if (!root.thread-busy) { root.thread-dialog = 0; } } }
                }
                Text { text: root.thread-dialog == 1 ? @tr("" => "НАЗВАНИЕ ВЕТКИ") : @tr("" => "ЗАГОЛОВОК"); color: Theme.muted; font-size: 11.5px; font-weight: 800; }
                thread-name := SettingField {
                    text <=> root.thread-draft;
                    placeholder: root.thread-dialog == 1 ? @tr("" => "Новая ветка") : @tr("" => "О чём публикация?");
                    init => { self.focus-input(); }
                }
                Text {
                    text: thread-card.name-length + " / 100";
                    color: thread-card.name-length > 100 ? #f23f43 : Theme.faint;
                    font-size: 11.5px;
                    horizontal-alignment: right;
                }
                if root.thread-dialog == 2: Text { text: @tr("" => "ТЕКСТ"); color: Theme.muted; font-size: 11.5px; font-weight: 800; }
                thread-text := SettingField {
                    text <=> root.thread-draft-text;
                    visible: root.thread-dialog == 2;
                    height: root.thread-dialog == 2 ? 120px : 0px;
                    multiline: true;
                    placeholder: @tr("" => "Напишите первое сообщение публикации");
                }
                if root.thread-error != "": Text { text: root.thread-error; color: #f23f43; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    DialogButton { text: @tr("" => "Отмена"); enabled: !root.thread-busy; clicked => { root.thread-dialog = 0; } }
                    DialogButton {
                        text: root.thread-busy ? @tr("" => "Создание…") : (root.thread-dialog == 1 ? @tr("" => "Создать ветку") : @tr("" => "Опубликовать"));
                        primary: true;
                        enabled: !root.thread-busy && thread-card.name-ok && thread-card.text-ok;
                        clicked => {
                            if (!root.thread-busy) {
                                root.thread-busy = true;
                                root.thread-error = "";
                                if (root.thread-dialog == 1) {
                                    root.create-thread(root.thread-message, thread-name.text);
                                } else {
                                    root.create-post(root.selected-channel, thread-name.text, thread-text.text);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.full-profile-open: FullProfile {
        width: root.width;
        height: root.height;
        item: root.user-card;
        extra <=> root.profile-extra;
        close => { root.full-profile-open = false; }
        message => {
            root.full-profile-open = false;
            root.user-action("dm", root.user-card.id);
        }
        friend-button => {
            if (root.profile-extra.friend) {
                root.confirm-user = root.user-card.id;
                root.confirm-name = root.user-card.name;
                root.confirm-action = "friend-remove";
            } else {
                root.user-action("friend-add", root.user-card.id);
            }
        }
        more(x, y) => {
            root.open-user-menu(root.user-card.id, x, y);
            root.menu-from-card = true;
        }
        open-link(url) => { root.user-action("open-link:" + url, ""); }
        open-person(id) => { root.open-full-profile(id); }
        open-server(id) => {
            root.full-profile-open = false;
            root.selected-guild = id;
            root.guild-clicked(id);
        }
        note-saved(text) => { root.note-saved(root.user-card.id, text); }
        open-badge(i) => { root.open-badges(root.user-card, i); }
    }
    if root.badges-open: BadgesWindow {
        width: root.width;
        height: root.height;
        card: root.badges-card;
        picked <=> root.badge-picked;
        closed => { root.badges-open = false; }
        open-link(url) => { root.user-action("open-link:" + url, ""); }
    }
    if root.info-open: InfoDialog {
        width: root.width;
        height: root.height;
        title: root.info-title;
        text: root.info-text;
        timeouts: root.info-timeouts;
        timeout(seconds) => {
            root.user-action("timeout:" + seconds, root.user-menu.id);
            root.info-open = false;
        }
        copy => { root.user-action("copy-channel:" + root.info-text, ""); }
        closed => { root.info-open = false; }
    }
    if root.prompt-kind != "": PromptDialog {
        width: root.width;
        height: root.height;
        title: root.prompt-kind == "nick" ? @tr("" => "Изменить никнейм") : @tr("" => "Никнейм друга");
        text: root.prompt-kind == "nick" ? root.user-menu.nick : root.user-menu.friend-nick;
        saved(text) => {
            root.user-action(root.prompt-kind + ":" + text, root.user-menu.id);
            root.prompt-kind = "";
        }
        cancelled => { root.prompt-kind = ""; }
    }
    if root.confirm-action != "": ConfirmDialog {
        width: root.width;
        height: root.height;
        action: root.confirm-action;
        name: root.confirm-name;
        confirmed => {
            root.user-action(root.confirm-action, root.confirm-user);
            root.confirm-action = "";
        }
        cancelled => {
            // No to a voice server is remembered too, so it isn't asked again.
            if (root.confirm-action == "voice-server") {
                root.user-action("voice-refuse", root.confirm-user);
            }
            root.confirm-action = "";
        }
    }

    if root.profile-edit-open: ProfileEditor {
        width: root.width;
        height: root.height;
        avatar: root.me-avatar;
        banner: root.prof-banner;
        has-banner: root.prof-has-banner;
        has-color: root.prof-has-color;
        banner-color: root.prof-color;
        decoration: root.me-decoration;
        has-decoration: root.me-has-decoration;
        plate: root.me-banner;
        has-plate: root.me-has-banner;
        username: root.me-username;
        status: root.my-status;
        name: root.prof-global-name;
        pronouns: root.prof-pronouns;
        bio: root.my-bio;
        custom-status: root.my-custom-status;
        close => { root.profile-edit-open = false; }
        pick(kind) => { root.profile-picture-pick(kind); }
        // Only what changed is sent; what is shown follows at once (an error shows as a notice).
        apply(n, p, b, c) => {
            if (n != root.prof-global-name) { root.prof-global-name = n; root.profile-name-saved(n); }
            if (p != root.prof-pronouns) { root.prof-pronouns = p; root.profile-pronouns-saved(p); }
            if (b != root.my-bio) { root.my-bio = b; root.bio-saved(b); }
            if (c != root.my-custom-status) { root.my-custom-status = c; root.custom-status-saved(c); }
        }
        open-web => { root.open-discord-web(); }
    }

    if root.user-card-open: TouchArea {
        clicked => { root.user-card-open = false; }
    }
    if root.user-card-open: UserCardView {
        property <bool> shown;
        init => { self.shown = true; }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Appearance.quick; easing: ease-out; }
        width: 340px;
        height: self.wanted;
        x: max(8px, min(root.user-card-x, root.width - self.width - 12px));
        y: max(40px, min(root.user-card-y + (self.shown ? 0px : 10px), root.height - self.height - 12px));
        animate y { duration: Appearance.quick; easing: ease-out; }
        item: root.user-card;
        more(x, y) => {
            root.open-user-menu(root.user-card.id, x - 260px, y + 36px);
            root.menu-from-card = true;
        }
        message(text) => {
            root.user-card-open = false;
            root.card-message(root.user-card.id, text);
        }
        full => { root.open-full-profile(root.user-card.id); }
        open-badge(i) => { root.open-badges(root.user-card, i); }
    }
    if root.viewer-open: ImageViewer {
        y: 32px;
        width: root.width;
        height: root.height - 32px;
        item: root.viewer-item;
        full-image: root.viewer-image;
        has-full: root.viewer-has-image;
        close => { root.viewer-open = false; }
        forward => {
            root.viewer-open = false;
            root.forward-open(root.viewer-item.id);
        }
        save => { root.viewer-save(root.viewer-item.picture-original); }
        open-outside => { root.open-link(root.viewer-item.picture-original); }
        copy-address => { root.copy-text(root.viewer-item.picture-original); }
    }
    if root.settings-open: VoiceSettingsView {
        width: root.width;
        height: root.height;
        settings <=> root.voice-settings;
        mics: root.mic-devices;
        speakers: root.speaker-devices;
        cameras: root.camera-devices;
        camera-preview-on <=> root.camera-preview-on;
        camera-preview-frame: root.camera-preview-frame;
        camera-preview-error: root.camera-preview-error;
        camera-picked(i) => { root.camera-device-selected(i); }
        camera-preview-toggled(v) => { root.camera-preview-toggled(v); }
        meter: root.mic-meter;
        sending: root.mic-sending;
        testing: root.mic-testing;
        key-name: root.ptt-key-name;
        page <=> root.settings-page;
        me-name: root.me-name;
        me-id: root.me-id;
        me-email: root.me-email;
        me-phone: root.me-phone;
        me-mfa: root.me-mfa;
        open-web => { root.open-discord-web(); }
        sign-out => { root.sign-out(); }
        nav-match(a, b) => { return root.nav-match(a, b); }
        notify-enabled <=> root.notify-enabled;
        notify-sound <=> root.notify-sound;
        notify-text <=> root.notify-text;
        notify-everyone <=> root.notify-everyone;
        notify-changed => { root.notify-changed(); }
        priv-ready: root.priv-ready;
        priv-explicit <=> root.priv-explicit;
        priv-friends-all <=> root.priv-friends-all;
        priv-friends-friends <=> root.priv-friends-friends;
        priv-friends-guilds <=> root.priv-friends-guilds;
        privacy-changed(k, v) => { root.privacy-changed(k, v); }
        friend-sources-changed(a, f, g) => { root.friend-sources-changed(a, f, g); }
        my-status <=> root.my-status;
        my-custom-status <=> root.my-custom-status;
        my-bio <=> root.my-bio;
        show-game <=> root.show-game;
        custom-status-saved(t) => { root.custom-status-saved(t); }
        bio-saved(t) => { root.bio-saved(t); }
        mute-key-name: root.mute-key-name;
        deafen-key-name: root.deafen-key-name;
        hotkey-picked(t, k, c, s, a) => { root.hotkey-picked(t, k, c, s, a); }
        tray-on <=> root.tray-on;
        autostart-on <=> root.autostart-on;
        tray-toggled(v) => { root.tray-toggled(v); }
        autostart-toggled(v) => { root.autostart-toggled(v); }
        forget-servers => { root.forget-servers(); }
        appearance-changed(s) => { root.appearance-changed(s); }
        me-avatar: root.me-avatar;
        version: root.version;
        share-height <=> root.share-height;
        share-fps <=> root.share-fps;
        share-sound <=> root.share-sound;
        share-dest <=> root.share-dest;
        copy(text) => { root.copy-text(text); }
        open-sounds => { root.open-sounds-folder(); }
        changed(s) => { root.voice-settings-changed(s); }
        devices-requested => { root.devices-requested(); }
        mic-picked(i) => { root.mic-device-selected(i); }
        speaker-picked(i) => { root.speaker-device-selected(i); }
        test(on) => { root.mic-test(on); }
        key-picked(key, ctrl, shift, alt) => { root.ptt-key-picked(key, ctrl, shift, alt); }
        close => {
            root.settings-open = false;
            if (root.mic-testing) {
                root.mic-test(false);
            }
        }
    }

    if root.search-open: SearchOverlay {
        width: root.width;
        height: root.height;
        results: root.search-results;
        index <=> root.search-index;
        changed(text) => { root.search-changed(text); }
        picked(i) => {
            root.search-open = false;
            root.search-picked(i);
        }
        close => { root.search-open = false; }
    }


    if root.login-needed || root.welcome-step == 1: LoginScreen {
        width: root.width;
        height: root.height;
        closing: !root.login-needed;
        signing <=> root.login-signing;
        error: root.login-error;
        web-login => { root.web-login(); }
    }
    // The greeting: on plain black, only the words, the name real.
    if root.welcome-step == 2 || root.welcome-step == 3: Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.surface2;
        opacity: root.welcome-step == 2 ? 1 : 0;
        animate opacity { duration: 240ms; easing: ease-out; }
        TouchArea {}
        property <bool> up;
        init => { self.up = true; }
        Text {
            x: 16px;
            y: (root.height - 80px) / 2 + (parent.up ? 0px : 14px);
            width: root.width - 32px;
            horizontal-alignment: center;
            text: root.me-name != "" ? @tr("" => "С возвращением, {}", root.me-name) : @tr("" => "С возвращением");
            color: Theme.text;
            font-size: 40px;
            font-weight: 800;
            overflow: elide;
            opacity: parent.up ? 1 : 0;
            animate y, opacity { duration: 360ms; easing: ease-out; }
        }
        Text {
            x: 16px;
            y: (root.height - 80px) / 2 + 58px + (parent.up ? 0px : 14px);
            width: root.width - 32px;
            horizontal-alignment: center;
            text: @tr("" => "Загружаю серверы и сообщения");
            color: Theme.text2;
            font-size: 15px;
            opacity: parent.up ? 1 : 0;
            animate y, opacity { delay: 140ms; duration: 360ms; easing: ease-out; }
        }
    }

    if root.share-picker-open: SharePicker {
        x: 0px;
        y: 32px;
        width: root.width;
        height: root.height - 32px;
        sources: root.share-sources;
        monitor-count: root.share-monitors;
        window-count: root.share-windows;
        out-height <=> root.share-height;
        out-fps <=> root.share-fps;
        out-sound <=> root.share-sound;
        out-dest <=> root.share-dest;
        picked(index) => {
            root.share-picked(index, root.share-height, root.share-fps, root.share-sound);
            root.share-picker-open = false;
        }
        closed => { root.share-picker-open = false; }
    }

    if Appearance.updated-open && !root.login-needed: UpdatedWindow {
        width: root.width;
        height: root.height;
    }
    TitleBar {
        x: 0px;
        y: 0px;
        width: root.width;
        title: root.title-prefix + (root.selected-guild == "@me" ? @tr("" => "Личные сообщения") : root.sidebar-title);
        maximized: root.maximized;
        drag => { root.window-drag(); }
        inbox => { root.show-mentions(); }
        update-text: root.update-text;
        install-update => { root.install-update(); }
        can-back: root.can-go-back;
        can-ahead: root.can-go-ahead;
        back => { root.go-back(); }
        ahead => { root.go-ahead(); }
        minimize => { root.window-minimize(); }
        maximize => { root.window-maximize(); }
        close => { root.window-close(); }
    }
}
