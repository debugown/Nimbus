    in-out property <string> event-desc;
    in-out property <string> event-error;
    in-out property <bool> event-busy;
    in-out property <EventItem> event-preview;
    // "Создать событие": Rust fills the channels and the default times; "Далее" on step 2 checks the fields and
    // makes the preview; the last click creates it.
    callback event-create-open();
    callback event-preview-make();
    callback event-create();
