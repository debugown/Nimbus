    // Push to talk: the key as it's shown ("Ctrl + Пробел") and whether the
    // mic is open right now (the key is held, or the mode is voice activity).
    in property <string> ptt-key-name;
    in property <bool> ptt-open: true;
    // A key was picked for push to talk: the key and the modifiers that were
    // held with it.
    callback ptt-key-picked(string, bool, bool, bool);
    // The call screen over the whole window; Rust makes the window full screen too.
    in-out property <bool> call-fullscreen;
    callback fullscreen-changed(bool);
    // The camera preview ends with the settings: the camera is not left on unseen.
    changed settings-open => {
        if (!self.settings-open && self.camera-preview-on) {
            self.camera-preview-on = false;
            self.camera-preview-toggled(false);
        }
    }
    changed show-call => {
        if (!self.show-call && self.call-fullscreen) {
            self.call-fullscreen = false;
            self.fullscreen-changed(false);
        }
    }
    changed voice-channel => {
        if (self.voice-channel == "" && self.call-fullscreen) {
            self.call-fullscreen = false;
            self.fullscreen-changed(false);
        }
    }

    // The member list on the right of a server's text channel.
    in-out property <bool> members-open;
    // The person hid or showed the list; remembered between launches.
