    in property <[ForumPostItem]> forum-posts;

    // Someone's right-click menu: Rust fills it, then shows it where the click was.
    in-out property <UserMenuInfo> user-menu;
    property <length> menu-x;
    property <length> menu-y;
    // A person's card.
    in-out property <UserCardItem> user-card;
    in-out property <UserCardItem> dm-card;
    in-out property <bool> user-card-open;
    in-out property <bool> dm-panel-shown: true;
    in-out property <length> user-card-x;
    in-out property <length> user-card-y;
    property <length> pointer-x: 400px;
    property <length> pointer-y: 200px;
    // The card over the chat: who, and whether it is that one (else the panel beside a DM).
    callback user-card-requested(string, bool);
    callback card-message(string, string);
    public function place-user-card(x: length, y: length) {
        root.user-card-x = x;
        root.user-card-y = y;
    }
    // A mention was clicked: the card opens by the pointer.
    public function show-user-card(id: string) {
        root.user-card = { id: id };
        root.place-user-card(root.pointer-x + 12px, root.pointer-y - 40px);
        root.user-card-open = true;
    }
    function open-user-card(id: string, x: length, y: length) {
        root.user-card = { id: id };
        root.place-user-card(x, y);
        root.user-card-open = true;
        root.user-card-requested(id, true);
    }
    // The picture viewer.
    in-out property <bool> viewer-open;
    in-out property <MessageItem> viewer-item;
    in-out property <image> viewer-image;
    in-out property <bool> viewer-has-image;
    callback viewer-load(string);
    callback viewer-save(string);
    function open-image(item: MessageItem) {
        root.viewer-item = item;
        root.viewer-has-image = false;
        root.viewer-open = true;
        root.viewer-load(item.picture-full);
    }
    // The video call button of a DM: the camera goes on once the call is connected.
    property <bool> video-after-connect;
    changed voice-connected => {
        if (self.voice-connected && self.video-after-connect) {
            self.video-after-connect = false;
            self.toggle-camera(true);
        }
    }
    callback user-menu-requested(string);
    // A notification was clicked: the server ("" for a DM) and the channel.
    callback toast-open(string, string);
    callback user-action(string, string);
    callback user-volume(string, float);
    public function show-user-menu() {
        user-menu-popup.show();
    }
    function open-user-menu(id: string, x: length, y: length) {
        root.menu-x = x;
        root.menu-y = y;
        root.menu-from-card = false;
        root.user-menu-requested(id);
    }
    // The widths of the side panels, changed by dragging their edges and kept.
    in-out property <length> sidebar-width: 248px;
    in-out property <length> members-width: 240px;
    in-out property <length> dm-panel-width: 340px;
    callback panel-widths-saved(float, float, float);
    function save-panel-widths() {
        root.panel-widths-saved(root.sidebar-width / 1px, root.members-width / 1px, root.dm-panel-width / 1px);
    }
    // Someone's badges, the one to show first.
    in-out property <bool> badges-open;
    in-out property <UserCardItem> badges-card;
    in-out property <int> badge-picked;
    function open-badges(card: UserCardItem, which: int) {
        root.badges-card = card;
        root.badge-picked = which;
        root.badges-open = true;
    }
    // A person's whole profile: Rust fills it in.
    in-out property <bool> full-profile-open;
    in-out property <ProfileExtra> profile-extra;
    callback full-profile-requested(string);
    function open-full-profile(id: string) {
        if (root.user-card.id != id) {
            root.user-card = { id: id };
        }
        root.profile-extra = { note: "" };
        root.user-card-open = false;
        root.full-profile-open = true;
        root.full-profile-requested(id);
    }
    // Right-click on a row of the DM list: the channel.
