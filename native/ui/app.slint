    callback input-changed(string);
    callback suggest-picked(int);
    public function set-input(text: string) {
        input.text = text;
        input.focus();
    }
    // Ctrl+V with a picture or files on the clipboard (only while the message box has the focus); the
    // files then wait above the box, each with a ✕, until the message is sent.
    // Scheduled events of the open server: the row above its channels and the window it opens (the title is
    // "Мероприятия" or how many there are), whether we may create one, and the three steps of creating one.
    in property <string> events-title: @tr("" => "Мероприятия");
