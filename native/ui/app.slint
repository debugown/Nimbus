    in-out property <bool> share-sound: true;
    in-out property <int> share-dest: 1;
    callback share-settings-changed(int, int, bool);
    changed share-height => { root.share-settings-changed(root.share-height, root.share-fps, root.share-sound); }
    changed share-fps => { root.share-settings-changed(root.share-height, root.share-fps, root.share-sound); }
    changed share-sound => { root.share-settings-changed(root.share-height, root.share-fps, root.share-sound); }
    changed share-dest => { root.share-settings-changed(root.share-height, root.share-fps, root.share-sound); }
    in property <bool> watching;
